{"entity":{"id":"hb:israel@1938","name":"Israel","dataset":"basemaps","kind":"polity"},"territories":[{"id":9079,"name":"Israel","set_id":"hb_1938","class":"polity","valid_from":1938,"valid_to":1945,"snapshot_held":1,"area_km2":31140.763368941385,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Israel","min_lon":34.146304163542965,"min_lat":29.418094240144534,"max_lon":35.70218184908984,"max_lat":33.11898382754688,"source_file":"world_1938.geojson","source_row":null},{"id":9278,"name":"Israel","set_id":"hb_1945","class":"republic","valid_from":1945,"valid_to":1960,"snapshot_held":1,"area_km2":31140.763368941163,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Israel","min_lon":34.146304163542965,"min_lat":29.418094240144534,"max_lon":35.70218184908984,"max_lat":33.11898382754688,"source_file":"world_1945.geojson","source_row":null},{"id":9461,"name":"Israel","set_id":"hb_1960","class":"republic","valid_from":1960,"valid_to":1994,"snapshot_held":1,"area_km2":31140.763368941163,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Israel","min_lon":34.146304163542965,"min_lat":29.418094240144534,"max_lon":35.70218184908984,"max_lat":33.11898382754688,"source_file":"world_1960.geojson","source_row":null},{"id":9642,"name":"Israel","set_id":"hb_1994","class":"republic","valid_from":1994,"valid_to":2000,"snapshot_held":1,"area_km2":31140.763368941163,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Israel","min_lon":34.146304163542965,"min_lat":29.418094240144534,"max_lon":35.70218184908984,"max_lat":33.11898382754688,"source_file":"world_1994.geojson","source_row":null},{"id":9834,"name":"Israel","set_id":"hb_2000","class":"republic","valid_from":2000,"valid_to":2010,"snapshot_held":1,"area_km2":31140.763368941163,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"