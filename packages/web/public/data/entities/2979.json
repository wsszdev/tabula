{"entity":{"id":"hb:trebizond@1279","name":"Trebizond","dataset":"basemaps","kind":"polity"},"territories":[{"id":2212,"name":"Trebizond","set_id":"hb_1279","class":"empire","valid_from":1279,"valid_to":1300,"snapshot_held":1,"area_km2":31379.156317549776,"border_precision":1,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Turkey (Ottoman Empire)","min_lon":31.03539139527255,"min_lat":40.150774943705784,"max_lon":41.48396209190632,"max_lat":42.04316290493669,"source_file":"world_1279.geojson","source_row":null},{"id":2326,"name":"Trebizond","set_id":"hb_1300","class":"empire","valid_from":1300,"valid_to":1400,"snapshot_held":1,"area_km2":23064.286728301147,"border_precision":1,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Turkey (Ottoman Empire)","min_lon":37.252825769884836,"min_lat":40.150774943705784,"max_lon":41.48396209190632,"max_lat":41.436542116362475,"source_file":"world_1300.geojson","source_row":null},{"id":2428,"name":"Trebizond","set_id":"hb_1400","class":"empire","valid_from":1400,"valid_to":1461,"snapshot_held":1,"area_km2":23064.286728301147,"border_precision":1,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Turkey (Ottoman Empire)","min_lon":37.252825769884836,"min_lat":40.150774943705784,"max_lon":41.48396209190632,"max_lat":41.436542116362475,"source_file":"world_1400.geojson","source_row":null}],"identities":[{"qid":"Q178913","from_t":1279,"to_t":1461,"method":"name-template+date","confidence":0.8816941264535805,"label":"Empire of Trebizond","description":"Byzantine Greek state on Black Sea coast","inception":1204,"dissolved":1461,"enwiki":"Empire of Trebizond","summary":"The Empire of Trebizond or the Trapezuntine Empire was one of the three Byzantine rump states of the Byzantine Empire that existed during the 13th through to the 15th century. The empire consisted of the Pontus, or far northeastern corner of Anatolia, and portions of southern Crimea. It was formed with the help of Georgia's interventions in Trebizond.\nAfter the Fourth Crusade overthrew Alexios V Doukas and established the Latin Empire, the Empire of Trebizond became one of three Byzantine successor states to claim the imperial throne alongside the Empire of Nicaea under the House of Laskaris and the Despotate of Epirus under a branch of the House of Angelos."}],"facts":[{"qid":"Q178913","kind":"capital","value_qid":"Q45301","value_label":"Trabzon","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Trabzon"},{"qid":"Q178913","kind":"official_language","value_qid":"Q9129","value_label":"Greek","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Greek"},{"qid":"Q178913","kind":"official_religion","value_qid":"Q7970362","value_label":"Greek Orthodoxy","from_t":null,"to_t":null,"title":null,"property":"P3075","retrieved":"2026-10-30","vl":"Greek Orthodoxy"},{"qid":"Q178913","kind":"official_religion","value_qid":"Q35032","value_label":"Eastern Orthodox Church","from_t":null,"to_t":null,"title":null,"property":"P3075","retrieved":"2026-10-30","vl":"Eastern Orthodox Church"},{"qid":"Q178913","kind":"religion","value_qid":"Q35032","value_label":"Eastern Orthodox Church","from_t":null,"to_t":null,"title":null,"property":"P140","retrieved":"2026-10-30","vl":"Eastern Orthodox Church"},{"qid":"Q178913","kind":"government","value_qid":"Q7269","value_label":"monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"monarchy"},{"qid":"Q178913","kind":"predecessor","value_qid":"Q12544","value_label":"Byzantine Empire","from_t":null,"to_t":null,"title":null,"property":"P155","retrieved":"2026-10-30","vl":"Byzantine Empire"},{"qid":"Q178913","kind":"successor","value_qid":"Q12560","value_label":"Ottoman Empire","from_t":null,"to_t":null,"title":null,"property":"P156","retrieved":"2026-10-30","vl":"Ottoman Empire"},{"qid":"Q178913","kind":"successor","value_qid":"Q3854038","value_label":"Trebizond eyalet","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Trebizond eyalet"},{"qid":"Q178913","kind":"ruler","value_qid":"Q259213","value_label":"Irene Palaiologina of Trebizond","from_t":1340,"to_t":1341,"title":"empress of Trebizond","property":"P39","retrieved":"2026-10-30","vl":"Irene Palaiologina of Trebizond"},{"qid":"Q178913","kind":"ruler","value_qid":"Q259213","value_label":"Irene Palaiologina of Trebizond","from_t":1335,"to_t":1339,"title":"empress of Trebizond","property":"P39","retrieved":"2026-10-30","vl":"Irene Palaiologina of Trebizond"},{"qid":"Q178913","kind":"ruler","value_qid":"Q439701","value_label":"Anna of Trebizond","from_t":1341,"to_t":1342,"title":"empress of Trebizond","property":"P39","retrieved":"2026-10-30","vl":"Anna of Trebizond"}],"people":{"Q259213":{"label":"Irene Palaiologina of Trebizond","description":"Empress consort then empress regnant of Trebizond (1315-1341)","enwiki":"Irene Palaiologina of Trebizond","summary":"Irene Palaiologina (Greek: Ειρήνη Παλαιολογίνα, romanized: Eirēnē Palaiologina), (c. 1315 – after 1341) was Empress regnant of Trebizond from April 6, 1340, to July 17, 1341. She was an illegitimate daughter of the Byzantine Emperor Andronikos III Palaiologos, and she married Emperor Basil of Trebizond in 1335.","image":"IrenePalaiologinaCropped2.png","birth":1315,"death":1341.5808219178082},"Q439701":{"label":"Anna of Trebizond","description":"Empress regnant of Trebizond, nun (1312-1342)","enwiki":"Anna Anachoutlou","summary":"Anna Anachoutlou (Greek: Ἄννα Μεγάλη Κομνηνὴ Ἀναχουτλοῦ, romanized: Anna Megalē Komnēnē Anachoutloū; died 3 September 1342) ruled the Empire of Trebizond from 1341 to 1342. She was the eldest daughter of the Trapezuntine emperor Alexios II Megas Komnenos (r. 1297–1330) and had joined a convent as a nun during her father's reign. After the death of her father, Anna's brother Andronikos III (r. 1330–1332), her nephew Manuel II (r. 1332) and her other brother Basil (r. 1332–1340) reigned in rapid succession. After Basil's death, his widow Irene Palaiologina, genealogically unconnected to the ruling Grand Komnenos dynasty of Trebizond, seized power as empress regnant.","image":null,"birth":1300,"death":1342.6712328767123}},"media":{"IrenePalaiologinaCropped2.png":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c5/IrenePalaiologinaCropped2.png/330px-IrenePalaiologinaCropped2.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:IrenePalaiologinaCropped2.png","author":"Félix Marie Charles Texier","license":"Public domain"}},"names":["Cesarstwo Trapezuntu","Cesarstwo Trebizondy","Cesarstwo trapezunckie","Empire grec de Trebizonde","Empire grec de Trébizonde","Empire of Trebizond","Grand Comnène","Imperador de Trebizonda","Imperio de Trapisonda","Imperio de Trebisonda","Imperio de Trebizonda","Imperium Trapezuntinum","Impero di Trebisonda","Impero greco di Trebisonda","Império de Trebizonda","Kaiserreich Trapezunt","Lijst van keizers van Trebizonde","Pontus Rum İmparatorluğu","Regno di Trebisonda","Trabzon Krallığı","Trabzon Rum Devleti","Trabzon Rum İmparatorluğu","Trabzon Rum İmpratorluğu","Trabzon İmparatorluğu","Trapezuntine Empire","Trapezuntini","Trapezuntino","Trebizond Empire","empire de Trébizonde","keizerrijk Trebizonde","Αυτοκρατορία της Τραπεζούντας","Империя Трапезунда","Трапезундская империя","Трапезундское царство","Трапезунтская империя","إمبراطورية طربزون","الإمبراطورية الطربزونية","امپراتوری ترابزون","امپراتوری ترابوزان","امپراتوری طرابزون","امپراتوری طرابوزان","トレビゾンド帝国","特拉布宗帝国","特拉布宗帝國","特拉布松帝国","特拉比松帝国"]}