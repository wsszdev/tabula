{"entity":{"id":"hb:kakheti-hereti@1100","name":"Kakheti-Hereti","dataset":"basemaps","kind":"polity"},"territories":[{"id":1997,"name":"Kakheti-Hereti","set_id":"hb_1100","class":"polity","valid_from":1100,"valid_to":1200,"snapshot_held":1,"area_km2":13129.63806130608,"border_precision":1,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Georgia","min_lon":45.77373151884197,"min_lat":40.59313729303555,"max_lon":47.74498422898439,"max_lat":42.22817509322473,"source_file":"world_1100.geojson","source_row":null}],"identities":[{"qid":"Q7216494","from_t":1100,"to_t":1104,"method":"name-template+date","confidence":0.8575901854637947,"label":"First Kingdom of Kakheti","description":"medieval Georgian kingdom","inception":1020,"dissolved":1104,"enwiki":"Kingdom of Kakheti-Hereti","summary":"The Kingdom of Kakheti-Hereti (Georgian: კახეთ-ჰერეთის სამეფო, romanized: k'akhet-heretis samepo) was an early medieval Georgian monarchy in eastern Georgia, centered at the province of Kakheti, with its capital first at Telavi. It emerged in c.  1014 AD, under the leadership of energetic ruler of principality of Kakheti, Kvirike III the Great that finally defeated the ruler of Hereti and crowned himself as a king of the unified realms of Kakheti and Hereti. From this time on, until 1104, the kingdom was an independent and separated state from the united Kingdom of Georgia. The kingdom included territories from river Ksani (western border) to Alijanchay river (eastern border) and from Didoeti (northern border) to southwards along the river of Mtkvari (southern border)."}],"facts":[{"qid":"Q7216494","kind":"capital","value_qid":"Q209009","value_label":"Telavi","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Telavi"},{"qid":"Q7216494","kind":"predecessor","value_qid":"Q2919785","value_label":"Tsanareti","from_t":null,"to_t":null,"title":null,"property":"P155","retrieved":"2026-10-30","vl":"Tsanareti"},{"qid":"Q7216494","kind"