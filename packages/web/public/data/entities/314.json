ities":[{"qid":"Q262","from_t":1962.5013698630137,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Algeria","description":"country in North Africa","inception":1962.5013698630137,"dissolved":null,"enwiki":"Algeria","summary":"Algeria, officially the People's Democratic Republic of Algeria, is a country in North Africa. It is bordered to the northeast by Tunisia; to the east by Libya; to the southeast by Niger; to the southwest by Mali, Mauritania, and Western Sahara; to the west by Morocco; and to the north by the Mediterranean Sea. Its capital and largest city is Algiers.\nShaped first by indigenous Amazigh societies, including the Numidians, whose kingdom became one of the earliest major states in the region, as well as by Phoenician, Roman, Vandal, and Byzantine influences."}],"facts":[{"qid":"Q262","kind":"ruler","value_qid":"Q2821166","value_label":"Abdelmadjid Tebboune","from_t":2019.964383561644,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Abdelmadjid Tebboune"},{"qid":"Q262","kind":"ruler","value_qid":"Q133540883","value_label":"Sifi Ghrieb","from_t":2025.654794520548,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Sifi Ghrieb"},{"qid":"Q262","kind":"capital","value_qid":"Q3561","value_label":"Algiers","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Algiers"},{"qid":"Q262","kind":"official_language","value_qid":"Q13955","value_label":"Arabic","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Arabic"},{"qid":"Q262","kind":"official_language","value_qid":"Q61053330","value_label":"Standard Algerian Berber","from_t":2002,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Standard Algerian Berber"},{"qid":"Q262","kind":"language","value_qid":"Q56467","value_label":"Modern Standard Arabic","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","