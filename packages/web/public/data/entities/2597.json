ntic Ocean. To the north lies Saint Lucia, to the east is Barbados and Grenada lies to the south.\nSpanning a land area of 389 km2 (150 sq mi), most of its territory consists of the northernmost island of Saint Vincent, which includes the capital and largest city, Kingstown."}],"facts":[{"qid":"Q757","kind":"ruler","value_qid":"Q43274","value_label":"Charles III","from_t":2022.6849315068494,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Charles III"},{"qid":"Q757","kind":"ruler","value_qid":"Q28319076","value_label":"Godwin Friday","from_t":null,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Godwin Friday"},{"qid":"Q757","kind":"capital","value_qid":"Q41474","value_label":"Kingstown","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Kingstown"},{"qid":"Q757","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"English"},{"qid":"Q757","kind":"language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"English"},{"qid":"Q757","kind":"language","value_qid":"Q3501785","value_label":"Vincentian Creole","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Vincentian Creole"},{"qid":"Q757","kind":"government","value_qid":"Q41614","value_label":"constitutional monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"constitutional monarchy"},{"qid":"Q757","kind":"predecessor","value_qid":"Q15240384","value_label":"Saint Vincent","from_t":null,"to_t":null,"title":null,"property":"P155","retrieved":"2026-10-30","vl":"Saint Vincent"},{"qid":"Q757","kind":"predecessor","value_qid":"Q652560","value_label":"West Indies Federation","from_t":null,"to_t":null,"title":null,"property":"P155","retrieved":"2026-10