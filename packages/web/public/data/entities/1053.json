{"entity":{"id":"hb:fulani-empire@1815","name":"Fulani Empire","dataset":"basemaps","kind":"empire"},"territories":[{"id":7765,"name":"Fulani Empire","set_id":"hb_1815","class":"empire","valid_from":1815,"valid_to":1878,"snapshot_held":1,"area_km2":928758.5053330526,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Nigeria","min_lon":1.464116757041189,"min_lat":7.311161128893106,"max_lon":13.668560921419427,"max_lat":16.03918786463027,"source_file":"world_1815.geojson","source_row":null}],"identities":[{"qid":"Q600524","from_t":1815,"to_t":1878,"method":"name-alias+date","confidence":0.8112715846549564,"label":"Sokoto Caliphate","description":"independent Islamic Caliphate, in West Africa from 1804 to 1903","inception":1804,"dissolved":1903,"enwiki":"Sokoto Caliphate","summary":"The Sokoto Caliphate (Arabic: دولة الخلافة في بلاد السودان, literally: Caliphate in the Lands of Sudan), also known as the Sultanate of Sokoto, was a Sunni Muslim caliphate in West Africa. It was founded by Usman dan Fodio in 1804 during the Fulani jihads after defeating the Hausa Kingdoms in the Fulani War. The boundaries of the caliphate extended to parts of present-day Cameroon, Burkina Faso, Niger, and Nigeria. By 1837, the Caliphate had a population of 10–20 million people, becoming the most populous empire in West Africa."}],"facts":[{"qid":"Q600524","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"English"},{"qid":"Q600524","kind":"official_language","value_qid":"Q13955","value_label":"Arabic","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Arabic"},{"qid":"Q600524","kind":"official_language","value_qid":"Q56475","value_label":"Hausa","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Hausa"},{"qid":"Q600524","kind":"official_language","value_qid":"Q7838","val