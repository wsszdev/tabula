{"entity":{"id":"cs:551","name":"Zambia","dataset":"cshapes","kind":"polity"},"territories":[{"id":10485,"name":"Zambia","set_id":"cs","class":"polity","valid_from":1911.627397260274,"valid_to":1953.5808219178082,"snapshot_held":0,"area_km2":751927,"border_precision":3,"capital_name":"Lusaka","sovereign":null,"sovereign_note":null,"modern_name":"Zambia","min_lon":21.996391,"min_lat":-18.074918,"max_lon":33.699128,"max_lat":-8.193689,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=551;start=1911-8-18"},{"id":10486,"name":"Zambia","set_id":"cs","class":"republic","valid_from":1964.0573770491803,"valid_to":2020,"snapshot_held":0,"area_km2":751927,"border_precision":3,"capital_name":"Lusaka","sovereign":null,"sovereign_note":null,"modern_name":"Zambia","min_lon":21.996391,"min_lat":-18.074918,"max_lon":33.699128,"max_lat":-8.193689,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=551;start=1964-1-22"}],"identities":[{"qid":"Q953","from_t":1964.811475409836,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Zambia","description":"country at the crossroads of Central and Southern Africa","inception":1964.811475409836,"dissolved":null,"enwiki":"Zambia","summary":"Zambia (), officially the Republic of Zambia, is a landlocked country in Southern Africa. It is bordered to the north by the Democratic Republic of the Congo, Tanzania to the northeast, Malawi to the east, Mozambique to the southeast, Botswana (via a tiny border of Chobe District) and Zimbabwe to the south, Namibia (via the Caprivi Strip) to the southwest, and Angola to the west. The capital city of Zambia is Lusaka, located in the south-central part of Zambia. The population is concentrated mainly around Lusaka in the south and the Copperbelt Province to the north, the core economic hubs of Zambia."}],"facts":[{"qid":"Q953","kind":"ruler","value_qid":"Q717185","value_label":"Hakainde Hichilema","from_t":2021.6438356164383,"to_t":null,"title":"head of state","property":"P35","retrie