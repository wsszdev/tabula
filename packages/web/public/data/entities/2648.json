{"entity":{"id":"hb:saxony@1783","name":"Saxony","dataset":"basemaps","kind":"polity"},"territories":[{"id":6733,"name":"Saxony","set_id":"hb_1783","class":"empire","valid_from":1783,"valid_to":1800,"snapshot_held":1,"area_km2":39552.0753150482,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"German Federal Republic","min_lon":10.442492882247276,"min_lat":50.19172901019283,"max_lon":15.341517139764719,"max_lat":52.33333415587787,"source_file":"world_1783.geojson","source_row":null},{"id":7283,"name":"Saxony","set_id":"hb_1800","class":"kingdom","valid_from":1800,"valid_to":1815,"snapshot_held":1,"area_km2":39552.0753150482,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"German Federal Republic","min_lon":10.442492882247276,"min_lat":50.19172901019283,"max_lon":15.341517139764719,"max_lat":52.33333415587787,"source_file":"world_1800.geojson","source_row":null},{"id":7737,"name":"Saxony","set_id":"hb_1815","class":"kingdom","valid_from":1815,"valid_to":1878,"snapshot_held":1,"area_km2":18604.12994386935,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"German Federal Republic","min_lon":11.764644073513747,"min_lat":50.17296029772366,"max_lon":15.009285959807617,"max_lat":51.6356788567035,"source_file":"world_1815.geojson","source_row":null}],"identities":[{"qid":"Q156199","from_t":1783,"to_t":1806.964383561644,"method":"name-alias+date","confidence":0.7985949441329034,"label":"Electorate of Saxony","description":"state of the Holy Roman Empire, established when Emperor Charles IV raised the Ascanian duchy of Saxe-Wittenberg to the status of an Electorate 1356","inception":1356,"dissolved":1806.964383561644,"enwiki":"Electorate of Saxony","summary":"The Electorate of Saxony was an Electorate of the Holy Roman Empire. Centred on the Duchy of Saxe-Wittenberg with its capital at Dresden, Saxony was one of the most significant states within the empire. Formally known as the Prince-Elector of Saxony, its rulers came first from the House of Ascania from 1356 to 1422, then the House of Wettin until 1806, when it was replaced by the Kingdom of Saxony."},{"qid":"Q153015","from_t":1806.964383561644,"to_t":1878,"method":"name-template+date","confidence":0.8865736552117429,"label":"Kingdom of Saxony","description":"former German state (1806-1918)","inception":1806.9671232876713,"dissolved":1918.8602739726027,"enwiki":"Kingdom of Saxony","summary":"The Kingdom of Saxony (German: Königreich Sachsen) was a German monarchy in Central Europe between 1806 and 1918, the successor of the Electorate of Saxony. It joined the Confederation of the Rhine after the dissolution of the Holy Roman Empire, later joining the German Confederation after Napoleon was defeated in 1815. Beginning in 1871, it was part of the German Empire. It became a free state of the Weimar Republic in 1918 after the end of World War I and the abdication of King Frederick Augustus III. Its capital was Dresden, and its modern successor is the Free State of Saxony."}],"facts":[{"qid":"Q156199","kind":"ruler","value_qid":"Q77233","value_label":"Frederick III of Saxony","from_t":1486,"to_t":1525.3671232876711,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Frederick III of Saxony"},{"qid":"Q156199","kind":"capital","value_qid":"Q6837","value_label":"Lutherstadt Wittenberg","from_t":1356,"to_t":1547,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Lutherstadt Wittenberg"},{"qid":"Q156199","kind":"capital","value_qid":"Q1731","value_label":"Dresden","from_t":1547,"to_t":1806,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Dresden"},{"qid":"Q156199","kind":"official_language","value_qid":"Q397","value_label":"Latin","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Latin"},{"qid":"Q156199","kind":"language","value_qid":"Q704841","value_label":"Central German","from_t"