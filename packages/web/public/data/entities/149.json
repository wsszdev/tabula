{"entity":{"id":"cs:609","name":"Spanish Sahara","dataset":"cshapes","kind":"polity"},"territories":[{"id":10538,"name":"Spanish Sahara","set_id":"cs","class":"empire","valid_from":1958.772602739726,"valid_to":1975.868493150685,"snapshot_held":0,"area_km2":269072,"border_precision":3,"capital_name":"El Aaiun","sovereign":null,"sovereign_note":null,"modern_name":"Morocco","min_lon":-17.101527,"min_lat":20.764831,"max_lon":-8.666391,"max_lat":27.674486,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=609;start=1958-10-10"}],"identities":[{"qid":"Q689837","from_t":1958.772602739726,"to_t":1975.868493150685,"method":"name-label+date","confidence":0.95,"label":"Spanish Sahara","description":"former Spanish North African colonial possession","inception":1884,"dissolved":1976.0983606557377,"enwiki":"Spanish Sahara","summary":"Spanish Sahara (Spanish: Sahara Español; Arabic: الصحراء الإسبانية, romanized: aṣ-Ṣaḥrā' al-Isbānīyah), officially the Spanish Possessions in the Sahara from 1884 to 1958, then Province of the Sahara between 1958 and 1976, was the name used for the modern territory of Western Sahara when it was occupied and ruled by Spain between 1884 and 1976. It had been one of the most recent acquisitions as well as one of the last remaining holdings of the Spanish Empire, which had once extended from the Americas to the Spanish East Indies.\nBetween 1946 and 1958, the Spanish Sahara was amalgamated with the nearby Spanish-protected Cape Juby and Spanish Ifni to form a new colony, Spanish West Africa. This was reversed during the Ifni War when Ifni and the Sahara became provinces of Spain separately, two days apart, while Cape Juby was ceded to Morocco in the peace deal."}],"facts":[{"qid":"Q689837","kind":"capital","value_qid":"Q47837","value_label":"Laayoune","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Laayoune"},{"qid":"Q689837","kind":"successor","value_qid":"Q1028","value_label":"Morocco","from_t":null,"to_t":