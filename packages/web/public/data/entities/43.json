{"entity":{"id":"cs:341","name":"Montenegro","dataset":"cshapes","kind":"polity"},"territories":[{"id":10219,"name":"Montenegro","set_id":"cs","class":"kingdom","valid_from":1886,"valid_to":1913.6054794520549,"snapshot_held":0,"area_km2":9949.51,"border_precision":3,"capital_name":"Cetinje","sovereign":null,"sovereign_note":null,"modern_name":"Montenegro","min_lon":18.453327,"min_lat":41.849,"max_lon":19.961159,"max_lat":43.357232,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=341;start=1886-1-1"},{"id":10220,"name":"Montenegro","set_id":"cs","class":"kingdom","valid_from":1913.6054794520549,"valid_to":1915.4986301369863,"snapshot_held":0,"area_km2":15906.9,"border_precision":3,"capital_name":"Cetinje","sovereign":null,"sovereign_note":null,"modern_name":"Montenegro","min_lon":18.453327,"min_lat":41.849,"max_lon":20.680202,"max_lat":43.555973,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=341;start=1913-8-10"},{"id":10221,"name":"Montenegro","set_id":"cs","class":"kingdom","valid_from":1915.4986301369863,"valid_to":1918.9150684931508,"snapshot_held":0,"area_km2":15906.9,"border_precision":3,"capital_name":"Cetinje","sovereign":null,"sovereign_note":null,"modern_name":"Montenegro","min_lon":18.453327,"min_lat":41.849,"max_lon":20.680202,"max_lat":43.555973,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=341;start=1915-7-2"},{"id":10222,"name":"Montenegro","set_id":"cs","class":"republic","valid_from":2006.4438356164383,"valid_to":2020,"snapshot_held":0,"area_km2":14009.5,"border_precision":3,"capital_name":"Podgorica","sovereign":null,"sovereign_note":null,"modern_name":"Montenegro","min_lon":18.453327,"min_lat":41.849,"max_lon":20.362728,"max_lat":43.555973,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=341;start=2006-6-12"}],"identities":[{"qid":"Q779011","from_t":1886,"to_t":1910,"method":"name-template+date","confidence":0.8890521917450053,"label":"Principality of Montenegro","description":"1852–1910 principality in Southeastern Europe","inception":1852,"dissolved":1910,"enwiki":"Principality of Montenegro","summary":"The Principality of Montenegro (Serbian: Књажевина Црна Горa / Knjaževina Crna Gora) was a principality in Southeastern Europe that existed from 13 March 1852 to 28 August 1910. It was then proclaimed a kingdom by Nikola I, who then became King of Montenegro.\nThe capital was Cetinje and the Montenegrin perper was used as the state currency from 1906. The territory corresponded to the central area of modern-day Montenegro."},{"qid":"Q386496","from_t":1910,"to_t":1918.9013698630138,"method":"name-template+date","confidence":0.9151711413469694,"label":"Kingdom of Montenegro","description":"1910–1918 kingdom in Southeastern Europe","inception":1910,"dissolved":1918.9013698630138,"enwiki":"Kingdom of Montenegro","summary":"The Kingdom of Montenegro (Serbian: Краљевина Црна Гора, romanized: Kraljevina Crna Gora) was a monarchy in southeastern Europe, present-day Montenegro, during the tumultuous period of time on the Balkan Peninsula leading up to and during World War I. Officially it was a constitutional monarchy, but absolutist in practice. On 28 November 1918, following the end of World War I, with the Montenegrin government still in exile, the Podgorica Assembly proclaimed unification with the Kingdom of Serbia, which itself was merged into the Kingdom of Serbs, Croats and Slovenes three days later, on 1 December 1918. This unification with Serbia lasted, through various successor states, for almost 88 years, ending in 2006.\nDuring this period, Montenegro remained largely rural and traditional."},{"qid":"Q616992","from_t":1941,"to_t":1944,"method":"name-template+date","confidence":0.9152753708495222,"label":"Governorate of Montenegro","description":"short-lived territory on the Balkan Peninsula between 1941–1943","inception":1941,"dissolved":1944,"enwiki":"Italian governorate of Montenegro","summary":"The Italian governorate of Montenegro (Italian: Governatorato del Montenegro) existed from October 1941 to September 1943 as an occupied territory under military government of the Kingdom of Italy during World War II. Although the Italians had intended to establish a quasi-independent Montenegrin kingdom, these plans were permanently shelved after a popular uprising in July 1941. Following the Italian surrender in September 1943, the territory of Montenegro was occupied by German forces which withdrew in December 1944."},{"qid":"Q236","from_t":2006.4191780821918,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Montenegro","description":"country in southeastern Europe","inception":2006.4191780821918,"dissolved":null,"enwiki":"Montenegro","summary":"Montenegro is a country in Southeastern Europe, on the Balkan Peninsula. Its 25 municipalities have a total population of 633,158 people in an area of 13,883 km2 (5,360 sq mi). It is bordered by Serbia to the northeast, Bosnia and Herzegovina to the northwest, Kosovo to the east, Albania to the southeast, and Croatia to the west, and has a coastline along the Adriatic Sea to the southwest. The capital and largest city is Podgorica, while Cetinje is the Old Royal Capital and cultural centre."}],"facts":[{"qid":"Q779011","kind":"ruler","value_qid":"Q1262875","value_label":"Danilo I, Prince of Montenegro","from_t":1851,"to_t":1860,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Danilo I, Prince of Montenegro"},{"qid":"Q779011","kind":"ruler","value_qid":"Q283255","value_label":"Nicholas I of Montenegro","from_t":1860,"to_t":1910,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Nicholas I of Montenegro"},{"qid":"Q779011","kind":"capital","value_qid":"Q173338","value_label":"Cetinje","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Cetinje"},{"qid":"Q779011","kind":"official_language","value_qid":"Q9301","value_label":"Serbo-Croatian","from_t":null,"to_t":null,"title":null,"property":"P37","retrie