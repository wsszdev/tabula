{"entity":{"id":"hb:principality-of-polotsk@1100","name":"Principality of Polotsk","dataset":"basemaps","kind":"kingdom"},"territories":[{"id":1977,"name":"Principality of Polotsk","set_id":"hb_1100","class":"kingdom","valid_from":1100,"valid_to":1200,"snapshot_held":1,"area_km2":46880.81714677923,"border_precision":1,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Belarus (Byelorussia)","min_lon":26.523854885668158,"min_lat":53.50460789918692,"max_lon":29.66534515470106,"max_lat":56.51542477303413,"source_file":"world_1100.geojson","source_row":null}],"identities":[{"qid":"Q517333","from_t":1100,"to_t":1200,"method":"name-label+date","confidence":0.95,"label":"Principality of Polotsk","description":"principality","inception":900,"dissolved":1397,"enwiki":"Principality of Polotsk","summary":"The Principality of Polotsk (obsolete spelling: Polock; Belarusian: По́лацкае кня́ства, romanized: Połackaje kniastva; Latin: Polocensis Ducatus), also known as the Duchy of Polotsk or Polotskian Rus', was a medieval principality. The origin and date of the establishment of the state are uncertain. Chronicles of Kievan Rus' mention Polotsk being conquered by Vladimir the Great, and thereafter it became associated with Kievan Rus' and its ruling Rurikids.\nThe principality was supposedly established around the town of Polotsk (now in Belarus) by the tribal union of Krivichs."}],"facts":[{"qid":"Q517333","kind":"ruler","value_qid":"Q2498541","value_label":"Rogvolod","from_t":945,"to_t":978,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Rogvolod"},{"qid":"Q517333","kind":"ruler","value_qid":"Q2357762","value_label":"Izyaslav of Polotsk","from_t":988,"to_t":1001,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Izyaslav of Polotsk"},{"qid":"Q517333","kind":"ruler","value_qid":"Q2625711","value_label":"Vseslav Izyaslavich","from_t":1001,"to_t":1003,"title":"head of state","property":"P35","retrieved":"2026-10-30