,{"qid":"Q1049","kind":"ruler","value_qid":"Q63111184","value_label":"Abdel Fattah al-Burhan","from_t":2019.2767123287672,"to_t":2019.6356164383562,"title":"Chairman of the Transitional Military Council","property":"P39","retrieved":"2026-10-30","vl":"Abdel Fattah al-Burhan"},{"qid":"Q1049","kind":"ruler","value_qid":"Q255545","value_label":"Ismail al-Azhari","from_t":1965.1616438356164,"to_t":1969.3287671232877,"title":"President of Sudan","property":"P39","retrieved":"2026-10-30","vl":"Ismail al-Azhari"},{"qid":"Q1049","kind":"ruler","value_qid":"Q307451","value_label":"Abdel Rahman Swar al-Dahab","from_t":1985.2602739726028,"to_t":1986.3424657534247,"title":"President of Sudan","property":"P39","retrieved":"2026-10-30","vl":"Abdel Rahman Swar al-Dahab"},{"qid":"Q1049","kind":"ruler","value_qid":"Q311798","value_label":"Gaafar Nimeiry","from_t":1969.3945205479451,"to_t":1985.2602739726028,"title":"President of Sudan","property":"P39","retrieved":"2026-10-30","vl":"Gaafar Nimeiry"},{"qid":"Q1049","kind":"ruler","value_qid":"Q319216","value_label":"Ibrahim Abboud","from_t":1958.876712328767,"to_t":1964.8743169398906,"title":"President of Sudan","property":"P39","retrieved":"2026-10-30","vl":"Ibrahim Abboud"},{"qid":"Q1049","kind":"ruler","value_qid":"Q400918","value_label":"Ahmed al-Mirghani","from_t":1986.3424657534247,"to_t":1989.4931506849316,"title":"President of Sudan","property":"P39","retrieved":"2026-10-30","vl":"Ahmed al-Mirghani"},{"qid":"Q1049","kind":"ruler","value_qid":"Q57265","value_label":"Omar al-Bashir","from_t":1989.4931506849316,"to_t":2019.2739726027398,"title":"President of Sudan","property":"P39","retrieved":"2026-10-30","vl":"Omar al-Bashir"},{"qid":"Q1049","kind":"flag","value_qid":"Q102198","value_label":"Flag of Sudan.svg","from_t":1970.3808219178081,"to_t":null,"title":"flag of Sudan","property":"P163","retrieved":"2026-10-30","vl":"flag of Sudan"}],"people":{"Q63111184":{"label":"Abdel Fattah al-Burhan","description":"President of the Sovereignty Council of Sudan","enwiki":"Abdel Fattah al-Burhan","summary":"Abdel Fattah al-Burhan Abdelrahman al-Burhan (born 11 July 1960) is a Sudanese military officer who has been the leader of Sudan since 2019. Following the Sudanese Revolution in April 2019, he was handed control of the military junta, the Transitional Military Council, a day after it was formed, due to protesters' dissatisfaction with the establishment ties of initial leader Ahmed Awad Ibn Auf. He served as chairman of the TMC until a draft constitutional declaration signed with civilians went into effect on 17 August and a collective head of state Transitional Sovereignty Council was formed on 21 August, also to be initially headed by al-Burhan.\nThe 2020 Juba Agreement allowed al-Burhan to continue to lead the Sovereignty Council for another 20 months, rather than stepping down as planned in February 2021.","image":"Abdel Fattah al-Burhan in April 2025 (cropped).jpg","birth":1960.5245901639344,"death":null},"Q27654948":{"label":"Abdalla Hamdok","description":"Sudanese public administrator and former prime minister","enwiki":"Abdalla Hamdok","summary":"Abdalla Hamdok Al-Kinani (also transliterated Abdallah, Hamdouk, AlKinani; Arabic: عبد الله حمدوك الكناني, romanized: ʻAbd Allāh Ḥamdūk al-Kinānī; born 1 January 1956) is a Sudanese public administrator who served as the 15th prime minister of Sudan from 2019 to October 2021, and again from November 2021 until his resignation in 2022.\nPrior to his appointment, Hamdok served in numerous national and international administrative positions. From November 2011 to October 2018, he was deputy executive secretary of the United Nations Economic Commission for Africa (UNECA). UNECA staff described Hamdok as \"[a] diplomat, a humble man and a brilliant and disciplined mind\".","image":"Mark Green and Abdalla Hamdok at USAID HQ (2) (cropped).jpg","birth":1956,"death":null},"Q22949078":{"label":"Ahmed Awad Ibn Auf","description":"Sudanese military officer","enwiki":"Ahmed Awad Ibn Auf","summary":"Ahmed Awad Ibn Auf (born c. 1956;  Arabic: أحمد عوض بن عوف‎) is a Sudanese military officer and politician who served as the head of state for one day from 11 April 2019 to 12 April 2019 after taking part in the 2019 Sudanese coup d'état. Auf previously served as the minister of defense in Sudan from 23 August 2015 to 14 April 2019, and the First Vice President of Sudan from February to April 2019.","image":null,"birth":1956,"death":null},"Q255545":{"label":"Ismail al-Azhari","description":"President of Sudan from 1965 to 1969","enwiki":"Ismail al-Azhari","summary":"Ismail al-Azhari (Arabic: إسماعيل الأزهري, romanized: ʼIsmāʻīl al-Azharī; October 20, 1900 – August 26, 1969) was a Sudanese nationalist and political figure. He served as the first  Prime Minister of Sudan between 1954 and 1956, and as Head of State of Sudan from 1965 until he was overthrown by Gaafar Nimeiry in 1969.\nHe was president of the National Unionist Party (now the Democratic Unionist Party) when the unionist parties united under his leadership. In 1954 he was elected prime minister from within the parliament and under the influence of the growing sense of the need for independence of Sudan and before the union discussion with Egypt.","image":"Ismail al-Azhari.jpg","birth":1901.8,"death":1969.6493150684933},"Q307451":{"label":"Abdel Rahman Swar al-Dahab","description":"President of Sudan (1934-2018)","enwiki":"Abdel Rahman Swar al-Dahab","summary":"Abdel Rahman Suwar al-Dahab (otherwise known as Suwar al-Dahab or al-Dahab; 1 January 1934 – 18 October 2018) (Arabic: عبد الرحمن سوار الذهب) was a Sudanese military officer who served as the Head of State of Sudan from 6 April 1985, to 6 May 1986.\nHis full name has also been listed by the Sudanese Ministry of Defence as Abdul Rahman Muhammad Hassan Swar Al Thahab.","image":"Abdel Rahman Swar al-Dahab.png","birth":1934,"death":2018.7945205479452},"Q311798":{"label":"Gaafar Nimeiry","description":"Sudanese President (1931-2009)","enwiki":"Gaafar Nimeiry","summary":"Gaafar Muhammad an-Nimeiry (also spelled Jaafar Nimeiry, or Ja'far Muhammad Numayri; Arabic: جعفر محمد النميري, romanized: Jaʿfar Muḥammad an-Numayrī; 1 January 1930 – 30 May 2009) was a Sudanese military officer, politician, and revolutionary who served as the head of state of Sudan from 1969 to 1985, first as Chairman of the National Revolutionary Command Council and then as President.\nA devout Muslim and military officer, Nimeiry came to power after leading a military coup in 1969. He established a one-party state, with his Sudanese Socialist Union (SSU) acting as the sole legal political entity. He began his rule as a left-wing admirer of Egyptian President Gamal Abdel Nasser, pursuing socialist and Pan-Arabist policies.","image":"Gaafar Nimeiry in 1974.jpg","birth":1931,"death":2009.4082191780822},"Q319216":{"label":"Ibrahim Abboud","description":"Sudanese politician and head of state (1900–1983)","enwiki":"Ibrahim Abboud","summary":"Ibrahim Abboud (Arabic: إبراهيم عبود; 26 October 1900 – 8 September 1983) was a Sudanese military officer and political figure who served as the head of state of Sudan between 1958 and 1964 and as President of Sudan in 1964; however, he soon resigned, ending Sudan's first period of military rule. A career soldier, Abboud served in World War II in Egypt and Iraq. In 1949, Abboud became the deputy Commander in Chief of the Sudanese military. Upon independence, Abboud became the Commander in Chief of the Military of Sudan.","image":"Ibrahim Abboud2.jpg","birth":1900.8164383561643,"death":1983.6849315068494},"Q400918":{"label":"Ahmed al-Mirghani","description":"Sudanese politician (1941–2008)","enwiki":"Ahmed al-Mirghani","summary":"Ahmad Ali Al-Mirghani (Arabic: أحمد علي الميرغني; 16 August 1941 – 2 November 2008) was a Sudanese politician who served as the third President of Sudan from 1986 to 1989, when the democratically elected government was overthrown by a military coup led by Omar al-Bashir.","image":"Ahmed al-Mirghani.gif","birth":1941.6219178082192,"death":2008.8360655737704},"Q57265":{"label":"Omar al-Bashir","description":"President of Sudan from 1989 to 2019","enwiki":"Omar al-Bashir","summary":"Omar Hassan Ahmad al-Bashir (born 1 January 1944) is a Sudanese former military officer and politician who served as head of state of Sudan under various titles from 1989 until 2019, when he was deposed in a coup d'état. He was subsequently imprisoned, tried and convicted on multiple corruption charges.\nAl-Bashir came to power in 1989 when, as a brigadier general in the Sudanese Army, he led a group of officers supported by National Islamic Front (NIF) in a military coup that ousted the democratically elected government of prime minister Sadiq al-Mahdi after it began negotiations with rebels in the south; he subsequently replaced President Ahmed al-Mirghani as head of state. He was elected three times as president in elections that have been under scrutiny for electoral fraud.","image":"Omar al-Bashir, 12th AU Summit, 090202-N-0506A-137 cropped.jpg","birth":1944,"death":null}},"media":{"Flag of French Sudan (1958–1959).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/71/Flag_of_French_Sudan_%281958%E2%80%931959%29.svg/330px-Flag_of_French_Sudan_%281958%E2%80%931959%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_French_Sudan_(1958%E2%80%931959).svg","author":"Akiramenai","license":"Public domain"},"Flag of Sudan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Flag_of_Sudan.svg/330px-Flag_of_Sudan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Sudan.svg","author":"See File history below for details.","license":"Public domain"},"Emblem of Sudan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Emblem_of_Sudan.svg/330px-Emblem_of_Sudan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Sudan.svg","author":"Thommy","license":"Public domain"},"Abdel Fattah al-Burhan in April 2025 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Abdel_Fattah_al-Burhan_in_April_2025_%28cropped%29.jpg/330px-Abdel_Fattah_al-Burhan_in_April_2025_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Abdel_Fattah_al-Burhan_in_April_2025_(cropped).jpg","author":"Press Service of the President of the Republic of Azerbaijan","license":"CC BY 4.0"},"Mark Green and Abdalla Hamdok at USAID HQ (2) (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Mark_Green_and_Abdalla_Hamdok_at_USAID_HQ_%282%29_%28cropped%29.jpg/330px-Mark_Green_and_Abdalla_Hamdok_at_USAID_HQ_%282%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mark_Green_and_Abdalla_Hamdok_at_USAID_HQ_(2)_(cropped).jpg","author":"Office of USAID Administrator","license":"Public domain"},"Ismail al-Azhari.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/Ismail_al-Azhari.jpg/330px-Ismail_al-Azhari.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ismail_al-Azhari.jpg","author":"Sudanese Government photographer","license":"Public domain"},"Abdel Rahman Swar al-Dahab.png":{"url":"https://upload.wikimedia.org/wikipedia/commons/2/2e/Abdel_Rahman_Swar_al-Dahab.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Abdel_Rahman_Swar_al-Dahab.png","author":"Unknown Military Photographer","license":"Public domain"}