ax_lon":-34.890675511750004,"max_lat":5.689471326783938,"source_file":"world_1815.geojson","source_row":null}],"identities":[{"qid":"Q2088324","from_t":1715,"to_t":1815,"method":"curated","confidence":0.98,"label":"Colonial Brazil","description":"Portuguese possession in South America (1500–1808)","inception":1500,"dissolved":1815,"enwiki":"Colonial Brazil","summary":"Colonial Brazil (Portuguese: Brasil Colonial), sometimes referred to as Portuguese America, comprises the period from 1500, with the arrival of the Portuguese, until 1815, when Brazil was elevated to a kingdom in union with Portugal. During the 300 years of Brazilian colonial history, the main economic activities of the territory were based first on brazilwood extraction (brazilwood cycle), which gave the territory its name; sugar production (sugar cycle); and finally on gold and diamond mining (gold cycle). Slaves, especially those brought from Africa, provided most of the workforce of the Brazilian export economy after a brief initial period of Indigenous slavery to cut brazilwood.\nIn contrast to the neighboring Spanish possessions, which had several viceroyalties, the colony of Brazil was settled mainly in the coastal area by the Portuguese and a large black slave population working on sugar plantations and mines."}],"facts":[{"qid":"Q2088324","kind":"capital","value_qid":"Q36947","value_label":"Salvador","from_t":1540,"to_t":1763,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Salvador"},{"qid":"Q2088324","kind":"capital","value_qid":"Q8678","value_label":"Rio de Janeiro","from_t":1763,"to_t":1815,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Rio de Janeiro"},{"qid":"Q2088324","kind":"language","value_qid":"Q5146","value_label":"Portuguese","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Portuguese"},{"qid":"Q2088324","kind":"language","value_qid":"Q34333","value_label":"Nheengatu","from_t":null,"to_t":null,"title":null,"property