row":null}],"identities":[{"qid":"Q25227","from_t":1954.9534246575342,"to_t":2010.772602739726,"method":"name-label+date","confidence":0.95,"label":"Netherlands Antilles","description":"former country within the Kingdom of the Netherlands","inception":1954.9534246575342,"dissolved":2010.772602739726,"enwiki":"Netherlands Antilles","summary":"The Netherlands Antilles (Dutch: Nederlandse Antillen, pronounced [ˈneːdərlɑntsə ʔɑnˈtɪlə(n)] ; Papiamento: Antias Hulandes), also known as the Dutch Antilles, was a constituent Caribbean country of the Kingdom of the Netherlands consisting of the islands of Saba, Sint Eustatius, and Sint Maarten in the Lesser Antilles, and Aruba, Bonaire, and Curaçao  in the Leeward Antilles. The country came into being in 1954 as the autonomous successor of the Dutch colony of Curaçao and Dependencies, and it was dissolved in 2010, when Aruba (in 1986), Sint Maarten and Curaçao gained the status of constituent countries within the Kingdom of the Netherlands, and Saba, Sint Eustatius, and Bonaire gained the status of special municipalities of the Netherlands as the Caribbean Netherlands. The neighboring Dutch colony of Surinam, in continental South America, did not become part of the Netherlands Antilles but became a separate sovereign country in 1954. All the territories that formerly belonged to the Netherlands Antilles remain part of the Kingdom of the Netherlands today, although the legal status of each island differs."}],"facts":[{"qid":"Q25227","kind":"capital","value_qid":"Q132679","value_label":"Willemstad","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Willemstad"},{"qid":"Q25227","kind":"official_language","value_qid":"Q7411","value_label":"Dutch","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Dutch"},{"qid":"Q25227","kind":"official_language","value_qid":"Q33856","value_label":"Papiamento","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved