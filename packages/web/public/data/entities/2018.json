","value_qid":"Q219918","value_label":"Samora Moisés Machel","from_t":1975.4794520547946,"to_t":1986.7972602739726,"title":"President of Mozambique","property":"P39","retrieved":"2026-10-30","vl":"Samora Moisés Machel"},{"qid":"Q1029","kind":"ruler","value_qid":"Q5448556","value_label":"Filipe Nyusi","from_t":2015.0383561643835,"to_t":2025.0383561643835,"title":"President of Mozambique","property":"P39","retrieved":"2026-10-30","vl":"Filipe Nyusi"},{"qid":"Q1029","kind":"ruler","value_qid":"Q57392","value_label":"Armando Guebuza","from_t":2005.0876712328768,"to_t":2015.0876712328768,"title":"President of Mozambique","property":"P39","retrieved":"2026-10-30","vl":"Armando Guebuza"},{"qid":"Q1029","kind":"flag","value_qid":"Q484249","value_label":"Flag of Mozambique.svg","from_t":1983.3287671232877,"to_t":null,"title":"flag of Mozambique","property":"P163","retrieved":"2026-10-30","vl":"flag of Mozambique"}],"people":{"Q97058466":{"label":"Daniel Chapo","description":"President of Mozambique since 2025","enwiki":"Daniel Chapo","summary":"Daniel Francisco Chapo (born 6 January 1977) is a Mozambican politician, lawyer and jurist who has been the president of Mozambique since 15 January 2025. Chapo previously served as the governor of Inhambane Province from 2016 to 2024. Chapo was the Secretary-General and candidate of the ruling political party, FRELIMO, for the 2024 presidential election.","image":"Daniel Chapo on November 24, 2025 (cropped).jpg","birth":1977.013698630137,"death":null},"Q6761049":{"label":"Maria Benvinda Levy","description":"Prime Minister of Mozambique","enwiki":"Maria Benvinda Levy","summary":"Maria Benvinda Levy (born 24 March 1969) is a Mozambican jurist and politician who has been the 16th Prime Minister of Mozambique since her appointment by President Daniel Chapo in 2025. Prior to her tenure as prime minister she was Minister of Justice from 2008 to 2015, and a judge in Maputo.","image":null,"birth":1969.2246575342465,"death":null},"Q208355":{"label":"Joaquim Chissano","description":"2nd President of Mozambique","enwiki":"Joaquim Chissano","summary":"Joaquim Alberto Chissano (born 22 October 1939) is a Mozambican politician who served as the second President of Mozambique, from 1986 to 2005. He is credited with transforming the war-torn country of Mozambique into an African democracy. After his presidency, Chissano became an elder statesman, envoy and diplomat for both his home country and the United Nations. Chissano also served as Chairperson of the African Union from 2003 to 2004.","image":"Joaquim Chissano (cropped).jpg","birth":1939.805479452055,"death":null},"Q219918":{"label":"Samora Moisés Machel","description":"1st President of Mozambique (1933–1986)","enwiki":"Samora Machel","summary":"Samora Moisés Machel (September 29, 1933 – October 19, 1986) was a Mozambican politician and revolutionary who served as the first President of Mozambique from the country's independence in 1975 until his death in the 1986 Mozambican Tupolev Tu-134 plane crash which killed 34 people, including several Mozambican ministers and government officials. Machel was a socialist in the tradition of Marxism–Leninism.","image":"Samora Moises Machel detail DF-SC-88-01383.jpg","birth":1933.7424657534248,"death":1986.7972602739726},"Q5448556":{"label":"Filipe Nyusi","description":"President of Mozambique, 2015-2025","enwiki":"Filipe Nyusi","summary":"Filipe Jacinto Nyusi (Portuguese pronunciation: [fiˈlipɨ ʒɐˈsĩtu ˈɲusi]; born 9 February 1959) is a Mozambican politician who was the president of Mozambique from 2015 to 2025. He has also served as the Chairman of the Southern African Development Community from 2020 to 2022. During his time in office, President Nyusi signed multiple agreements with the main opposition parties, RENAMO.\nNyusi served as the Minister of Defense from 2008 to 2014 under Armando Guebuza. He won the 2014 and 2019 Mozambican presidential elections as the candidate of FRELIMO. Despite allegations of irregularities the President of the National Election Commission stated that \"the elections were free, fair and transparent\", with the Constitutional Count verifying the result on 23 December 2019.","image":"Filipe Nyusi - 2019 (cropped).jpg","birth":1959.1068493150685,"death":null},"Q57392":{"label":"Armando Guebuza","description":"3rd President of Mozambique","enwiki":"Armando Guebuza","summary":"Armando Emílio Guebuza (born 20 January 1943) is a Mozambican politician who was the President of Mozambique from 2005 to 2015.","image":"Armando Guebuza 2014-08-11.jpg","birth":1943.0520547945205,"death":null}},"media":{"Flag of Portugal (official).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Flag_of_Portugal_%28official%29.svg/330px-Flag_of_Portugal_%28official%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Portugal_(official).svg","author":"Original: Columbano Bordalo Pinheiro Vector:  Vítor Luís Rodrigues, António Martins-Tuválkin","license":"Public domain"},"Coat of arms of Mozambique (1935–1975, lesser).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9b/Coat_of_arms_of_Mozambique_%281935%E2%80%931975%2C_lesser%29.svg/330px-Coat_of_arms_of_Mozambique_%281935%E2%80%931975%2C_lesser%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Mozambique_(1935%E2%80%931975,_lesser).svg","author":"Thommy","license":"Public domain"},"Flag of Mozambique.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Flag_of_Mozambique.svg/330px-Flag_of_Mozambique.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Mozambique.svg","author":"FRELIMO","license":"Public domain"},"Emblem of Mozambique.svg":{"url":"https://thumb.wikimedia.org/wikipedia/com