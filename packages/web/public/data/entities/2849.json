{"entity":{"id":"hb:syria-france@1920","name":"Syria (France)","dataset":"basemaps","kind":"polity"},"territories":[{"id":8820,"name":"Syria (France)","set_id":"hb_1920","class":"dependency","valid_from":1920,"valid_to":1930,"snapshot_held":1,"area_km2":321375.024665651,"border_precision":3,"capital_name":null,"sovereign":"France","sovereign_note":"As mapped by Historical Basemaps (world_1920.geojson)","modern_name":"Syria","min_lon":34.97200683077929,"min_lat":32.27142181748867,"max_lon":44.79458907565234,"max_lat":39.07146608418057,"source_file":"world_1920.geojson","source_row":null},{"id":8856,"name":"Syria (France)","set_id":"hb_1930","class":"dependency","valid_from":1930,"valid_to":1938,"snapshot_held":1,"area_km2":321375.0246656525,"border_precision":3,"capital_name":null,"sovereign":"France","sovereign_note":"As mapped by Historical Basemaps (world_1930.geojson)","modern_name":"Syria","min_lon":34.9720068307793,"min_lat":32.27142181748867,"max_lon":44.79458907565234,"max_lat":39.07146608418057,"source_file":"world_1930.geojson","source_row":null},{"id":9053,"name":"Syria (France)","set_id":"hb_1938","class":"dependency","valid_from":1938,"valid_to":1945,"snapshot_held":1,"area_km2":321354.76651221927,"border_precision":3,"capital_name":null,"sovereign":"France","sovereign_note":"As mapped by Historical Basemaps (world_1938.geojson)","modern_name":"Syria","min_lon":34.97200683077929,"min_lat":32.27142181748867,"max_lon":44.79458907565234,"max_lat":39.07146608418057,"source_file":"world_1938.geojson","source_row":null}],"identities":[{"qid":"Q146600","from_t":1920,"to_t":1920.6666666666667,"method":"name-template+date","confidence":0.9331378915840787,"label":"Arab Kingdom of Syria","description":"former country","inception":1920,"dissolved":1920,"enwiki":"Arab Kingdom of Syria","summary":"The Syrian Arab Kingdom (Arabic: المملكة العربية السورية, al-Mamlakah al-ʿArabiyyah al-Sūriyyah) was an unrecognized monarchy existing briefly in the territory of historical Syria. It was announced on 5 October 1918 as a fully independent Arab constitutional government with the permission of the British Empire. It gained independence as an emirate after the withdrawal of British forces from OETA East on 26 November 1919, and was proclaimed a kingdom on 8 March 1920.\nAs a kingdom, the state existed for a little over four months, from 8 March to 25 July 1920."},{"qid":"Q858","from_t":1920.6666666666667,"to_t":1945,"method":"name-label+date","confidence":0.748983266557802,"label":"Syria","description":"country in West Asia","inception":1920.1830601092897,"dissolved":null,"enwiki":"Syria","summary":"Syria, officially the Syrian Arab Republic, is a country in West Asia located in the Eastern Mediterranean and the Levant. It borders the Mediterranean Sea to the west, Turkey to the north and northwest, Iraq to the east and southeast, Jordan to the south, and Israel and Lebanon to the southwest. It is a republic under a provisional government and comprises 14 governorates. Damascus is Syria's capital and largest city."}],"facts":[{"qid":"Q146600","kind":"capital","value_qid":"Q3766","value_label":"Damascus","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Damascus"},{"qid":"Q146600","kind":"official_language","value_qid":"Q13955","value_label":"Arabic","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Arabic"},{"qid":"Q146600","kind":"government","value_qid":"Q7269","value_label":"monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"monarchy"},{"qid":"Q146600","kind":"government","value_qid":"Q41614","value_label":"constitutional monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"constitutional monarchy"},{"qid":"Q146600","kind":"predecessor","value_qid":"Q7075820","value_label":"Occupied Enemy Territory Administration","from_t":null,"to_t":null,"title":null,"property":"P1365","