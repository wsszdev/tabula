y":"P2936","retrieved":"2026-10-30","vl":"Kiduruma"},{"qid":"Q114","kind":"language","value_qid":"Q36398","value_label":"Sheng","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Sheng"},{"qid":"Q114","kind":"predecessor","value_qid":"Q6392538","value_label":"Kenya (1963–1964)","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Kenya (1963–1964)"},{"qid":"Q114","kind":"flag","value_qid":null,"value_label":"Flag of Kenya.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q114","kind":"coat","value_qid":null,"value_label":"Coat of arms of Kenya (Official).svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q114","kind":"ruler","value_qid":"Q173563","value_label":"Jomo Kenyatta","from_t":1964.9453551912568,"to_t":1978.6383561643836,"title":"President of Kenya","property":"P39","retrieved":"2026-10-30","vl":"Jomo Kenyatta"},{"qid":"Q114","kind":"ruler","value_qid":"Q193492","value_label":"Daniel arap Moi","from_t":1978.6383561643836,"to_t":2002.9945205479453,"title":"President of Kenya","property":"P39","retrieved":"2026-10-30","vl":"Daniel arap Moi"},{"qid":"Q114","kind":"ruler","value_qid":"Q196070","value_label":"Uhuru Kenyatta","from_t":2013.268493150685,"to_t":2022.6986301369864,"title":"President of Kenya","property":"P39","retrieved":"2026-10-30","vl":"Uhuru Kenyatta"},{"qid":"Q114","kind":"ruler","value_qid":"Q57291","value_label":"Mwai Kibaki","from_t":2002.9945205479453,"to_t":2013.268493150685,"title":"President of Kenya","property":"P39","retrieved":"2026-10-30","vl":"Mwai Kibaki"},{"qid":"Q114","kind":"flag","value_qid":"Q165905","value_label":"Flag of Kenya.svg","from_t":1963.945205479452,"to_t":null,"title":"flag of Kenya","property":"P163","retrieved":"2026-10-30","vl":"flag of Kenya"}],"people":{"Q195725":{"label":"William Ruto","description":"President of Kenya since 2022","enwiki":"William Ruto","summary":"William Kipchirchir Samoei Arap Ruto   (born 21 December 1966) is a Kenyan politician who is the fifth and current president of Kenya since 13 September 2022. Prior to becoming president, he served as the first elected deputy president of Kenya from 2013 to 2022. He previously served in three cabinet portfolios as the Minister for Home Affairs, the Minister of Agriculture and as Minister for Higher Education.\nRuto was elected Member of Parliament for Eldoret North constituency from 1997 to 2007 under the KANU, and from 2007 to 2013 through the ODM party.","image":"William Ruto 2023 (cropped).jpg","birth":1966.9698630136986,"death":null},"Q173563":{"label":"Jomo Kenyatta","description":"first Prime Minister (1963 to 1964) and President (1964 to 1978) of self-governing Kenya","enwiki":"Jomo Kenyatta","summary":"Jomo Kenyatta (c. 1897 – 22 August 1978) was a Kenyan anti-colonial activist and politician who governed Kenya as its Prime Minister from 1963 to 1964 and then as its first President from 1964 to his death in 1978. He played a significant role in the transformation of Kenya from a colony of the British Empire into an independent republic. Ideologically an African nationalist and a conservative, he led the Kenya African National Union (KANU) party from 1961 until his death. \nKenyatta was born to Kikuyu farmers in Kiambu, British East Africa.","image":"Jomo Kenyatta (cropped) in June 15th, 1966.jpg","birth":1893.8,"death":1978.6383561643836},"Q193492":{"label":"Daniel arap Moi","description":"Kenyan President (2nd) (1924-2020)","enwiki":"Daniel arap Moi","summary":"Daniel Toroitich arap Moi ( MOH-ee; 2 September 1924 – 4 February 2020) was a Kenyan politician who served as the second president of Kenya from 1978 to 2002. He is the country's longest-serving president to date. Moi previously served as the third vice president of Kenya from 1967 to 1978 under President Jomo Kenyatta, becoming the president following the latter's death.\nBorn into the Tugen sub-group of the Kalenjin people in the Kenyan Rift Valley, Moi studied as a boy at the Africa Inland Mission school before training as a teacher at the Tambach teachers training college, working in that profession until 1955.","image":"Daniel arap Moi 1979b.jpg","birth":1924.6693989071039,"death":2020.0928961748634},"Q196070":{"label":"Uhuru Kenyatta","description":"4th President of Republic of Kenya (2013–2022)","enwiki":"Uhuru Kenyatta","summary":"Uhuru Mũigai Kenyatta  (  born 26 October 1961) is a Kenyan politician who served as the fourth president of Kenya from 2013 to 2022. The son of Jomo Kenyatta, Kenya's first president, he had previously served as Deputy Prime Minister from 2008 to 2013 and as the leader of official opposition from 2003 to 2007.\nDaniel Arap Moi had picked Kenyatta as his preferred successor. However, he was defeated by the then opposition leader Mwai Kibaki in the 2002 election, and Kibaki was subsequently sworn in as the President.","image":"PMO IMG 5262 (40547346173) (cropped).jpg","birth":1961.8164383561643,"death":null},"Q57291":{"label":"Mwai Kibaki","description":"3rd President of Kenya (1931–2022)","enwiki":"Mwai Kibaki","summary":"Emilio Stanley Mwai Kibaki (15 November 1931 – 21 April 2022) was a Kenyan politician who served as the third President of Kenya from December 2002 until April 2013. He served in various leadership positions in Kenya's government including being the longest serving Member of Parliament (MP) in Kenya from 1963 to 2013. He was the fourth Vice-President of Kenya for ten years from 1978 to 1988 under President Daniel arap Moi. He also held cabinet ministerial positions in the Jomo Kenyatta and Daniel arap Moi governments, including as minister for Finance (1969–1981) under Kenyatta, and Minister for Home Affairs (1982–1988) and Minister for Health (1988–1991) under Moi.","image":"Mwai Kibaki (cropped).jpg","birth":1931.8712328767124,"death":2022.3013698630136}},"media":{"Flag of Kenya.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/49/Flag_of_Kenya.svg/330px-Flag_of_Kenya.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Kenya.svg","author":"User:Pumbaa80","license":"Public domain"},"Coat of arms of Kenya (Official).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f6/Coat_of_arms_of_Kenya_%28Official%29.svg/330px-Coat_of_arms_of_Kenya_%28Official%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Kenya_(Official).svg","author":"Ashiriz","license":"CC BY-SA 3.0"},"William Ruto 2023 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/William_Ruto_2023_%28cropped%29.jpg/330px-William_Ruto_2023_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:William_Ruto_2023_(cropped).jpg","author":"Presidenza della Repubblica","license":"Attribution"},"Jomo Kenyatta (cropped) in June 15th, 1966.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Jomo_Kenyatta_%28cropped%29_in_June_15th%2C_1966.jpg/330px-Jomo_Kenyatta_%28cropped%29_in_June_15th%2C_1966.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Jomo_Kenyatta_(cropped)_in_June_15th,_1966.jpg","author":"Pridan Moshe","license":"Public domain"},"Daniel arap Moi 1979b.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/Daniel_arap_Moi_1979b.jpg/330px-Daniel_arap_Moi_1979b.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Daniel_arap_Moi_1979b.jpg","author":"Croes, Rob C. / Anefo","license":"CC BY-SA 3.0 nl"},"PMO IMG 5262 (40547346173) (cropped).jpg":{"url":"h