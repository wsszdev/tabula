on":51.80605224093554,"min_lat":16.65376814456348,"max_lon":59.837283167449215,"max_lat":26.23611982913379,"source_file":"world_2010.geojson","source_row":null}],"identities":[{"qid":"Q157734","from_t":1945,"to_t":1970,"method":"name-alias+date","confidence":0.7987176184185558,"label":"Muscat and Oman","description":"monarchy on the Arab Peninsula between 1820-1970","inception":1820,"dissolved":1970,"enwiki":"Muscat and Oman","summary":"Muscat and Oman (Arabic: مسقط و عُمان), officially known as the Sultanate of Muscat and Oman (Arabic: سلطنة مسقط وعُمان, romanized: Salṭanat Masqaṭ wa-‘Umān), also known briefly as the State of Muscat and Oman (Arabic: دولة مسقط وعُمان, romanized: Dawlat Masqaṭ wa-‘Umān) during the rule of Taimur bin Faisal, was a state that was under de facto British protection which existed in the second half of the 19th century and 20th century. It encompassed the present-day Sultanate of Oman and parts of present-day United Arab Emirates and Pakistan.\nIn 1856, upon the death of the last ruler of the Omani Empire, Said bin Sultan, the empire split into two separate political entities: the Sultanate of Muscat and Oman and the Sultanate of Zanzibar. The former continued to be led by the Al Busaid dynasty, but transitioned into a new form of government after the palace coup of 23 July 1970 in which the sultan Said bin Taimur was overthrown by the British and his son, Qaboos bin Said, who established the modern-day Sultanate of Oman."},{"qid":"Q842","from_t":1970,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Oman","description":"sovereign state in western Asia","inception":1970.5561643835617,"dissolved":null,"enwiki":"Oman","summary":"Oman, officially the Sultanate of Oman, is a country in the southeastern Arabian Peninsula in West Asia. It shares land borders with Saudi Arabia, the United Arab Emirates, and Yemen, and maritime borders with Iran and Pakistan. Its coastline extends along the Arabian Sea to the southeast and the Gulf of Oman to the northeast. The exclaves of Madha and Musandam are surrounded by the United Arab Emirates on their land borders, while Musandam's coastal boundaries are formed by the Strait of Hormuz and the Gulf of Oman."}],"facts":[{"qid":"Q157734","kind":"capital","value_qid":"Q3826","value_label":"Muscat","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Muscat"},{"qid":"Q157734","kind":"language","value_qid":"Q1686766","value_label":"Yemeni Arabic","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Yemeni Arabic"},{"qid":"Q157734","kind":"government","value_qid":"Q184558","value_label":"absolute monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"absolute monarchy"},{"qid":"Q157734","kind":"predecessor","value_qid":"Q16881283","value_label":"Sultanate of Muscat","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Sultanate of Muscat"},{"qid":"Q157734","kind":"successor","value_qid":"Q157904","value_label":"Sultanate of Zanzibar","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Sultanate of Zanzibar"},{"qid":"Q157734","kind":"flag","value_qid":null,"value_label":"Flag of Muscat.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q157734","kind":"coat","value_qid":null,"value_label":"National emblem of Oman.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q842","kind":"ruler","value_qid":"Q12250314","value_label":"Haitham bin Tarik Al Said","from_t":2020.0273224043715,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Haitham bin Tarik Al Said"},{"qid":"Q842","kind":"capital","value_qid":"Q3826","value_label":"Muscat","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Muscat"},{"qid":"Q842","ki