01084005,"label":"Sint Maarten","description":"country on the Caribbean island of Saint Martin, part of the Kingdom of the Netherlands","inception":2010,"dissolved":null,"enwiki":"Sint Maarten","summary":"Sint Maarten, officially the Country of Sint Maarten, is a constituent country of the Kingdom of the Netherlands located in the Caribbean region of North America. With a population of 58,477 as of June 2023 on an area of 34 km2 (13 sq mi), it encompasses the southern 44% of the divided island of Saint Martin, while the northern 56% of the island constitutes the French overseas collectivity of Saint Martin. Sint Maarten's capital is Philipsburg. Collectively, Sint Maarten and the other Dutch islands in the Caribbean are often called the Dutch Caribbean."}],"facts":[{"qid":"Q26273","kind":"ruler","value_qid":"Q154952","value_label":"William Alexander of the Netherlands","from_t":null,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"William Alexander of the Netherlands"},{"qid":"Q26273","kind":"ruler","value_qid":"Q2298739","value_label":"Eugene Holiday","from_t":null,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Eugene Holiday"},{"qid":"Q26273","kind":"ruler","value_qid":"Q47262798","value_label":"Leona Marlin-Romeo","from_t":2018.0383561643835,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Leona Marlin-Romeo"},{"qid":"Q26273","kind":"capital","value_qid":"Q30958","value_label":"Philipsburg","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Philipsburg"},{"qid":"Q26273","kind":"official_language","value_qid":"Q7411","value_label":"Dutch","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Dutch"},{"qid":"Q26273","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"English"},{"qid":