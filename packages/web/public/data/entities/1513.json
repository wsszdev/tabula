{"entity":{"id":"hb:kazakhstan@1994","name":"Kazakhstan","dataset":"basemaps","kind":"polity"},"territories":[{"id":9570,"name":"Kazakhstan","set_id":"hb_1994","class":"republic","valid_from":1994,"valid_to":2000,"snapshot_held":1,"area_km2":2708757.3539832225,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Kazakhstan","min_lon":46.56804946383593,"min_lat":40.644507966951174,"max_lon":87.39988234957812,"max_lat":55.42887457461719,"source_file":"world_1994.geojson","source_row":null},{"id":9762,"name":"Kazakhstan","set_id":"hb_2000","class":"republic","valid_from":2000,"valid_to":2010,"snapshot_held":1,"area_km2":2708757.3539832225,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Kazakhstan","min_lon":46.56804946383593,"min_lat":40.644507966951174,"max_lon":87.39988234957812,"max_lat":55.42887457461719,"source_file":"world_2000.geojson","source_row":null},{"id":9955,"name":"Kazakhstan","set_id":"hb_2010","class":"republic","valid_from":2010,"valid_to":2020,"snapshot_held":1,"area_km2":2708757.3539832225,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Kazakhstan","min_lon":46.56804946383593,"min_lat":40.644507966951174,"max_lon":87.39988234957812,"max_lat":55.42887457461719,"source_file":"world_2010.geojson","source_row":null}],"identities":[{"qid":"Q232","from_t":1994,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Kazakhstan","description":"sovereign state in Eastern Europe and Central Asia","inception":1991,"dissolved":null,"enwiki":"Kazakhstan","summary":"Kazakhstan, officially the Republic of Kazakhstan, is a landlocked country situated primarily in Central Asia, with a portion of its territory extending into Eastern Europe. It borders Russia to the north and west, China to the east, Kyrgyzstan to the southeast, Uzbekistan to the south, and Turkmenistan to the southwest, and it has a coastline along the Casp