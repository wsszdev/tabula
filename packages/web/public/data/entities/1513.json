_label":"presidential system","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"presidential system"},{"qid":"Q232","kind":"predecessor","value_qid":"Q168811","value_label":"Kazakh Soviet Socialist Republic","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Kazakh Soviet Socialist Republic"},{"qid":"Q232","kind":"predecessor","value_qid":"Q15180","value_label":"Soviet Union","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Soviet Union"},{"qid":"Q232","kind":"flag","value_qid":null,"value_label":"Flag of Kazakhstan.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q232","kind":"coat","value_qid":null,"value_label":"Emblem of Kazakhstan latin.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q232","kind":"ruler","value_qid":"Q57394","value_label":"Nursultan Nazarbayev","from_t":1991.9561643835616,"to_t":2019.213698630137,"title":"President of Kazakhstan","property":"P39","retrieved":"2026-10-30","vl":"Nursultan Nazarbayev"},{"qid":"Q232","kind":"flag","value_qid":"Q131650","value_label":"Flag of Kazakhstan.svg","from_t":1992.4234972677596,"to_t":null,"title":"flag of Kazakhstan","property":"P163","retrieved":"2026-10-30","vl":"flag of Kazakhstan"}],"people":{"Q200881":{"label":"Kassym-Jomart Tokayev","description":"President of Kazakhstan since 2019","enwiki":"Kassym-Jomart Tokayev","summary":"Kassym-Jomart Kemeluly Tokayev (born 17 May 1953) is a Kazakh politician and diplomat who has served as the second president of Kazakhstan since 2019. He previously served as Prime Minister from 1999 to 2002 and as Chairman of the Senate from 2007 to 2011 and again from 2013 to 2019. Tokayev also held the position of Director-General of the United Nations Office at Geneva from 2011 to 2013.\nBorn in Alma-Ata (now Almaty), Tokayev studied at the Moscow State Institute of International Relations and later trained at diplomatic institutions in China.","image":"2025 Tokayev Address to the Nation (cropped).jpg","birth":1953.372602739726,"death":null},"Q124436646":{"label":"Olzhas Bektenov","description":"Prime Minister of the Republic of Kazakhstan (born 1980)","enwiki":"Oljas Bektenov","summary":"Oljas Abaiūly Bektenov (Kazakh: Олжас Абайұлы Бектенов [woɫʒɑ́s ɑbɑ́jʊɫə́ bʲektʰʲénəf] ; born 13 December 1980) is a Kazakh politician who has served as the prime minister of Kazakhstan since February 2024.\nPrior to his premiership, Bektenov held a number of senior positions. He served as deputy chairman of the Agency for Civil Service Affairs and Anti-Corruption from 2018, and was later appointed chairman of the Anti-Corruption Agency, a post he held from 2021 to 2023. He subsequently served as head of the Administration of the President.","image":"Olzhas Bektenov (cropped).jpg","birth":1980.948087431694,"death":null},"Q57394":{"label":"Nursultan Nazarbayev","description":"President of Kazakhstan from 1991 to 2019","enwiki":"Nursultan Nazarbayev","summary":"Nursultan Abishuly Nazarbayev (born 6 July 1940) is a Kazakh politician who served as the first president of Kazakhstan from 1991 to 2019. He also held the special title of Elbasy from 2010 to 2022 and chairman of the Security Council from 1991 to 2022.\nNazarbayev's political career began in the Soviet era, where he joined the Communist Party of the Soviet Union in 1962 while working as a steel factory worker. Rising through the party ranks, he became Prime Minister of the Kazakh SSR in 1984 and First Secretary of the Communist Party of Kazakhstan in 1989.","image":"Nursultan Nazarbayev (2020-03-10) (cropped).jpg","birth":1940.5109289617487,"death":null}},"media":{"Flag of Kazakhstan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/Flag_of_Kazakhstan.svg/330px-Flag_of_Kazakhstan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_conte