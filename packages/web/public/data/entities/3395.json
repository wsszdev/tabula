o_t":1896.6530054644809,"title":"Sultan of Zanzibar","property":"P39","retrieved":"2026-10-30","vl":"Khalid bin Barghash Al Busaidi"},{"qid":"Q157904","kind":"ruler","value_qid":"Q561747","value_label":"Hamad bin Thuwaini Al Busaidi","from_t":1893.172602739726,"to_t":1896.6475409836066,"title":"Sultan of Zanzibar","property":"P39","retrieved":"2026-10-30","vl":"Hamad bin Thuwaini Al Busaidi"},{"qid":"Q157904","kind":"ruler","value_qid":"Q703018","value_label":"Barghash bin Said Al Busaidi","from_t":1870.7643835616439,"to_t":1888.2322404371585,"title":"Sultan of Zanzibar","property":"P39","retrieved":"2026-10-30","vl":"Barghash bin Said Al Busaidi"},{"qid":"Q157904","kind":"ruler","value_qid":"Q705143","value_label":"Majid bin Said Al Busaidi","from_t":1856.7978142076502,"to_t":1870.7643835616439,"title":"Sultan of Zanzibar","property":"P39","retrieved":"2026-10-30","vl":"Majid bin Said Al Busaidi"},{"qid":"Q157904","kind":"ruler","value_qid":"Q924354","value_label":"Khalifah bin Said Al Busaidi","from_t":1888.2322404371585,"to_t":1890.1178082191782,"title":"Sultan of Zanzibar","property":"P39","retrieved":"2026-10-30","vl":"Khalifah bin Said Al Busaidi"},{"qid":"Q157904","kind":"ruler","value_qid":"Q982863","value_label":"Khalifa bin Harub Al Busaidi","from_t":1911.9369863013699,"to_t":1960.7704918032787,"title":"Sultan of Zanzibar","property":"P39","retrieved":"2026-10-30","vl":"Khalifa bin Harub Al Busaidi"},{"qid":"Q157904","kind":"flag","value_qid":"Q1135849","value_label":"Flag of Zanzibar.svg","from_t":2005.021917808219,"to_t":null,"title":"flag of Zanzibar","property":"P163","retrieved":"2026-10-30","vl":"flag of Zanzibar"}],"people":{"Q2029666":{"label":"Jamshid bin Abdullah Al Busaidi","description":"Sultan of Zanzibar (1929–2024)","enwiki":"Jamshid bin Abdullah","summary":"Jamshid bin Abdullah Al Busaidi,  (Arabic: جمشيد بن عبد الله البوسعيدي; 16 September 1929 – 30 December 2024) was a Zanzibari royal who was the last reigning Sultan of Zanzibar. He was deposed in the Zanzibar Revolution, after the United Kingdom gave up its protectorate.","image":"Jamshid bin Abdullah of Zanzibar.jpg","birth":1929.7068493150684,"death":2024.9945355191257},"Q2703838":{"label":"Abdullah bin Khalifa Al Busaidi","description":"Sultan of Zanzibar (1910–1963)","enwiki":"Abdullah bin Khalifa","summary":"Sir Abdullah bin Khalifa Al-Busaidi,  ,   (13 February 1911 – 1 July 1963) (Arabic: عبد الله بن خليفة), was the 10th Sultan of Zanzibar after the death of his father, Sir Khalifa bin Harub, who died on 9 October 1960 at age eighty-one. He was less popular than his father and had a rough reign as Sultan during a period of rising African nationalism. In addition, by the time of his death, both his legs had been amputated due to disease.\nHe ruled Zanzibar from 9 October 1960 to 1 July 1963.","image":"Sultan of Zanzibar abdullah ibn chalifa 1960-1963.jpg","birth":1910.1150684931506,"death":1963.495890410959},"Q423630":{"label":"Ali bin Hamud Al Busaidi","description":"Sultan of Zanzibar (1884-1918)","enwiki":"Ali bin Hamud of Zanzibar","summary":"Sayyid Ali bin Hamud al-Busaidi (7 June 1884 – 20 December 1918; Arabic: علي بن حمود البوسعيد), also known as Ali II, was the eighth Sultan of Zanzibar from 1902 to 1911.","image":"Ali bin Hamud 6.jpg","birth":1884.431693989071,"death":1918.9671232876713},"Q423643":{"label":"Ali bin Said Al Busaidi","description":"Sultan of Zanzibar (1890-1893)","enwiki":"Ali bin Said of Zanzibar","summary":"Sayyid Ali bin Said al-Busaidi, GCSI,  (c. 1854 – March 5, 1893) (Arabic: علي بن سعيد البوسعيد) was the fourth Sultan of Zanzibar. He ruled Zanzibar from February 13, 1890, to March 5, 1893. In June 1890 he was forced to accept a British protectorate over his dominions.","image":"Sultan Ali bin Said.jpg","birth":1854,"death":1893.172602739726},"Q470598":{"label":"Khalid bin Barghash Al Busaidi","description":"Sultan of Zanzibar (1874-1927)","enwiki":"Khalid bin Barghash of Zanzibar","summary":"Sayyid Khalid bin Barghash Al-Busa'id (Arabic: خالد بن برغش البوسعيد;‎ 1874 – 19 March 1927) was the sixth Sultan of Zanzibar. The last sovereign Sultan of Zanzibar, he reigned for roughly three days, after which he was deposed by the United Kingdom in the 38-minute Anglo-Zanzibar War.","image":"Bundesarchiv Bild 105-DOA0295, Deutsch-Ostafrika, Sultan.jpg","birth":1874.9534246575342,"death":1927},"Q561747":{"label":"Hamad bin Thuwaini Al Busaidi","description":"Sultan of Zanzibar (1857–1896)","enwiki":"Hamad bin Thuwaini of Zanzibar","summary":"Sayyid Hamad bin Thuwaini Al-Busaidi (Arabic: حمد بن ثويني البوسعيدي; c. 1857 – (1896-08-25)25 August 1896) was the fifth Sultan of Zanzibar. He ruled Zanzibar from 5 March 1893 to 25 August 1896.","image":"Hamad bin Thwiny.jpg","birth":1857,"death":1896.6475409836066},"Q703018":{"label":"Barghash bin Said Al Busaidi","description":"Sultan of Zanzibar (1837–1888)","enwiki":"Barghash bin Said of Zanzibar","summary":"Sayyid Barghash bin Said al-Busaidi (c. 1836 – 26 March 1888) (Arabic: برغش بن سعيد البوسعيدي), an Afro-Omani Sultan and the son of Said bin Sultan, was the second Sultan of Zanzibar. He ruled Zanzibar from 7 October 1870 to 26 March 1888.","image":"Barghash.jpg","birth":1837,"death":1888.2322404371585},"Q705143":{"label":"Majid bin Said Al Busaidi","description":"Sultan of Zanzibar (1834-1870)","enwiki":"Majid bin Said","summary":"Sayyid Majid bin Saïd al-Busaidi (Arabic: ماجد بن سعيد البوسعيد) (c. 1834 – (1870-10-07)7 October 1870) was the first Sultan of Zanzibar. He ruled Zanzibar from 19 October 1856 to 7 October 1870. \nHe succeeded his father Said bin Sultan as ruler of Zanzibar and East Africa, and briefly (claimed) Oman following Said’s death. During his reign his brother Bargash would prove constantly rebellious and adhered to his rule, nonetheless, Majid remained in power until his untimely death which was due to ‘over indulgence in sensual pleasures and stimulants’.","image":"Majid Bin Saiid2.jpg","birth":1834,"death":1870.7643835616439},"Q924354":{"label":"Khalifah bin Said Al Busaidi","description":"Sultan of Zanzibar (1852–1890)","enwiki":"Khalifah bin Said","summary":"Sayyid Khalifa I bin Said al-Busaidi, GCMG,  (or Chalîfe) (c. 1852 – 13 February 1890) (Arabic: خليفة بن سعيد البوسعيد) was the third Sultan of Zanzibar. He ruled Zanzibar from 26 March 1888 to 13 February 1890 and was succeeded by his brother, Ali bin Said.","image":"Seyid Chalifa ben Said.jpg","birth":1852,"death":1890.1178082191782},"Q982863":{"label":"Khalifa bin Harub Al Busaidi","description":"Sultan of Zanzibar (1879-1960)","enwiki":"Khalifa bin Harub","summary":"Sir Khalifa II bin Harub Al-Busaidi (26 August 1879 – 9 October 1960) (Arabic: السيد خليفة بن حارب البوسعيدي) was the 9th Sultan of Zanzibar from 9 December 1911 until his death on 9 October 1960.\nHis reign was around 48 years and 10 months long, making him the longest-reigning Sultan of Zanzibar in history.","image":"Khalifa bin Hareb (cropped).jpg","birth":1879.6493150684933,"death":1960.7704918032787}},"media":{"Flag of the Sultanate of Zanzibar (1963).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c4/Flag_of_the_Sultanate_of_Zanzibar_%281963%29.svg/330px-Flag_of_the_Sultanate_of_Zanzibar_%281963%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Sultanate_of_Zanzibar_(1963).svg","author":"Orange Tuesday","license":"CC BY-SA 3.0"},"Emblem of the Sultanate of Zanzibar.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Emblem_of_the_Sultanate_of_Zanzibar.svg/330px-Emblem_of_the_Sultanate_of_Zanzibar.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_the_Sultanate_of_Zanzibar.svg","author":"Samhanin","license":"CC BY-SA 4.0"},"Flag of Zanzibar.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Flag_of_