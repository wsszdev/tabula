.6328767123289,"to_t":1960.811475409836,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Ali bin Abdullah Al Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q2827460","value_label":"Ahmad bin Ali Al Thani","from_t":1960.811475409836,"to_t":1972.1420765027322,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Ahmad bin Ali Al Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q3493526","value_label":"Muhammad ibn Thani","from_t":1851,"to_t":1878.9616438356165,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Muhammad ibn Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q4116065","value_label":"Abdullah bin Jassim Al Thani","from_t":1914.5397260273974,"to_t":1949.6328767123289,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Abdullah bin Jassim Al Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q4116076","value_label":"Jassim bin Mohammed bin Thani","from_t":1878.9616438356165,"to_t":1913.5397260273974,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Jassim bin Mohammed bin Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q6893454","value_label":"Mohammed bin Jassim Al Thani","from_t":1913,"to_t":1914,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Mohammed bin Jassim Al Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q20638748","value_label":"Ahmed bin Muhammed Al Thani","from_t":1898,"to_t":1905,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Ahmed bin Muhammed Al Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q2072385","value_label":"Khalifa bin Hamad Al Thani","from_t":1972.1420765027322,"to_t":1995.4849315068493,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Khalifa bin Hamad Al Thani"},{"qid":"Q846","kind":"ruler","value_qid":"Q57360","value_label":"Hamad bin Khalifa Al Thani","from_t":1995.4849315068493,"to_t":2013.4794520547946,"title":"Emir of the State of Qatar","property":"P39","retrieved":"2026-10-30","vl":"Hamad bin Khalifa Al Thani"},{"qid":"Q846","kind":"flag","value_qid":"Q172530","value_label":"Flag of Qatar.svg","from_t":1971.517808219178,"to_t":null,"title":"flag of Qatar","property":"P163","retrieved":"2026-10-30","vl":"flag of Qatar"}],"people":{"Q1855372":{"label":"Tamim bin Hamad Al Thani","description":"Emir of Qatar since 2013","enwiki":"Tamim bin Hamad Al Thani","summary":"Tamim bin Hamad bin Khalifa Al Thani (Arabic: تؘمؚيم بؚن حؘمؘد بؚن خَلِيفَة آل ثَانِي, romanized: Tamīm bin Ḥamad bin Khalīfa Āl Thānī; born 3 June 1980) is the Emir of Qatar, reigning since 25 June 2013. He became the heir apparent in 2003 after his elder brother Sheikh Jassim renounced his claim. He is the fourth son of the former emir, Hamad bin Khalifa Al Thani. After his father abdicated in 2013, Tamim became one of the world's youngest monarchs.","image":"Tamim bin Hamad Al Thani Moscow 2026.jpg","birth":1980.2295081967213,"death":null},"Q23020336":{"label":"Mohammed bin Abdulrahman Al Thani","description":"Prime Minister and the Minister of Foreign Affairs of Qatar","enwiki":"Mohammed bin Abdulrahman bin Jassim Al Thani","summary":"Mohammed bin Abdulrahman Al Thani (Arabic: : محمد بن عبد الرحمن آل ثاني; : محمد بن عبد الرحمن آل ثاني; born 1 November 1980) is a Qatari diplomat, economist, and politician who has been the Prime Minister of Qatar since March 2023 and its Minister of Foreign Affairs since 2016. Additionally, he is the Chairman of the Qatar Fund for Development (QFFD) and is a member of Qatar's Supreme Council for Economic Affairs and Investments. He previously held the positions of Chairman of the Qatar Investment Authority from 2018 to 2023 and deputy prime minister from 2017 to 2023.","image":"Mohammed bin Abdulrahman Al-Thani of Qatar on 25 January 2024 - 2 (cropped).jpg","birth":1980.8333333333333,"death":null},"Q2470332":{"label":"Ali bin Abdullah Al Thani","description":"Qatari politician (1892–1974)","enwiki":"Ali bin Abdullah Al Thani","summary":"Ali bin Abdullah bin Jassim bin Mohammed Al Thani  (Arabic: علي بن عبد الله بن جاسم بن محمد آل ثاني; 5 June 1895 – 31 August 1974) was the Emir of Qatar. Sheikh Ali was also the first Emir of Qatar to have traveled abroad, visiting India, Egypt, Europe, Lebanon and the Levant.","image":null,"birth":1892.4262295081967,"death":1974.66301369863},"Q2827460":{"label":"Ahmad bin Ali Al Thani","description":"Emir of Qatar","enwiki":"Ahmad bin Ali Al Thani","summary":"Ahmad bin Ali bin Abdullah bin Jassim bin Mohammed Al Thani (Arabic: أحمد بن علي بن عبد الله بن جاسم بن محمد آل ثاني; 1922 – 25 November 1977) was the Emir of Qatar who ruled from 1960 to 1972. Qatar's financial status improved significantly during his reign as a result of the enrichment and discovery of several new oil fields. Qatar also became a sovereign state in September 1971 under his rule. He was deposed in February 1972 by his cousin, Khalifa bin Hamad Al Thani.","image":"Ahmad bin Ali Al Thani (1972) (cropped).jpg","birth":1920,"death":1977.8986301369864},"Q3493526":{"label":"Muhammad ibn Thani","description":"1st emir of the whole Qatari Peninsula","enwiki":"Mohammed bin Thani","summary":"Mohammed bin Thani (Arabic: محمد بن ثاني; c. 1788 – 18 December 1878), also known as Mohammed bin Thani bin Mohammed Al Thamir (Arabic: محمد بن ثاني بن محمد آل ثامر), was the first ruler from the House of Thani  to rule the whole Qatari Peninsula, officially being recognized by the British in September 1868 following a meeting with British representative Lewis Pelly. He is known for being the father of Sheikh Jassim bin Mohammed Al Thani, the founder of Qatar and who fended off the Ottoman army in the late 19th century.","image":null,"birth":1788,"death":1878.9616438356165},"Q4116065":{"label":"Abdullah bin Jassim Al Thani","description":"Ruler of Qatar (1880–1957)","enwiki":"Abdullah bin Jassim Al Thani","summary":"Abdullah bin Jassim bin Mohammed Al Thani (Arabic: عبد الله بن جاسم بن محمد آل ثاني; 11 February 1880 – 25 April 1957), also known as Sheikh Abdullah bin Jassim Al Thani or Sheikh Abdullah bin Qassim Al Thani, was the Emir of Qatar from 1913 to 1949.\nOil was discovered in Qatar for the first time during his rule.","image":"Sheikh Abdullah Bin Jassim Al Thani.jpg","birth":1880,"death":1957.3123287671233},"Q4116076":{"label":"Jassim bin Mohammed bin Thani","description":"Founder of the modern Qatar (1825–1913)","enwiki":"Jassim bin Mohammed Al Thani","summary":"Jassim bin Mohammed Al Thani (Arabic: جاسم بن محمد آل ثاني; also known as \"The Founder\"; c. 1825 – 17 July 1913), was the founder of the State of Qatar.","image":"Jassim bin Muhammad Al Thani.jpg","birth":1825,"death":1913.5397260273974},"Q6893454":{"label":"Mohammed bin Jassim Al Thani","description":"Member of Royal family and mayor of Umm Salal Muhammed and Doha city","enwiki":"Mohammed bin Jassim Al Thani","summary":"Mohammed bin Jassim bin Mohammed Al Thani (Arabic: الشيخ محمد بن جاسم بن محمد آل ثاني; 17 January 1881 – 8 April 1971) was the son of Sheikh Jassim bin Mohammed Al Thani. Sheikh Mohammed had a total of 18 siblings, with him being the seventh of his father's sons.","image":null,"birth":1881.0438356164384,"death":1971.2657534246575},"Q20638748":{"label":"Ahmed bin Muhammed Al Thani","description":"politician","enwiki":"Ahmed bin Mohammed Al Thani","summary":"Ahmed bin Mohammed Al Thani (Arabic: أحمد بن محمد آل ثاني; 1853– December 1905), was the second son of Mohammed bin Thani, the Governor of Doha (1894–1898), Emir of Qatar (1898–1905) and head of the Ahmed bin Muhammed Al Thani branch of the House of Thani, the ruling family of Qatar. He was also the younger brother of the founder of the State of Qatar, Jassim bin Mohammed Al Thani.","image":null,"birth":1853,"death":1905},"Q2072385":{"label":"Khalifa bin Hamad Al Thani","description":"former Emir of Qatar (1932–2016)","enwiki":"Khalifa bin Hamad Al Thani","summary":"Khalifa bin Hamad Al Thani  (Arabic: خليفة بن حمد آل ثاني; 17 September 1932 – 23 October 2016) was the Emir of Qatar from 22 February 1972 until he was deposed by his son Hamad bin Khalifa in a coup on 27 June 1995.\nHe died during the reign of his grandson, the current emir, Tamim bin Hamad Al Thani.","image":"Khalifa bin Hamad Al Thani (1972) (cropped).jpg","birth":1932.7103825136612,"death":2016.808743169399},"Q57360":{"label":"Hamad bin Khalifa Al Thani","description":"Emir of Qatar from 1995 to 2013","enwiki":"Hamad bin Khalifa Al Thani","summary":"Hamad bin Khalifa Al Thani (Arabic: حمد بن خليفة آل ثاني; 1 January 1952 – 12 July 2026) was Emir of Qatar from 1995 until his abdication in 2013. He was also prime minister of Qatar from 1995 to 1996.\nHamad received his education in Qatar before attending the United Kingdom's Royal Military Academy Sandhurst. After graduating in 1971, he held several senior posts in the Qatar Armed Forces, including as chief of staff and minister of defense.","image":"Hamad bin Khalifa Al-Thani 1997 (cropped).jpg","birth":1952,"death":2026.5260273972603}},"media":{"Flag of Qatar.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/65/Flag_of_Qatar.svg/330px-Flag_of_Qatar.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Qatar.svg","author":"See File history below for details.","license":"Public domain"},"Emblem of Qatar-2022.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Emblem_of_Qatar-2022.svg/330px-Emblem_of_Qatar-2022.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Qatar-2022.svg","author":"9BBWMJ","license":"CC BY-SA 4.0"},"Tamim bin Hamad Al Thani Moscow 2026.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/91/Tamim_bin_Hamad_Al_Thani_Moscow_2026.jpg/330px-Tamim_bin_Hamad_Al_Thani_Moscow_2026.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Tamim_bin_Hamad_Al_Thani_Moscow_2026.jpg","author":"Autor: Sergey Bobylev/RIA Novosti","license":"CC BY-SA 3.0"},"Mohammed bin Abdulrahman Al-Thani of Qatar on 25 January 2024 - 2 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/97/Mohammed_bin_Abdulrahman_Al-Thani_of_Qatar_on_25_January_2024_-_2_%28cropped%29.jpg/330px-Mohammed_bin_Abdulrahman_Al-Thani_of_Qatar_on_25_January_2024_-_2_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Mohammed_bin_Abdulrahman_Al-Thani_of_Qatar_on_25_January_2024_-_2_(cropped).jpg","author":"UK Government","license":"CC BY 2.0"},"Ahmad bin Ali Al Thani (1972) (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c0/Ahmad_bin_Ali_Al_Thani_%281972%29_%28cropped%29.jpg/330px-Ahmad_bin_Ali_Al_Thani_%281972%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ahmad_bin_Ali_Al_Thani_(1972)_(cropped).jpg","author":"Associated Press","license":"Public domain"},"Sheikh Abdullah Bin Jassim Al Thani.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/84/Sheikh_Abdullah_Bin_Jassim_Al_Thani.jpg/330px-Sheikh_Abdullah_Bin_Jassim_Al_Thani.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Sheikh_Abdullah_Bin_Jassim_Al_Thani.jpg","author":"Unknown Author","license":"Public domain"},"Jassim bin Muhammad Al Thani.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/1/1d/Jassim_bin_Muhammad_Al_Thani.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Jassim_bin_Muhammad_Al_Thani.jpg","author":"House of Thani","license":"CC BY-SA 4.0"},"Khalifa bin Hamad Al Thani (1972) (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Khalifa_bin_Hamad_Al_Thani_%281972%29_%28cropped%29.jpg/330px-Khalifa_bin_Hamad_Al_Thani_%281972%29_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Khalifa_bin_Hamad_Al_Thani_(1972)_(cropped).jpg","author":"Associated Press","license":"Public domain"},"Hamad bin Khalifa Al-Thani 1997 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/51/Hamad_bin_Khalifa_Al-Thani_1997_%28cropped%29.jpg/330px-Hamad_bin_Khalifa_Al-Thani_1997_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Hamad_bin_Khalifa_Al-Thani_1997_(cropped).jpg","author":null,"license":"Public domain"}},"names":["Catar","Catura","Estado de Catar","Estado de Qatar","Estado do Catar","Katar","Qa.","Qatar","Quataria","Staat Katar","Staat Qatar","State of Qatar","catarí","l’État du Qatar","qa","qat","qatarí","status Qatarensis","Κατάρ","Государство Катар","Катар","إمارة قطر","قطر","क़तर","カタール","カタール国","卡国","卡塔尔","卡塔尔国","卡塔爾","卡達","🇶🇦"]}