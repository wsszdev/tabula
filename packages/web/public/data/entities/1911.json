_km2":149376.69051120308,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Madagascar (Malagasy)","min_lon":45.2922873383644,"min_lat":-23.592115909917876,"max_lon":48.488183848332966,"max_lat":-16.904406546465143,"source_file":"world_1783.geojson","source_row":null},{"id":7235,"name":"Merina Kingdom","set_id":"hb_1800","class":"kingdom","valid_from":1800,"valid_to":1815,"snapshot_held":1,"area_km2":149376.69051120308,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Madagascar (Malagasy)","min_lon":45.2922873383644,"min_lat":-23.592115909917876,"max_lon":48.488183848332966,"max_lat":-16.904406546465143,"source_file":"world_1800.geojson","source_row":null},{"id":7825,"name":"Merina Kingdom","set_id":"hb_1815","class":"kingdom","valid_from":1815,"valid_to":1878,"snapshot_held":1,"area_km2":116989.04513185078,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Madagascar (Malagasy)","min_lon":44.9445856347336,"min_lat":-23.266607932050636,"max_lon":48.90986463784273,"max_lat":-16.904406546465143,"source_file":"world_1815.geojson","source_row":null}],"identities":[{"qid":"Q1071439","from_t":1540,"to_t":1878,"method":"name-label+date","confidence":0.95,"label":"Merina Kingdom","description":"former country","inception":1540,"dissolved":1897,"enwiki":"Imerina","summary":"The Kingdom of Imerina (Malagasy: Fanjakan'Imerina; c. 1540–1897), also known as the Kingdom of Madagascar or the Kingdom of Merina, was a pre-colonial state off the coast of Southeast Africa that, by the 18th century, dominated most of what is now Madagascar. It spread outward from Imerina, the Central Highlands region primarily inhabited by the Merina ethnic group with a spiritual capital at Ambohimanga and a political capital 24 km (15 mi) west at Antananarivo, currently the seat of government for the modern state of Madagascar. The Merina kings and queens who ruled over greater Madagascar in the 19th century were the descendants of a long line of hereditary Merina royalty originating with Andriamanelo, who is traditionally credited with founding Imerina in 1540.\nIn 1883, France invaded the Merina Kingdom to establish a protectorate."}],"facts":[{"qid":"Q1071439","kind":"capital","value_qid":"Q3915","value_label":"Antananarivo","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Antananarivo"},{"qid":"Q1071439","kind":"language","value_qid":"Q7930","value_label":"Malagasy","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Malagasy"},{"qid":"Q1071439","kind":"predecessor","value_qid":"Q557842","value_label":"Boina Kingdom","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Boina Kingdom"},{"qid":"Q1071439","kind":"successor","value_qid":"Q5501842","value_label":"French Madagascar","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"French Madagascar"},{"qid":"Q1071439","kind":"flag","value_qid":null,"value_label":"Flag of the Merina Kingdom.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q1071439","kind":"coat","value_qid":null,"value_label":"Coat of arms of the Merina Kingdom.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q1071439","kind":"ruler","value_qid":"Q169794","value_label":"Ranavalona I","from_t":1828.6092896174864,"to_t":1861.6219178082192,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"Ranavalona I"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q218622","value_label":"King Andrianampoinimerina","from_t":1787,"to_t":1810,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"King Andrianampoinimerina"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q233326","value_label":"Ranavalona III","from_t":1883.5753424657535,"to_t":1897.158904109589,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"Ranavalona III"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q240168","value_label":"Ranavalona II","from_t":1868.2513661202186,"to_t":1883.5287671232877,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"Ranavalona II"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q525141","value_label":"Radama I the Great","from_t":1810,"to_t":1828.568306010929,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"Radama I the Great"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q4759293","value_label":"King Andrianjafy","from_t":1770,"to_t":1787,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"King Andrianjafy"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q4759281","value_label":"King Andriambelomasina of Avaradrano","from_t":1730,"to_t":1770,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"King Andriambelomasina of Avaradrano"},{"qid":"Q1071439","kind":"ruler","value_qid":"Q4759300","value_label":"Andriantsimitoviaminiandriana Andriandrazaka","from_t":1710,"to_t":1730,"title":"King of Imerina","property":"P39","retrieved":"2026-10-30","vl":"Andriantsimitoviaminiandriana Andriandrazaka"}],"people":{"Q169794":{"label":"Ranavalona I","description":"queen of Imerina (1828-1861)","enwiki":"Ranavalona I","summary":"Ranavalona I (born Rabodonandrianampoinimerina; 1778 – 16 August 1861), also known as Ramavo or Ranavalo-Manjaka I or Ranavalona reniny, was the sovereign of the Kingdom of Madagascar from 1828 to 1861. After positioning herself as queen following the death of her young husband Radama I, she pursued a policy of isolationism and self-sufficiency. She sought reduced economic and political ties with European powers and took vigorous measures to eradicate the small but growing Malagasy Christian movement initiated under Radama I by members of the London Missionary Society.\nRanavalona used the traditional practice of fanompoana (forced labor as tax payment) to complete public works projects and develop an army.","image":"Ranavalona I.jpg","birth":1788,"death":1861.6219178082192},"Q218622":{"label":"King Andrianampoinimerina","description":"King of Imerina","enwiki":"Andrianampoinimerina","summary":"Andrianampoinimerina (Malagasy pronunciation: [anˈɖʐianˌmpuʲnˈmerʲnə̥]) (c. 1745–1810) ruled the Kingdom of Imerina on Madagascar from 1787 until his death.  His reign was marked by the reunification of Imerina following 77 years of civil war, and the subsequent expansion of his kingdom into neighboring territories, thereby initiating the unification of Madagascar under Merina rule.  Andrianampoinimerina is a cultural hero and holds near mythic status among the Merina people, and is considered one of the greatest military and political leaders in the history of Madagascar.","image":"Andrianampoinimerina HQ.jpg","birth":1745,"death":1810},"Q233326":{"label":"Ranavalona III","description":"last sovereign of the Kingdom of Madagascar (1861-1917)","enwiki":"Ranavalona III","summary":"Ranavalona III (Malagasy pronunciation: [ranaˈvalːə̥]; 22 November 1861 – 23 May 1917) was the last sovereign of the Kingdom of Madagascar. She ruled from 30 July 1883 to 28 February 1897 in a reign marked by ultimately futile efforts to resist the colonial designs of the government of France. As a young woman, she was selected to succeed Queen Ranavalona II. Like both preceding queens, Ranavalona entered a political marriage with a member of the Hova elite named Rainilaiarivony, who largely oversaw the day-to-day governance of the kingdom and managed its foreign affairs in his role as prime minister. Ranavalona tried to stave off colonization by strengthening trade and diplomatic relations with foreign powers throughout her reign, but French attacks on coastal port towns and an assault on the capital city of Antananarivo led to the capture of the royal palace in 1895, ending the sovereignty and political autonomy of the centuries-old kingdom.","image":"Ranavalona.jpg","birth":1861.890410958904,"death":1917.3890410958904},"Q240168":{"label":"Ranavalona II","description":"Queen of Imerina (1868-1883)","enwiki":"Ranavalona II","summary":"Ranavalona II (1829 – 13 July 1883) was Queen of Madagascar from 1868 to 1883, succeeding Queen Rasoherina, her first cousin. She is best remembered for Christianizing the royal court during her reign.","image":"Ranavalona II.jpg","birth":1829,"death":1883.5287671232877},"Q525141":{"label":"Radama I the Great","description":"King of Imerina (1793–1828)","enwiki":"Radama I","summary":"Radama I (c. 1793–1828), also known as Radama the Great, was the first Malagasy sovereign to be recognized as King of Madagascar (1810–1828) by a European state, Great Britain. He came to power at the age of 17 following the death of his father, King Andrianampoinimerina.\nUnder Radama's rule and at his invitation, the first Europeans entered his central highland Kingdom of Imerina and its capital at Antananarivo.","image":"Radama I, portrait by Ramanankirahina.jpg","birth":1793,"death":1828.568306010929},"Q4759293":{"label":"King Andrianjafy","description":"Malagasy monarch","enwiki":"Andrianjafy","summary":"King Andrianjafy (before c. 1770-1787) also known as Andrianjafinandriamanitra and Andrianjafinjanahary, was the king of Imerina Avaradrano, the northern part of the central highlands of Madagascar with its capital at Ambohimanga. His father Andriambelomasina bequeathed him the rule of Avaradrano while designating his nephew Ramboasalama to follow Andrianjafy in the order of succession. Andrianjafy did not accept this decree, instead preferring that his own son succeed him, and sought retribution against citizens of Avaradrano who acknowledged the latent authority of his nephew.\nIn order to prevent Ramboasalama from rising to power, Andrianjafy devised a series of failed plans to kill his nephew.","image":null,"birth":1770,"death":1787},"Q4759281":{"label":"King Andriambelomasina of Avaradrano","description":"King of Avaradrano","enwiki":"Andriambelomasina","summary":"Andriambelomasina (ruled 1730–1770) was a Merina King of Imerina Avaradrano, the northern part of the central highlands of Madagascar. The kingdom's capital was located at Ambohimanga.","image":null,"birth":1750,"death":1770},"Q4759300":{"label":"Andriantsimitoviaminiandriana Andriandrazaka","description":"Malagasy monarch","enwiki":"Andriantsimitoviaminiandriana Andriandrazaka","summary":"Andriantsimitoviaminiandriana Andriandrazaka (also Andriantsimitoviaminandriandrazaka) was King of Avaradrano in the central highlands of Madagascar from 1710 to 1730, and King of neighboring Ambohidrabiby after defeating his brother, Andrianavalonimerina. He was a son of Andriamasinavalona, sovereign of the former Kingdom of Imerina, and his wife Ratompoindraoandriana. Sometime during his life Andriantsimitoviaminiandriana adopted Rakotomavo, who would later succeed him as King Andriambelomasina.\nAs a child, Andriantsimitoviaminiandriana was sent to live in a village that his father named Ambohimanga.","image":null,"birth":1650,"death":1730}},"media":{"Flag of the Merina Kingdom.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Flag_of_the_Merina_Kingdom.svg/330px-Flag_of_the_Merina_Kingdom.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Merina_Kingdom.svg","author":"Samhanin","license":"CC BY 3.0"},"Coat of arms of the Merina Kingdom.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Coat_of_arms_of_the_Merina_Kingdom.svg/330px-Coat_of_arms_of_the_Merina_Kingdom.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_the_Merina_Kingdom.svg","author":"Samhanin","license":"CC BY 3.0"},"Ranavalona I.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/c/c1/Ranavalona_I.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Ranavalona_I.jpg","author":"Philippe-Auguste Ramanankirahina (1860-1915)","license":"Public domain"},"Andrianampoinimerina HQ.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e3/Andrianampoinimerina_HQ.jpg/330px-Andrianampoinimerina_HQ.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Andrianampoinimerina_HQ.jpg","author":"Philippe-Auguste Ramanankirahina (1860-1915)","license":"Public domain"},"Ranavalona.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Ranavalona.jpg/330px-Ranavalona.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ranavalona.jpg","author":"J. Geiser. Algier phot.","license":"Public domain"},"Ranavalona II.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/Ranavalona_II.jpg/330px-Ranavalona_II.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ranavalona_II.jpg","author":"Philippe-Auguste Ramanankirahina (1860-1915)","license":"Public domain"},"Radama I, portrait by Ramanankirahina.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Radama_I%2C_portrait_by_Ramanankirahina.jpg/330px-Radama_I%2C_portrait_by_Ramanankirahina.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Radama_I,_portrait_by_Ramanankirahina.jpg","author":"Philippe-Auguste Ramanankirahina (1860-1915)","license":"Public domain"}},"names":["Imerina","Kingdom of Imerina","Kingdom of Madagascar","Koninkrijk Imerina","Królestwo Merina","Königreich Madagaskar","Königreich Merina","Köni