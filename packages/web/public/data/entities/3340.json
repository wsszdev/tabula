","vl":null},{"qid":"Q805","kind":"coat","value_qid":null,"value_label":"Emblem of Yemen (2).svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q805","kind":"ruler","value_qid":"Q483672","value_label":"Ali Abdullah Saleh","from_t":1990.386301369863,"to_t":2012.155737704918,"title":"حسان حسين محمد السعيدي الجمهورية اليمنية","property":"P39","retrieved":"2026-10-30","vl":"Ali Abdullah Saleh"},{"qid":"Q805","kind":"ruler","value_qid":"Q57480","value_label":"Abdrabbuh Mansour Hadi","from_t":2012.155737704918,"to_t":2022.2630136986302,"title":"حسان حسين محمد السعيدي الجمهورية اليمنية","property":"P39","retrieved":"2026-10-30","vl":"Abdrabbuh Mansour Hadi"},{"qid":"Q805","kind":"flag","value_qid":"Q162699","value_label":"Flag of Yemen.svg","from_t":1990.386301369863,"to_t":null,"title":"flag of Yemen","property":"P163","retrieved":"2026-10-30","vl":"flag of Yemen"}],"people":{"Q163945":{"label":"Yahya Muhammad Hamid ed-Din","description":"Imam (1869–1948)","enwiki":"Yahya Muhammad Hamid ed-Din","summary":"Yahya Muhammad Hamid ed-Din (18 June 1869 – 17 February 1948) (or Imam Yahya) was the first king of the Mutawakkilite Kingdom of Yemen from 1918 until his assassination in 1948. He became Imam of the Zaydis, a branch of Shia Islam, in 1904 after the death of his father, Muhammad Al-Mansur, and Imam of Yemen in 1918. His name and title in full was \"His Majesty Amir al-Mu'mimin al-Mutawakkil 'Ala Allah Rab ul-Alamin Imam Yahya bin al-Mansur Bi'llah Muhammad Hamidaddin, Imam and Commander of the Faithful\" (the Prince of the Believers, He who Relies on God, the Lord of the Universe).\nYahya Muhammad Hamid ed-Din was born on Friday 18 June 1869 in Sanaa into the Hamidaddin branch of the al-Qasimi dynasty who ruled most of Yemen proper and the southern region of present-day Saudi Arabia for over 900 years.","image":"Imam yahya cropped.png","birth":1869.4602739726026,"death":1948.1284153005465},"Q400961":{"label":"Ahmad bin Yahya","description":"Imam (1891-1962)","enwiki":"Ahmad bin Yahya","summary":"Ahmad bin Yahya Hamid al-Din (18 June 1891 – 19 September 1962) was the penultimate king of the Kingdom of Yemen, who reigned from 1948 to 1962. His full name and title was H.M. al-Nasir-li-Dinullah Ahmad bin al-Mutawakkil 'Alallah Yahya, Imam and Commander of the Faithful, and King of the Mutawakkilite Kingdom of the Yemen.\nAhmad's controversial rule led to an attempted coup, assassination attempts, and the downfall of the kingdom shortly after his death. His opponents included ambitious family members, pan-Arabists, and Republicans, who derided him as \"Ahmad the Devil.\" However, he remained popular among his northern subjects from whom he was known as \"Big Turban.'' After escaping several assassination attempts, he was known as al-Djinn.","image":"YemenAhmad.jpg","birth":1891.4602739726026,"death":1962.7123287671234},"Q711230":{"label":"Muhammad al-Badr","description":"King and Imam (1926/1929-1996)","enwiki":"Muhammad al-Badr","summary":"Muhammad al-Badr (15 February 1926 – 6 August 1996) was the last king and Zaydi Imam of the Mutawakkilite Kingdom of Yemen (North Yemen) and leader of the monarchist regions during the North Yemen Civil War (1962–1970). \nHe was Imam and Commander of the Faithful and King of the Mutawakkilite Kingdom of Yemen.","image":"Muhammad al-Badr.jpg","birth":1926.123287671233,"death":1996.5956284153006},"Q12213376":{"label":"Rashad al-Alimi","description":"Chairman of the Presidential Leadership Council of Yemen since 2022","enwiki":"Rashad al-Alimi","summary":"Rashad Muhammad al-Alimi (Arabic: رشاد محمد العليمي, romanized: Rashād Muḥammad al-ʻUlaymī; born 15 January 1954) is a Yemeni politician, and the president of the Presidential Leadership Council since April 2022.","image":"Rashad al-Alimi - 2022.jpg","birth":1954.0383561643835,"death":null},"Q68837007":{"label":"Salem Saleh bin Braik","description":"Yemeni politician","enwiki":"Salem Saleh bin Braik","summary":"Salem Saleh Salem bin Braik (Arabic: سالم صالح سالم بن بريك; born 3 April 1965) is a Yemeni politician who served as the internationally recognised prime minister of Yemen, under the Presidential Leadership Council (PLC), from 2025 to 2026.","image":"Fagin and bin Braik, 2025 (cropped).jpg","birth":1965.2520547945205,"death":null},"Q483672":{"label":"Ali Abdullah Saleh","description":"President of North Yemen (1978–1990) and Yemen (1990–2012)","enwiki":"Ali Abdullah Saleh","summary":"Ali Abdullah Saleh (21 March 1947 – 4 December 2017) was a Yemeni military officer and politician who served as the first president of the Republic of Yemen from the Yemeni unification in 1990 until his resignation in 2012, following the Yemeni revolution. Previously, he had served as the fifth and last President of the Yemen Arab Republic (North Yemen), from July 1978 to 22 May 1990, after the assassination of President Ahmad al-Ghashmi. al-Ghashmi had earlier appointed Saleh as military governor in Taiz.\nA veteran and officer of the North Yemen civil war, Saleh consolidated power and restored civilian rule after al-Ghashmi's assassination in 1978.","image":"Ali Abdullah Saleh - Putin meeting 2010-06-30 (cropped).jpg","birth":1947.2164383561644,"death":2017.9232876712329},"Q57480":{"label":"Abdrabbuh Mansour Hadi","description":"President of Yemen from 2012 to 2022","enwiki":"Abdrabbuh Mansour Hadi","summary":"Abdrabbuh Mansour Hadi (1 September 1945 – 28 May 2026) was a Yemeni politician and military officer who served as the second president of Yemen from 2012 until his resignation in 2022. He previously served as the second vice president of Yemen from 1994 to 2012 under President Ali Abdullah Saleh.\nHadi was previously the field marshal of the Yemeni Armed Forces. In 2011, he briefly served as acting president for Saleh, who was undergoing medical treatment in Saudi Arabia following an attack on the presidential palace during the 2011 Yemeni uprising.","image":"Abdrabbuh Mansur Hadi.jpg","birth":1945.6657534246576,"death":2026.4027397260274}},"media":{"Flag of the Mutawakkilite Kingdom of Yemen.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Flag_of_the_Mutawakkilite_Kingdom_of_Yemen.svg/330px-Flag_of_the_Mutawakkilite_Kingdom_of_Yemen.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Mutawakkilite_Kingdom_of_Yemen.svg","author":"Urmas (SVG file)","license":"Public domain"},"Coat of arms of the kingdom of Yemen (1956-1962).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ad/Coat_of_arms_of_the_kingdom_of_Yemen_%281956-1962%29.svg/330px-Coat_of_arms_of_the_kingdom_of_Yemen_%281956-1962%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_the_kingdom_of_Yemen_(1956-1962).svg","author":"Rayan54","license":"CC BY-SA 4.0"},"Flag of Yemen.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/89/Flag_of_Yemen.svg/330px-Flag_of_Yemen.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Yemen.svg","author":"Nightstallion et al., see File history below for details.","license":"Public domain"},"Emblem of Yemen (2).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Emblem_of_Yemen_%282%29.svg/330px-Emblem_of_Yemen_%282%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Yemen_(2).svg","author":"Squiresy92","license":"Public domain"},"Imam yahya cropped.png":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cf/Imam_yahya_cropped.png/330px-Imam_yahya_cropped.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Imam_yahya_cropped.png","author":"Aamen Rihani","license":"Public domain"},"YemenAhmad.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/8/88/YemenAhmad.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:YemenAhmad.jpg","author":"نجيب","license":"Public domain"},"Muhammad al-Badr.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Muhammad_al-Badr.jpg/330px-Muhammad_al-Badr.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Muhammad_al-Badr.jpg","author":"Unknown photographer","license":"Public domain"},"Rashad al-Alimi - 2022.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Rashad_al-Alimi_-_2022.jpg/330px-Rashad_al-Alimi_-_2022.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Rashad_al-Alimi_-_2022.jpg","author":"Ali mamon","license":"CC BY-SA 4.0"},"Fagin and bin Braik, 2025 (cropped).jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Fagin_and_bin_Braik%2C_2025_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Fagin_and_bin_Braik,_2025_(cropped).jpg","author":"U.S. Embassy Yemen","license":"Public domain"},"Ali Abdullah Saleh - Putin meeting 2010-06-30 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a5/Ali_Abdullah_Saleh_-_Putin_meeting_2010-06-30_%28cropped%29.jpg/330px-Ali_Abdullah_Saleh_-_Putin_meeting_2010-06-30_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ali_Abdullah_Saleh_-_Putin_meeting_2010-06-30_(cropped).jpg","author":"premier.gov.ru","license":"CC BY 4.0"},"Abdrabbuh Mansur Hadi.jpg":{"url":"https://thumb.wik