e as a sole unifying symbol."}],"facts":[{"qid":"Q722071","kind":"capital","value_qid":"Q182059","value_label":"Kumasi","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Kumasi"},{"qid":"Q722071","kind":"government","value_qid":"Q184558","value_label":"absolute monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"absolute monarchy"},{"qid":"Q722071","kind":"flag","value_qid":null,"value_label":"Flag of Ashanti.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q722071","kind":"coat","value_qid":null,"value_label":"Ashanti Empire Emblem.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null}],"people":{},"media":{"Flag of Ashanti.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ed/Flag_of_Ashanti.svg/330px-Flag_of_Ashanti.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Ashanti.svg","author":"Himasaram","license":"Public domain"},"Ashanti Empire Emblem.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/de/Ashanti_Empire_Emblem.svg/330px-Ashanti_Empire_Emblem.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ashanti_Empire_Emblem.svg","author":"Zuanzuanfuwa","license":"CC BY-SA 3.0"}},"names":["Asante Empire","Aschanti-Föderation","Aschanti-Königreich","Aschantiföderation","Aschantikönigreich","Aschantireich","Ashantee","Ashanti","Ashanti (regno)","Ashanti Confederatie","Ashanti Empire","Ashanti Krallığı","Ashanti帝国","Confederazione ashanti","Empire ashanti","Imperio Asante","Imperio Ashanti","Imperio asante","Impero ashanti","Império Ashanti","Império Axante","Königreich Aschanti","Regnum Ashanti","Αυτοκρατορία του Ασάντι","Ашанти","إمبراطورية آشانتي","امپراتوری آسانته","असन्ते","असन्