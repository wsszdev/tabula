t interruption, aside from being briefly ruled by the Macedonian king Alexander the Great (r. 336–323 BC)."}],"facts":[{"qid":"Q260437","kind":"capital","value_qid":"Q2607082","value_label":"Ganzak","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Ganzak"},{"qid":"Q260437","kind":"capital","value_qid":"Q180103","value_label":"Ardabil","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Ardabil"},{"qid":"Q260437","kind":"official_language","value_qid":"Q12836150","value_label":"Atropatenian","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Atropatenian"},{"qid":"Q260437","kind":"official_religion","value_qid":"Q9601","value_label":"Zoroastrianism","from_t":null,"to_t":null,"title":null,"property":"P3075","retrieved":"2026-10-30","vl":"Zoroastrianism"},{"qid":"Q260437","kind":"government","value_qid":"Q7269","value_label":"monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"monarchy"},{"qid":"Q260437","kind":"successor","value_qid":"Q274536","value_label":"Azerbaijan (Iran)","from_t":null,"to_t":null,"title":null,"property":"P156","retrieved":"2026-10-30","vl":"Azerbaijan (Iran)"}],"people":{},"media":{},"names":["Atropatena","Atropatene","Atropatene Media","Atropatene antiqua","Atropatia","Atropatian Media","Atropatie","Atropatios Media","Atropatène","Little Media","Media Atropatena","Media Atropatene","Médie atropatienne","Médie atropatène","Petite Médie","Ατροπατηνή","Μηδία Ατροπατηνή","Атропатена","Атурпатакан","Атурпаткан","Малая Мидия","Мидия Атропатена","آتورپاتکان","أتروباتكان","أتروباتين","أتورباتكان","अट्रोपेटीन","アトロパテネ王国","亞特羅巴特那","阿特羅帕特尼王國"]}