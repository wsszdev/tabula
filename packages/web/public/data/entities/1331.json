uese explorer Aleixo Garcia was the first European to reach the Inca Empire in 1524."}],"facts":[{"qid":"Q28573","kind":"ruler","value_qid":"Q179577","value_label":"Atahualpa","from_t":1532,"to_t":1533,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Atahualpa"},{"qid":"Q28573","kind":"ruler","value_qid":"Q213758","value_label":"Pachacútec","from_t":1438,"to_t":1471,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Pachacútec"},{"qid":"Q28573","kind":"ruler","value_qid":"Q311415","value_label":"Túpac Inca Yupanqui","from_t":1471,"to_t":1493,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Túpac Inca Yupanqui"},{"qid":"Q28573","kind":"ruler","value_qid":"Q311433","value_label":"Huayna Capac","from_t":1493,"to_t":1527,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Huayna Capac"},{"qid":"Q28573","kind":"ruler","value_qid":"Q213749","value_label":"Huascar","from_t":1527,"to_t":1532,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Huascar"},{"qid":"Q28573","kind":"capital","value_qid":"Q5582862","value_label":"Cusco","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Cusco"},{"qid":"Q28573","kind":"official_language","value_qid":"Q5218","value_label":"Quechua","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Quechua"},{"qid":"Q28573","kind":"language","value_qid":"Q35882","value_label":"Classical Quechua","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Classical Quechua"},{"qid":"Q28573","kind":"language","value_qid":"Q5218","value_label":"Quechua","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Quechua"},{"qid":"Q28573","kind":"language","value_qid":"Q33010","value_label":"Aymaran","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Aymaran"},{"qid":"Q28573","kind":"language","value_qid":"Q1207739","value_label":"Puquina","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Puquina"},{"qid":"Q28573","kind":"language","value_qid":"Q1951641","value_label":"Mochica","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Mochica"},{"qid":"Q28573","kind":"religion","value_qid":"Q3238302","value_label":"religion in the Inca Empire","from_t":null,"to_t":null,"title":null,"property":"P140","retrieved":"2026-10-30","vl":"religion in the Inca Empire"},{"qid":"Q28573","kind":"government","value_qid":"Q184558","value_label":"absolute monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"absolute monarchy"},{"qid":"Q28573","kind":"government","value_qid":"Q3271557","value_label":"imperial cult","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"imperial cult"},{"qid":"Q28573","kind":"predecessor","value_qid":"Q2314963","value_label":"Kingdom of Cusco","from_t":null,"to_t":null,"title":null,"property":"P155","retrieved":"2026-10-30","vl":"Kingdom of Cusco"},{"qid":"Q28573","kind":"successor","value_qid":"Q10715354","value_label":"Neo-Inca State","from_t":null,"to_t":null,"title":null,"property":"P156","retrieved":"2026-10-30","vl":"Neo-Inca State"},{"qid":"Q28573","kind":"successor","value_qid":"Q211435","value_label":"Viceroyalty of Peru","from_t":null,"to_t":null,"title":null,"property":"P156","retrieved":"2026-10-30","vl":"Viceroyalty of Peru"},{"qid":"Q28573","kind":"flag","value_qid":null,"value_label":"Banner of the Inca Empire.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null}],"people":{"Q179577":{"label":"Atahualpa","description":"Last Incan emperor","enwiki":"Atahualpa","summary":"Atawallpa ( ), also Atahualpa or Ataw Wallpa (Classical Quechua: Ataw Wallpa, pronounced [ˈataw ˈwaʎpa]) (c. 1502 – 29 August 1533), whose regnal name was Caccha Pachacuti Inca Yupanqui Inca (from the caccha idol and to honour the emperor Pachacuti), was the last effective Inca emperor, reigning from April 1532 until his capture and execution in July-August of the following year, as part of the Spanish conquest of the Inca Empire.","image":"Atahuallpa, Inca XIIII From Berlin Ethnologisches Museum, Staatliche Museen, Berlin, Germany.png","birth":1500,"death":1533.6575342465753},"Q213758":{"label":"Pachacútec","description":"11th Inca Emperor","enwiki":"Pachacuti","summary":"Pachacuti Inca Yupanqui, also called Pachacútec (Quechua: Pachakutiy Inka Yupanki, pronounced [ˈpatʃa ˈkuti ˈiŋka juˈpaŋki]), was the ninth Sapa Inca of the Chiefdom of Cusco, which he transformed into the Inca Empire (Tawantinsuyu). Most archaeologists now believe that the famous Inca site of Machu Picchu was built as an estate for Pachacuti.\nIn Quechua, the cosmogonical concept of pachakutiy means \"the turn of the world\" and yupanki could mean \"honorable lord\". During his reign, Cusco grew from a small town into an empire that could compete with, and eventually overtake, the Chimú empire on the northern coast.","image":"Brooklyn Museum - Pachacuti, Tenth Inca, 1 of 14 Portraits of Inca Kings (cropped).jpg","birth":1391,"death":1471},"Q311415":{"label":"Túpac Inca Yupanqui","description":"12th Inca Emperor","enwiki":"Topa Inca Yupanqui","summary":"Topa Inca Yupanqui or Túpac Inca Yupanqui (Cusco Quechua: Thupa Inka Yupanki, pronounced [ˈtʰupa ˈiŋka juˈpaŋki]), also Topa Inga Yupangui, erroneously translated as \"noble Inca accountant\" (before 1471 – 1493) was the tenth Sapa Inca (1471–1493) of the Inca Empire, fifth of the Hanan dynasty. His father was Pachacuti, and his son was Huayna Capac. Topa Inca belonged to the Qhapaq Panaca (one of the clans of Inca nobles). His quya (principal wife) was his older sister, Mama Ocllo.","image":"Brooklyn Museum - Tupac Yupanqui, Eleventh Inca, 1 of 14 Portraits of Inca Kings - overall.jpg","birth":1441,"death":1493},"Q311433":{"label":"Huayna Capac","description":"13th Inca Emperor","enwiki":"Huayna Capac","summary":"Huayna Capac ( WY-nə KAP-ak; Cusco Quechua: Wayna Qhapaq [ˈwajna ˈqʰapaχ] – lit. 'the young generous one'; Spanish: [ˈwajna ˈkapak]; before 1493 – 1527) was the eleventh Sapa Inca of Tawantinsuyu, the Inca Empire. He was the son of and successor to Túpac Inca Yupanqui, the sixth Sapa Inca of the Hanan dynasty, and eleventh of the Inca civilization. He was born in Tumipampa and tutored to become Sapa Inca from a young age.\nTawantinsuyu reached its greatest extent under Huayna Capac, as he expanded the empire's borders south along the Chilean coast, and north through what is now Ecuador and southern Colombia.","image":"Brooklyn Museum - Huayna Capac, Twelfth Inca.jpg","birth":1464,"death":1527},"Q213749":{"label":"Huascar","description":"14th Inca Emperor","enwiki":"Huáscar","summary":"Huáscar () (Classical Quechua: Waskhar, pronounced [waskʰar]) also Guazcar (before 1527 – 1532) was Sapa Inca of the Inca Empire from 1527 to 1532. He succeeded his father, Huayna Capac and his brother Ninan Cuyochi, both of whom died of smallpox during the same year while campaigning near Quito. From 1529 to 1532, Huáscar fought the Inca civil war against his half-brother Atahualpa, who prevailed and captured Huáscar. Shortly thereafter, Atahualpa was captured by the Spanish conquistador Francisco Pizarro and had Huáscar killed.","image":"Brooklyn Museum - Huascar, Thirteenth Inca, 1 of 14 Portraits of Inca Kings - overall.jpg","birth":1490,"death":1532}},"media":{"Banner of the Inca Empire.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/82/Banner_of_the_Inca_Empire.svg/330px-Banner_of_the_Inca_Empire.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Banner_of_the_Inca_Empire.svg","author":"Made and uploaded by Huhsunqu.","license":"CC BY-SA 2.5"},"Atahuallpa, Inca XIIII From Berlin Ethnologisches Museum, Staatliche Museen, Berlin, Germany.png":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Atahuallpa%2C_Inca_XIIII_From_Berlin_Ethnologisches_Museum%2C_Staatliche_Museen%2C_Berlin%2C_Germany.png/330px-Atahuallpa%2C_Inca_XIIII_From_Berlin_Ethnologisches_Museum%2C_Staatliche_Museen%2C_Berlin%2C_Germany.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Atahuallpa,_Inca_XIIII_From_Berlin_Ethnologisches_Museum,_Staatliche_Museen,_Berlin,_Germany.png","author":"anonymous","license":"Public domain"},"Brooklyn Museum - Pachacuti, Tenth Inca, 1 of 14 Portraits of Inca Kings (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Brooklyn_Museum_-_Pachacuti%2C_Tenth_Inca%2C_1_of_14_Portraits_of_Inca_Kings_%28cropped%29.jpg/330px-Brooklyn_Museum_-_Pachacuti%2C_Tenth_Inca%2C_1_of_14_Portraits_of_Inca_Kings_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Brooklyn_Museum_-_Pachacuti,_Tenth_Inca,_1_of_14_Portraits_of_Inca_Kings_(cropped).jpg","author":null,"license":"Public domain"},"Brooklyn Museum - Tupac Yupanqui, Eleventh Inca, 1 of 14 Portraits of Inca Kings - overall.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2d/Brooklyn_Museum_-_Tupac_Yupanqui%2C_Eleventh_Inca%2C_1_of_14_Portraits_of_Inca_Kings_-_overall.jpg/330px-Brooklyn_Museum_-_Tupac_Yupanqui%2C_Eleventh_Inca%2C_1_of_14_Portraits_of_Inca_Kings_-_overall.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Brooklyn_Museum_-_Tupac_Yupanqui,_Eleventh_Inca,_1_of_14_Portraits_of_Inca_Kings_-_overall.jpg","author":null,"license":"Public domain"},"Brooklyn Museum - Huayna Capac, Twelfth Inca.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dc/Brooklyn_Museum_-_Hu