t":1914,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"New Zealand","description":"island country in the southwest Pacific Ocean","inception":1986.9479452054795,"dissolved":null,"enwiki":"New Zealand","summary":"New Zealand (Māori: Aotearoa, pronounced [aɔˈtɛaɾɔa] ) is an island country in the southwestern Pacific Ocean. It comprises two main landmasses—the North Island (Te Ika-a-Māui) and the South Island (Te Waipounamu)—and over 700 smaller islands. It is the sixth-largest island country by area and lies east of Australia across the Tasman Sea and south of the islands of New Caledonia, Fiji, and Tonga. The country's varied topography and sharp mountain peaks, including the Southern Alps (Kā Tiritiri o te Moana), owe much to tectonic uplift and volcanic eruptions."}],"facts":[{"qid":"Q664","kind":"ruler","value_qid":"Q43274","value_label":"Charles III","from_t":2022.6849315068494,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Charles III"},{"qid":"Q664","kind":"ruler","value_qid":"Q74370310","value_label":"Christopher Luxon","from_t":2023.9041095890411,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Christopher Luxon"},{"qid":"Q664","kind":"capital","value_qid":"Q23661","value_label":"Wellington","from_t":1865,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Wellington"},{"qid":"Q664","kind":"official_language","value_qid":"Q36451","value_label":"Māori","from_t":1987.5808219178082,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Māori"},{"qid":"Q664","kind":"official_language","value_qid":"Q36239","value_label":"New Zealand Sign Language","from_t":2006.2739726027398,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"New Zealand Sign Language"},{"qid":"Q664","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10