in_lon":8.81520942172168,"min_lat":-3.932286657377439,"max_lon":14.492750200835449,"max_lat":2.27685459704761,"source_file":"world_2010.geojson","source_row":null}],"identities":[{"qid":"Q1000","from_t":1960,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Gabon","description":"country on the Atlantic coast of Central Africa","inception":1960,"dissolved":null,"enwiki":"Gabon","summary":"Gabon, officially the Gabonese Republic, is a country on the Atlantic coast of Central Africa, lying on the equator. It is bordered by Equatorial Guinea to the northwest, Cameroon to the north, the Republic of the Congo to the east and south, while sharing a maritime border with São Tomé and Príncipe to the west in the Gulf of Guinea. It has an area of 270,000 square kilometres (100,000 sq mi) and a population of 2.6 million people. There are coastal plains, mountains (the Cristal Mountains and the Chaillu Massif in the centre), and savanna in the east."}],"facts":[{"qid":"Q1000","kind":"ruler","value_qid":"Q122067521","value_label":"Brice Clotaire Oligui Nguema","from_t":2023.6602739726027,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Brice Clotaire Oligui Nguema"},{"qid":"Q1000","kind":"ruler","value_qid":"Q57856","value_label":"Raymond Ndong Sima","from_t":2023.682191780822,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Raymond Ndong Sima"},{"qid":"Q1000","kind":"capital","value_qid":"Q3825","value_label":"Libreville","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Libreville"},{"qid":"Q1000","kind":"official_language","value_qid":"Q150","value_label":"French","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"French"},{"qid":"Q1000","kind":"language","value_qid":"Q3507832","value_label":"Jola-Fonyi","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Jola-Fonyi"},{"qid":"Q100