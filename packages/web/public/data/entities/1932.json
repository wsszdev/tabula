lue_label":"Ludovico Sforza","from_t":1494.827397260274,"to_t":1500.2986301369863,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Ludovico Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q289285","value_label":"Filippo Maria Visconti","from_t":1412.396174863388,"to_t":1447.6383561643836,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Filippo Maria Visconti"},{"qid":"Q153529","kind":"ruler","value_qid":"Q310536","value_label":"Francesco I Sforza","from_t":1450.2520547945205,"to_t":1466.2054794520548,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Francesco I Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q314514","value_label":"Gian Galeazzo Sforza","from_t":1476,"to_t":1494,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Gian Galeazzo Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q317894","value_label":"Galeazzo Maria Sforza","from_t":1466.2054794520548,"to_t":1477.0082191780823,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Galeazzo Maria Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q357539","value_label":"Gian Galeazzo Visconti","from_t":1395,"to_t":1402,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Gian Galeazzo Visconti"},{"qid":"Q153529","kind":"ruler","value_qid":"Q378739","value_label":"Maximilian Sforza","from_t":1512,"to_t":1515,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Maximilian Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q378868","value_label":"Francesco II Sforza","from_t":1521.9095890410958,"to_t":1524.7814207650274,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Francesco II Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q456902","value_label":"Gian Maria Visconti","from_t":1402.695890410959,"to_t":1412.396174863388,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Gian Maria Visconti"},{"qid":"Q153529","kind":"ruler","value_qid":"Q378868","value_label":"Francesco II Sforza","from_t":1525.1808219178083,"to_t":1535.86301369863,"title":"Duke of Milan","property":"P39","retrieved":"2026-10-30","vl":"Francesco II Sforza"}],"people":{"Q310536":{"label":"Francesco I Sforza","description":"Italian condottiero and Sforza dynasty founder (1401–1466)","enwiki":"Francesco I Sforza","summary":"Francesco I Sforza (Italian: [franˈtʃesko ˈpriːmo ˈsfɔrtsa]; 23 July 1401 – 8 March 1466) was an Italian condottiere who founded the Sforza dynasty in the duchy of Milan, ruling as its (fourth) duke from 1450 until his death. Renowned for his military skill and political acumen, he was among the few condottieri to successfully transform battlefield success into stable dynastic rule.\nIn the 1420s, he took part in the War of L'Aquila, and during the 1430s he served both the Papal States and the Duchy of Milan in their conflicts against Venice. Following the Peace of Cremona (1441), which he helped broker, Sforza married Bianca Maria Visconti, daughter of Duke Filippo Maria Visconti, thus strengthening his claim to Milan.","image":"Francesco Sforza.jpg","birth":1401.5561643835617,"death":1466.1808219178083},"Q317894":{"label":"Galeazzo Maria Sforza","description":"Duke of Milan (1444-1477)","enwiki":"Galeazzo Maria Sforza","summary":"Galeazzo Maria Sforza (24 January 1444 – 26 December 1476) was the fifth Duke of Milan from 1466 until 1476. He was born to Francesco Sforza, a popular condottiero and ally of Cosimo de' Medici who would gain the Duchy of Milan in 1450, and Bianca Maria Visconti, Duchess of Milan in her own right. Sforza was betrothed into the Gonzaga family; after the engagement with Dorotea Gonzaga was called off, he married Bona of Savoy.","image":"Piero Pollaiuolo Portrait of Galeazzo Maria Sforza.jpg","birth":1444.0628415300546,"death":1476.983606557377},"Q314514":{"label":"Gian Galeazzo Sforza","description":"Duke of Milano","enwiki":"Gian Galeazzo Sforza","summary":"Gian Galeazzo Sforza (20 June 1469 – 21 October 1494), also known as Giovan Galeazzo Sforza, was the sixth Duke of Milan. He was the father of Bona Maria Sforza, who later became Queen of Poland. He died in 1494 aged 25 and was succeeded by his uncle, Ludovico Sforza.","image":"Workshop of Benedetto Briosco, Gian Galeazzo Maria Sforza, Duke of Milan, early 1490s, NGA 128.jpg","birth":1469.4657534246576,"death":1494.8027397260273},"Q236853":{"label":"Ludovico Sforza","description":"duke of Milan","enwiki":"Ludovico Sforza","summary":"Ludovico Maria Sforza (Italian: [ludoˈviːko maˈriːa ˈsfɔrtsa]; 3 August 1452 – 27 May 1508), also known as Ludovico il Moro (Italian: [il ˈmɔːro]; 'the Moor'), and called the \"arbiter of Italy\" by historian Francesco Guicciardini, was an Italian nobleman who ruled as the Duke of Milan from 1494 to 1499.\nAlthough he was the fourth son and excluded from his family's succession, Ludovico was ambitious and managed to obtain dominion over Milan. He first assumed the regency from his sister-in-law Bona, then took over from his deceased nephew Gian Galeazzo, whom some say he poisoned. Considered enlightened, generous, and peaceful, he became a patron of artists and writers.","image":"Pala Sforzesca - detail 01.jpg","birth":1452.568306010929,"death":1508.4016393442623},"Q357539":{"label":"Gian Galeazzo Visconti","description":"first Duke of Milan (1351-1402)","enwiki":"Gian Galeazzo Visconti","summary":"Gian Galeazzo Visconti (16 October 1351 – 3 September 1402), was the first duke of Milan (1395) and ruled that late-medieval city just before the dawn of the Renaissance. He also ruled Lombardy jointly with his uncle Bernabò. He was the founding patron of the Certosa di Pavia, completing the Visconti Castle at Pavia begun by his father and furthering work on the Duomo of Milan. He conquered a large area in the Po Valley of northern Italy.","image":"GiovAmbrogiodePredisattribGianGaleazzoVisconti.jpg","birth":1351.7890410958903,"death":1402.6712328767123},"Q456902":{"label":"Gian Maria Visconti","description":"second Visconti Duke of Milan, the son of Gian Galeazzo Visconti and Caterina Visconti (1388-1412)","enwiki":"Gian Maria Visconti","summary":"Gian Maria Visconti (or Giovanni Maria; 7 September 1388 – 16 May 1412) was the second Visconti Duke of Milan, the son of Gian Galeazzo Visconti and Caterina Visconti. He was viewed as cruel and was eventually assassinated. He had no children.","image":"Giovanni Maria Visconti - Le vite de i dodeci visconti che signoreggiarono Milano (1645).jpg","birth":1388.6830601092897,"death":1412.3715846994535},"Q289285":{"label":"Filippo Maria Visconti","description":"Duke of Milan","enwiki":"Filippo Maria Visconti","summary":"Filippo Maria Visconti (3 September 1392 – 13 August 1447) was the Duke of Milan from 1412 until his death in 1447. \nIn the 1420s, he engaged in conflict with Romagna, Florence, and Venice during the Wars in Lombardy, but was eventually compelled to surrender under pressure from Pope Martin V. He later returned to war, which ended with another peace agreement.\nVisconti married twice; his second marriage, in 1428, was to Marie of Savoy, daughter of his ally Amadeus VIII, Duke of Savoy. At his death in 1447, Visconti was the last male of the Visconti line.","image":"Pisanello - Codex Vallardi 2484.jpg","birth":1392.672131147541,"death":1447.613698630137},"Q378739":{"label":"Maximilian Sforza","description":"Duke of Milan","enwiki":"Maximilian Sforza","summary":"Maximilian Maria Sforza (Italian: Massimiliano Maria Sforza; 25 January 1493 – 25 May 1530) was a Duke of Milan from the Sforza family, the son of Ludovico Sforza.","image":"Massimiliano Sforza by G.A. de Predis (Donatus Grammatica).jpg","birth":1493.0657534246575,"death":1530.4219178082192},"Q378868":{"label":"Francesco II Sforza","description":"Duke of Milan, 1521-24, 1525-35","enwiki":"Francesco II Sforza","summary":"Francesco II Sforza (4 February 1495 – 1 November 1535) was Duke of Milan from 1521 until his death. He became duke after Emperor Charles V reconquered Milan from the French. He fought at the Battle of Bicocca against the French, but in 1526 joined the League of Cognac with Francis I of France. Surviving a poisoning, he married Christina of Denmark, but died childless.","image":"FrancescoIISforza.jpg","birth":1495.0931506849315,"death":1535.8109589041096}},"media":{"Flag of the Duchy of Milan (1450).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Flag_of_the_Duchy_of_Milan_%281450%29.svg/330px-Flag_of_the_Duchy_of_Milan_%281450%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_the_Duchy_of_Milan_(1450).svg","author":"F l a n k e r","license":"Public domain"},"Coat of arms of the Duchy of Milan (Sforza period).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Coat_of_arms_of_the_Duchy_of_Milan_%28Sforza_period%29.svg/330px-Coat_of_arms_of_the_Duchy_of_Milan_%28Sforza_period%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_the_Duchy_of_Milan_(Sforza_period).svg","author":"MostEpic","license":"CC BY-SA 4.0"},"Francesco Sforza.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Francesco_Sforza.jpg/330px-Francesco_Sforza.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Francesco_Sforza.jpg","author":"School of Lombardy","license":"Public domain"},"Piero Pollaiuolo Portrait of Galeazzo Maria Sforza.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Piero_Pollaiuolo_Portrait_of_Galeazzo_Maria_Sforza.jpg/330px-Piero_Pollaiuolo_Portrait_of_Galeazzo_Maria_Sforza.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Piero_Pollaiuolo_Portrait_of_Galeazzo_Maria_Sforza.jpg","author":"Piero del Pollaiuolo","license":"Public domain"},"Workshop of Benedetto Briosco, Gian Galeazzo Maria Sforza, Duke of Milan, early 1490s, NGA 128.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Workshop_of_Benedetto_Briosco%2C_Gian_Galeazzo_Maria_Sforza%2C_Duke_of_Milan%2C_early_1490s%2C_NGA_128.jpg/330px-Workshop_of_Benedetto_Briosco%2C_Gian_Galeazzo_Maria_Sforza%2C_Duke_of_Milan%2C_early_1490s%2C_NGA_128.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Workshop_of_Benedetto_Briosco,_Gian_Galeazzo_Maria_Sforza,_Duke_of_Milan,_early_1490s,_NGA_128.jpg","author":"Workshop of Benedetto Briosco","license":"CC0"},"Pala Sforzesca - detail 01.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/Pala_Sforzesca_-_detail_01.jpg/330px-Pala_Sforzesca_-_detail_01.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Pala_Sforzesca_-_detail_01.jpg","author":"Giovanni Angelo Mirofoli","license":"Public domain"},"GiovAmbrogiodePredisattribGianGaleazzoVisconti.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a4/GiovAmbrogiodePredisattribGianGaleazzoVisconti.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:GiovAmbrogiodePredisattribGianGaleazzoVisconti.jpg","author":"Attributed to Giovanni Ambrogio de Predis","license":"Public domain"},"Giovanni Maria Visconti - Le vite de i dodeci visconti che signoreggiarono Milano (1645).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cc/Giovanni_Maria_Visconti_-_Le_vite_de_i_dodeci_visconti_che_signoreggiarono_Milano_%281645%29.jpg/330px-Giovanni_Maria_Visconti_-_Le_vite_de_i_dodeci_visconti_che_signoreggiarono_Milano_%281645%29.jpg?utm_source=commons.