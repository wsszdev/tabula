_from":1715,"valid_to":1783,"snapshot_held":1,"area_km2":11938.323151196433,"border_precision":3,"capital_name":null,"sovereign":"Austrian Empire","sovereign_note":"As mapped by Historical Basemaps (world_1715.geojson)","modern_name":"Italy/Sardinia","min_lon":8.450031241287213,"min_lat":45.02104084794619,"max_lon":10.393319124301868,"max_lat":46.510578,"source_file":"world_1715.geojson","source_row":null}],"identities":[{"qid":"Q153529","from_t":1530,"to_t":1783,"method":"name-template+date","confidence":0.8745027655701985,"label":"Duchy of Milan","description":"former duchy in Italy (1395–1447; 1450–1796)","inception":1395.3561643835617,"dissolved":1797.7917808219179,"enwiki":"Duchy of Milan","summary":"The Duchy of Milan (Italian: Ducato di Milano; Lombard: Ducaa de Milan) was a state in Northern Italy, created in 1395 by Gian Galeazzo Visconti, then the lord of Milan, and a member of the important Visconti family, which had ruled the city since 1277. At that time, it included twenty-six towns and the wide rural area of the middle Padan Plain east of the hills of Montferrat. During much of its existence, it was wedged between Savoy to the west, Republic of Venice to the east, the Swiss Confederacy to the north, and separated from the Mediterranean by the Republic of Genoa to the south. The duchy was at its largest at the beginning of the 15th century, at which time it included almost all of what is now Lombardy and parts of what are now Piedmont, Veneto, Tuscany, and Emilia-Romagna."}],"facts":[{"qid":"Q153529","kind":"ruler","value_qid":"Q310536","value_label":"Francesco I Sforza","from_t":1450,"to_t":1466,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Francesco I Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q317894","value_label":"Galeazzo Maria Sforza","from_t":1466,"to_t":1476,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Galeazzo Maria Sforza"},{"qid":"Q153529","kind":"ruler","value_qid":"Q314514","