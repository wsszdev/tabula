","from_t":2024.0928961748634,"to_t":2025.2164383561644,"title":"President of the Republic of Namibia","property":"P39","retrieved":"2026-10-30","vl":"Nangolo Mbumba"},{"qid":"Q1030","kind":"ruler","value_qid":"Q57469","value_label":"Hifikepunye Pohamba","from_t":2005.2164383561644,"to_t":2015.2164383561644,"title":"President of the Republic of Namibia","property":"P39","retrieved":"2026-10-30","vl":"Hifikepunye Pohamba"},{"qid":"Q1030","kind":"flag","value_qid":"Q165822","value_label":"Flag of Namibia.svg","from_t":1990.2164383561644,"to_t":null,"title":"flag of Namibia","property":"P163","retrieved":"2026-10-30","vl":"flag of Namibia"}],"people":{"Q527020":{"label":"Netumbo Nandi-Ndaitwah","description":"Namibian politician","enwiki":"Netumbo Nandi-Ndaitwah","summary":"Ndemupelila Netumbo Nandi-Ndaitwah (née Nandi; born 29 October 1952), nicknamed NNN, is a Namibian politician who is the fifth and current president of Namibia since 21 March 2025. She is the country's first female president. Previously, she served as the third vice president under President Nangolo Mbumba between 2024 and 2025. She held various high level political and ministerial position as well as various responsibility within the SWAPO party and its government over an uninterrupted period of 57 years.","image":"Netumbo Nandi-Ndaitwah 2025.jpg","birth":1952.8251366120219,"death":null},"Q5360975":{"label":"Elijah Ngurare","description":"Namibian politician","enwiki":"Elijah Ngurare","summary":"Tjitunga Elijah Ngurare (born 28 October 1970) is a Namibian politician and academic who is the current Prime Minister of Namibia. A long-time member and supporter of SWAPO, Namibia's ruling party, he rose through the ranks of the SWAPO Party Youth League (SPYL), first serving as the Secretary for Information, Publicity, and Mobilisation from 2002, before becoming Secretary-General in 2007. He held this position until 2015, when he was expelled from the party.\nHe previously served as an academic at the University of Namibia and later as a director in the Ministry of Agriculture.","image":"Elijah T. Ngurare (cropped).jpg","birth":1970.8219178082193,"death":null},"Q154104":{"label":"Sam Nujoma","description":"President of Namibia from 1990 to 2005 (1929–2025)","enwiki":"Sam Nujoma","summary":"Samuel Shafiishuna Daniel Nujoma (12 May 1929 – 8 February 2025) was a Namibian revolutionary, anti-apartheid activist and politician who served three terms as the first president of Namibia, from 1990 to 2005. Nujoma was a founding member and the first president of the South West Africa People's Organisation (SWAPO) in 1960.\nNujoma became involved in anti-colonial politics during the 1950s. In 1959, he co-founded and served as the first president of the Ovamboland People's Organization (OPO), a nationalist organization advocating for an independent Namibia.","image":"Sam Nujoma (2004) cropped.jpg","birth":1929.358904109589,"death":2025.1041095890412},"Q1568274":{"label":"Hage Geingob","description":"President of Namibia from 2015 to 2024","enwiki":"Hage Geingob","summary":"Hage Gottfried Geingob (3 August 1941 – 4 February 2024) was a Namibian politician who served as the third president of Namibia from 2015 until his death in February 2024. Geingob was the country's first prime minister from 1990 to 2002, and served again from 2012 to 2015.\nBetween 2008 and 2012 Geingob served as Minister of Trade and Industry. In November 2014, Geingob was elected president of Namibia by an overwhelming margin.","image":"Hage Geingob (cropped) (2023).jpg","birth":1941.5863013698631,"death":2024.0928961748634},"Q287100":{"label":"Nangolo Mbumba","description":"President of Namibia from 2024 to 2025","enwiki":"Nangolo Mbumba","summary":"Nangolo Mbumba (born 15 August 1941) is a Namibian politician who was the fourth president of Namibia from 2024 to 2025. He became president after the death of Hage Geingob, under whom he had served as the second vice president from 2018 until his accession to the presidency 2024.\nA member of the South West Africa People's Organization (SWAPO), Mbumba has headed several Namibian Government ministries: Agriculture, Water and Rural Development (1993–1996), Finance (1996–2003), Information and Broadcasting (2003–2005), Education (2005–2010) and Safety and Security (2010–2012). From 2012 to 2017, he was the secretary-general of SWAPO.\nMbumba was appointed as a vice president in 2018 to replace Nickey Iyambo, who departed because of ill health.","image":"Nangolo Mbumba June 2023.png","birth":1941.6191780821919,"death":null},"Q57469":{"label":"Hifikepunye Pohamba","description":"Namibian politician","enwiki":"Hifikepunye Pohamba","summary":"Hifikepunye Lucas Pohamba (born 18 August 1935) is a Namibian politician who served as the second president of Namibia from 21 March 2005 to 21 March 2015. He won the 2004 presidential election overwhelmingly as the candidate of SWAPO and was reelected in 2009. Pohamba was the president of SWAPO from 2007 until his retirement in 2015. He is a recipient of the Ibrahim Prize.","image":"Pohamba in 2007.jpg","birth":1935.627397260274,"death":null}},"media":{"Flag of Namibia.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Flag_of_Namibia.svg/330px-Flag_of_Namibia.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Namibia.svg","author":"SVG by Vzb83~commonswiki et al.","license":"Public domain"},"Coat of arms of Namibia.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Coat_of_arms_of_Namibia.svg/330px-Coat_of_arms_of_Namibia.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Namibia.svg","author":null,"license":"Public domain"},"Netumbo Nandi-Ndaitwah 2025.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Netumbo_Nandi-Ndaitwah_2025.jpg/330px-Netumbo_Nandi-Ndaitwah_2025.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Netumbo_Nandi-Ndaitwah_2025.jpg","author":"Prime Minister's Office","license":"GODL-India"},"Elijah T. Ngurare (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d6/Elijah_T._Ngurare_%28cropped%29.jpg/330px-Elijah_T._Ngurare_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Elijah_T._Ngurare_(cropped).jpg","author":"Martin Hipangwa","license":"CC BY-SA 4.0"},"Sam Nujoma (2004) cropped.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/54/Sam_Nujoma_%282004%29_cropped.jpg/330px-Sam_Nujoma_%282004%29_cropped.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Sam_Nujoma_(2004)_cropped.jpg","author":"Ana Nascimento/ABr","license":"CC BY 3.0 br"},"Hage Geingob (cropped) (2023).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Hage_Geingob_%28cropped%29_%282023%29.jpg/330px-Hage_Geingob_%28cropped%29_%282023%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Hage_Geingob_(cropped)_(2023).jpg","author":"Brussels - EC/Berlaymont","license":"CC BY 4.0"},"Nangolo Mbumba June 2023.png":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/99/Nangolo_Mbumba_June_2023.png/330px-Nangolo_Mbumba_June_2023.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Nangolo_Mbumba_June_2023.png","author":"Kashindi Ausiku","license":"CC BY 3.0"},"Pohamba in 2007.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Pohamba_in_2007.jpg/330px-Pohamba_in_2007.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_conte