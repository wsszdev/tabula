{"entity":{"id":"cs:4","name":"Hawaii","dataset":"cshapes","kind":"polity"},"territories":[{"id":10095,"name":"Hawaii","set_id":"cs","class":"polity","valid_from":1898.509589041096,"valid_to":1959.6356164383562,"snapshot_held":0,"area_km2":16685.6,"border_precision":3,"capital_name":"Honolulu","sovereign":null,"sovereign_note":null,"modern_name":"United States of America","min_lon":-160.247927,"min_lat":18.925482,"max_lon":-154.797818,"max_lat":22.239154,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=4;start=1898-7-6"}],"identities":[{"qid":"Q1057542","from_t":1898.509589041096,"to_t":1898.6109589041096,"method":"name-template+date","confidence":0.9086627176280117,"label":"Republic of Hawaii","description":"republic on the Hawaii Islands between 1894–1898","inception":1894,"dissolved":1898.6109589041096,"enwiki":"Republic of Hawaii","summary":"The Republic of Hawaii (Hawaiian: Lepupalika o Hawaiʻi, pronounced [lepupəˈlikə o həˈvɐjʔi]) was a short-lived one-party state in Hawaiʻi between July 4, 1894, when the Provisional Government of Hawaii had ended, and August 12, 1898, when it became annexed by the United States as an unincorporated and unorganized territory. In 1893, the Committee of Public Safety overthrew Queen Liliʻuokalani, the monarch of the Kingdom of Hawaiʻi, after she rejected the 1887 Bayonet Constitution. The Committee of Public Safety intended for Hawaii to be annexed by the United States; however, President Grover Cleveland, a Democrat opposed to imperialism, refused. A new constitution was subsequently written while Hawaii was being prepared for annexation."}],"facts":[{"qid":"Q1057542","kind":"capital","value_qid":"Q18094","value_label":"Honolulu","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Honolulu"},{"qid":"Q1057542","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"English"},{"qid":"Q10