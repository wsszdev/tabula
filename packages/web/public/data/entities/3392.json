t_held":1,"area_km2":2346307.2735300786,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Congo, Democratic Republic of (Zaire)","min_lon":12.194246325103027,"min_lat":-13.467049039884763,"max_lon":31.244637522307617,"max_lat":5.310847364381594,"source_file":"world_2010.geojson","source_row":null}],"identities":[{"qid":"Q6500954","from_t":1971.8191780821917,"to_t":1997.3698630136987,"method":"name-label+date","confidence":0.95,"label":"Zaire","description":"one-party military dictatorship in Central Africa (1965–1997) under Mobutu Sese Seko; renamed Republic of Zaire in 1971 as part of Mobutu's Authenticité policy; formerly Belgian Congo, now Democratic Republic of the Congo","inception":1971.8191780821917,"dissolved":1997.3698630136987,"enwiki":"Zaire","summary":"Zaire (spelt Zaïre in French, and sometimes in English), officially the Democratic Republic of the Congo from 1965 to 1971 and the Republic of Zaire from 1971 to 1997, was the Congolese state in Central Africa headed by Mobutu Sese Seko from 1965 to 1997. It was, by area, the third-largest country in Africa after Sudan and Algeria, and the 11th-largest country in the world from 1965 to 1991. With a population of over 23 million, Zaire was the most populous Francophone country in Africa. Zaire was strategically important to the West during the Cold War, particularly the U.S., as a counterbalance to Soviet influence in Africa."}],"facts":[{"qid":"Q6500954","kind":"ruler","value_qid":"Q164535","value_label":"Mobutu Sese Seko","from_t":null,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Mobutu Sese Seko"},{"qid":"Q6500954","kind":"capital","value_qid":"Q3838","value_label":"Kinshasa","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Kinshasa"},{"qid":"Q6500954","kind":"official_language","value_qid":"Q150","value_label":"French","from_t":null,"to_t":null,"title":null,"property":"P37","retrieve