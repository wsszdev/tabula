id":"Q355850","value_label":"Ayaz Mutallibov","from_t":1992.3661202185792,"to_t":1992.377049180328,"title":"President of Azerbaijan","property":"P39","retrieved":"2026-10-30","vl":"Ayaz Mutallibov"},{"qid":"Q227","kind":"ruler","value_qid":"Q355850","value_label":"Ayaz Mutallibov","from_t":1991.0958904109589,"to_t":1992.1775956284152,"title":"President of Azerbaijan","property":"P39","retrieved":"2026-10-30","vl":"Ayaz Mutallibov"},{"qid":"Q227","kind":"ruler","value_qid":"Q157451","value_label":"Heydar Aliyev","from_t":1993.4767123287672,"to_t":1993.7534246575342,"title":"President of Azerbaijan","property":"P39","retrieved":"2026-10-30","vl":"Heydar Aliyev"},{"qid":"Q227","kind":"ruler","value_qid":"Q101557330","value_label":"Fariz Najafov","from_t":2019.2931506849316,"to_t":null,"title":"President of Gabala İK","property":"P39","retrieved":"2026-10-30","vl":"Fariz Najafov"},{"qid":"Q227","kind":"flag","value_qid":"Q82236","value_label":"Flag of Azerbaijan.svg","from_t":1918.854794520548,"to_t":null,"title":"flag of Azerbaijan","property":"P163","retrieved":"2026-10-30","vl":"flag of Azerbaijan"}],"people":{"Q57371":{"label":"Ilham Aliyev","description":"President of Azerbaijan since 2003","enwiki":"Ilham Aliyev","summary":"Ilham Heydar oghlu Aliyev (born 24 December 1961) is an Azerbaijani politician and statesman who has been the fourth president of Azerbaijan since 2003. He is the son of the previous president, Heydar Aliyev, and has led the New Azerbaijan Party since 2005.\nAliyev briefly served as prime minister for his father before being elected to office in a presidential election defined by irregularities, shortly before his father's death. He was re-elected for a second term in 2008 and was allowed to run in elections indefinitely after the 2009 constitutional referendum removed presidential term limits, winning subsequent elections in 2013, 2018 and 2024.","image":"Ilham Aliyev, December 2025 (cropped).jpg","birth":1961.978082191781,"death":null},"Q12850075":{"label":"Ali Asadov","description":"Prime Minister of the Republic of Azerbaijan","enwiki":"Ali Asadov","summary":"Ali Hidayat oghlu Asadov (Azerbaijani: Əli Hidayət oğlu Əsədov; born 30 November 1956) is an Azerbaijani politician serving as the Prime Minister of Azerbaijan following his appointment to the post on 8 October 2019 by president Ilham Aliyev.","image":"Али Асадов (25-08-2022).jpg","birth":1956.9125683060108,"death":null},"Q1189565":{"label":"Yaqub Mammadov","description":"Azerbaijani politician, professor and scientist (born 1941)","enwiki":"Yagub Mammadov (politician)","summary":"Yagub Javad oghlu Mammadov (Azerbaijani: Yaqub Cavad oğlu Məmmədov; born 3 March 1941), commonly known as Yagub (also Jacob in English) Mammadov, was the acting President of Azerbaijan from 6 March to 14 May and from 18 to 19 May 1992. Mammadov is currently an opposition politician, professor, and scientist.","image":"Ягуб Маммадов, Конференция, Мирная инициатива на Южном Кавказе, Баку, 24.05.2013.jpg","birth":1941.1671232876713,"death":null},"Q157451":{"label":"Heydar Aliyev","description":"3rd President of the Republic of Azerbaijan (1923–2003)","enwiki":"Heydar Aliyev","summary":"Heydar Alirza oghlu Aliyev (10 May 1923 – 12 December 2003) was an Azerbaijani politician who was a Soviet party boss in the Azerbaijan Soviet Socialist Republic from 1969 to 1982, and the third president of Azerbaijan from 1993 to 2003.\nHe was a high-ranking official in the KGB of the Azerbaijan SSR, serving for 28 years in Soviet state security organs (1941–1969). He governed Soviet Azerbaijan from 1969 to 1982 as First Secretary of the Communist Party of Azerbaijan. He held the post of First Deputy Premier of the Soviet Union from 1982 to 1987.","image":"Heydar Aliyev (crop).jpg","birth":1923.3534246575343,"death":2003.945205479452},"Q319912":{"label":"Abulfaz Elchibey","description":"2nd President of the Republic of Azerbaijan","enwiki":"Abulfaz Elchibey","summary":"Abulfaz Gadirgulu oghlu Aliyev (Azerbaijani: Əbülfəz Qədirqulu oğlu Əliyev, 24 June 1938 – 22 August 2000), commonly known as Abulfaz Elchibey, was a Azerbaijani nationalist and Soviet dissident who was the first, and as of today, only democratically elected president of post-Soviet Azerbaijan. He served from 17 June 1992 until his ouster in a 24 June 1993 military coup backed by Russia that led to the installation of Heydar Aliyev as president. \nAbulfaz Aliyev was the leader of the Azerbaijani Popular Front, assuming the nickname Abulfaz Elchibey. Elchibey played an important role in achieving Azerbaijan's independence from the Soviet Union.","image":"Abulfaz Elchibey in 2000.jpg","birth":1938.4767123287672,"death":2000.639344262295},"Q344034":{"label":"Isa Gambar","description":"Azerbaijani politician (born 1957)","enwiki":"Isa Gambar","summary":"Isa Yunis oghlu Gambar (Azerbaijani: İsa Yunis oğlu Qəmbər), also known as Isa Gambar (born February 24, 1957), is an Azerbaijani politician and leader of the Equality Party (Müsavat), one of the opposition blocs in Azerbaijan. He was elected a member of parliament in 1990 and was elected parliamentary speaker in 1992.\nA prominent opposition figure in Azerbaijan, Gambar was blocked from contesting elections by Azerbaijani ruler Heydar Aliyev. Aliyev stripped Gambar of parliamentary immunity and had him arrested when he criticized Aliyev's power grab in 1993.","image":"Isa Gambar in May 2024 (cropped).jpg","birth":1957.1479452054793,"death":null},"Q355850":{"label":"Ayaz Mutallibov","description":"President of Azerbaijan from 1990 to 1992","enwiki":"Ayaz Mutallibov","summary":"Ayaz Niyazi oghlu Mutallibov (12 May 1938 – 27 March 2022) was an Azerbaijani politician who served as the first president of Azerbaijan. He was the last leader of Soviet Azerbaijan, and first President of Azerbaijan from 18 May 1990 until 6 March 1992 and from 14 May until 18 May 1992.\nHe rose through the ranks of the Azerbaijan Communist Party during Soviet Azerbaijan before becoming leader of the party in 1990. Later that year,  the Supreme Soviet of Azerbaijan SSR elected Mutallibov as the first President of Azerbaijan SSR. In September 1991, amid the collapse of the Soviet Union and independence of Azerbaijan, Mutallibov declared himself President of Azerbaijan in an uncontested election.","image":"Ayaz Mutallibov in 2020 (cropped).jpg","birth":1938.358904109589,"death":2022.2328767123288},"Q101557330":{"label":"Fariz Najafov","description":"Azerbaijani karateka and military officer, president of Gabala Sports Club","enwiki":"Fariz Najafov","summary":"Fariz Abdulla oglu Najafov (Azerbaijani: Fariz Abdulla oğlu Nəcəfov; born 1 June 1978) is an Azerbaijani karateka, serving as the President of Gabala Sports Club. As an officer serving in the Azerbaijani Armed Forces, he fought in the 2020 Nagorno-Karabakh war.","image":null,"birth":1978.4136986301369,"death":null}},"media":{"Flag of Azerbaijan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/dd/Flag_of_Azerbaijan.svg/330px-Flag_of_Azerbaijan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Azerbaijan.svg","author":"SKopp and others","license":"Public domain"},"Emblem of Azerbaijan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/Emblem_of_Azerbaijan.svg/330px-Emblem_of_Azerbaijan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Azerbaijan.svg","author":"Original:  BetacommandBot Vector:  Zscout370","license":"Public domain"},"Ilham Aliyev, December 2025 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2a/Ilham_Aliyev%2C_December_2025_%28cropped%29.jpg/330px-Ilham_Aliyev%2C_December_2025_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wik