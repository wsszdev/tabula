alue_label":"Henk Chin A Sen","from_t":1980.1748633879781,"to_t":1982.0931506849315,"title":"President of Suriname","property":"P39","retrieved":"2026-10-30","vl":"Henk Chin A Sen"},{"qid":"Q730","kind":"ruler","value_qid":"Q730036","value_label":"Ramsewak Shankar","from_t":1988.0655737704917,"to_t":1990.978082191781,"title":"President of Suriname","property":"P39","retrieved":"2026-10-30","vl":"Ramsewak Shankar"},{"qid":"Q730","kind":"ruler","value_qid":"Q739964","value_label":"Johan Kraag","from_t":1990.9917808219177,"to_t":1991.7068493150684,"title":"President of Suriname","property":"P39","retrieved":"2026-10-30","vl":"Johan Kraag"},{"qid":"Q730","kind":"ruler","value_qid":"Q887828","value_label":"Fred Ramdat Misier","from_t":1982.0849315068492,"to_t":1988.0846994535518,"title":"President of Suriname","property":"P39","retrieved":"2026-10-30","vl":"Fred Ramdat Misier"},{"qid":"Q730","kind":"flag","value_qid":"Q180725","value_label":"Flag of Suriname.svg","from_t":1975.8986301369864,"to_t":null,"title":"flag of Suriname","property":"P163","retrieved":"2026-10-30","vl":"flag of Suriname"}],"people":{"Q440403":{"label":"Jennifer Geerlings-Simons","description":"Surinamese physician and politician","enwiki":"Jennifer Geerlings-Simons","summary":"Jennifer Geerlings-Simons (née  Simons; born 5 September 1953) is a Surinamese politician and former physician who is serving as the eleventh president of Suriname since 16 July 2025. A member of the National Democratic Party (NDP), she has been the party's president since 2024.\nGeerlings-Simons began her career as a physician, working as a dermatologist, and later in the National HIV/AIDS program. In 1996, she joined politics and was elected to the National Assembly in the general elections.","image":"Jennifer Geerlings-Simons, November 2025.jpg","birth":1953.676712328767,"death":null},"Q299020":{"label":"Ronald Venetiaan","description":"Surinamese politician (1936–2025)","enwiki":"Ronald Venetiaan","summary":"Ronald Runaldo Venetiaan (18 June 1936 – 5 November 2025) was a Surinamese politician who served as President of Suriname between 1991 and 1996, and between 2000 and 2010.","image":"Ronald Venetiaan.jpg","birth":1936.4617486338798,"death":2025.8438356164384},"Q333129":{"label":"Johan Ferrier","description":"Dutch-Surinamese politician (1910-2010)","enwiki":"Johan Ferrier","summary":"Johan Henri Eliza Ferrier (Dutch pronunciation: [ˈjoːɦɑn fɛrˈjeː]; 12 May 1910 – 4 January 2010) was a Surinamese politician who served as the first president of Suriname from 1975 to 1980. He was also the country's last governor-general before independence, serving from 1968 to 1975, before becoming the first president upon independence from the Kingdom of the Netherlands in 1975 and also served as the fifth prime minister from 1955 to 1958.\nHe was named the twentieth century's most important politician in Suriname in 1999.","image":"JohanFerrier.jpg","birth":1910.358904109589,"death":2010.0082191780823},"Q333135":{"label":"Chan Santokhi","description":"President of Suriname from 2020 to 2025","enwiki":"Chan Santokhi","summary":"Chandrikapersad \"Chan\" Santokhi (Dutch: [tɕɑnˈdrikaːpɛrˌsɑt sɑnˈtɔki]; Sarnami: चंद्रिकापेर्साद संतोखी, pronounced [cⁿd̪rikɑːpərəsɑːd̪ə sⁿt̪oːkʰiː]; 3 February 1959 – 30 March 2026) was a Surinamese politician and police officer who served as the ninth president of Suriname from 2020 to 2025. After winning the 2020 elections, Santokhi was the sole nominee for president of Suriname. On 13 July, Santokhi was elected president by acclamation in an uncontested election. He was inaugurated on 16 July.","image":"Чандрикаперсад Сантохи (cropped).jpg","birth":1959.0904109589042,"death":2026.2410958904109},"Q380734":{"label":"Jules Wijdenbosch","description":"Surinamese politician","enwiki":"Jules Wijdenbosch","summary":"Jules Albert Wijdenbosch (2 May 1941 – 30 April 2025) was a Surinamese politician who served as the 7th President of Suriname from 1996 to 2000. Prior to his presidency he was Prime Minister of Suriname from 1987 to 1988, and the 2nd Vice President of Suriname in 1991.","image":"JulesWijdenbosch2017.jpg","birth":1941.331506849315,"death":2025.3260273972603},"Q57667":{"label":"Desi Bouterse","description":"leader of Suriname (1980–1987, 2010–2020)","enwiki":"Dési Bouterse","summary":"Desiré \"Dési\" Delano Bouterse (13 October 1945 – 23 December 2024) was a Surinamese military officer, politician and revolutionary who served as the eighth president of Suriname from 2010 to 2020, having previously led the country twice after a coup as a military leader from 1980 to 1987 and again from 1990 to 1991. He was the founding president of the National Democratic Party (NDP) from 1987 to 2024.\nBouterse was a controversial figure, held responsible by some for numerous human rights violations committed during his military rule in the 1980s. Most notable were the December murders in 1982.","image":"Дези Баутерсе.jpg","birth":1945.7808219178082,"death":2024.9754098360656},"Q584322":{"label":"Henk Chin A Sen","description":"President of Suriname (1934–1999)","enwiki":"Henk Chin A Sen","summary":"Hendrik Rudolf \"Henk\" Chin A Sen (Chinese: 陳亞先; 18 January 1934 – 11 August 1999) was a Surinamese politician who served as the President of Suriname from 15 August 1980 until 4 February 1982.","image":"H.Chin A Sen.jpg","birth":1934.0465753424658,"death":1999.6082191780822},"Q730036":{"label":"Ramsewak Shankar","description":"4th President of Suriname","enwiki":"Ramsewak Shankar","summary":"Ramsewak Shankar (born 6 November 1937) is a Surinamese politician who was the 4th President of Suriname, serving from 1988 to 1990. His government was overthrown by Dési Bouterse leading a bloodless military coup. Shankar had previously served as Agriculture & Fisheries Minister from 1969 to 1971.\nShankar is a member of the large ethnic South Asian community in Suriname.","image":"Ramsewak Shankar 2023.jpeg","birth":1937.8465753424657,"death":null},"Q739964":{"label":"Johan Kraag","description":"President of Suriname (1913–1996)","enwiki":"Johan Kraag","summary":"Johannes Samuel Petrus \"Johan\" Kraag (29 July 1913 – 24 May 1996) was a Surinamese politician who served as the President of Suriname from 29 December 1990, until 16 September 1991.","image":"Minister van Sociale Zaken van Suriname dhr Kraag voor besprekingen in Holland , Bestanddeelnr 915-4476 (cropped).jpg","birth":1913.572602739726,"death":1996.3934426229507},"Q887828":{"label":"Fred Ramdat Misier","description":"President of Suriname (1926–2004)","enwiki":"Fred Ramdat Misier","summary":"Lachmipersad Frederik \"Fred\" Ramdat Misier (28 October 1926 – 25 June 2004) was the 3rd President of Suriname, serving from 1982 to 1988.","image":"L.F.Ramdat Misier.jpg","birth":1926.8219178082193,"death":2004.48087431694}},"media":{"Flag of Suriname (1959–1975).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8f/Flag_of_Suriname_%281959%E2%80%931975%29.svg/330px-Flag_of_Suriname_%281959%E2%80%931975%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Suriname_(1959%E2%80%931975).svg","author":"Mysid","license":"Public domain"},"Coat of arms of Dutch colony of Surinam.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c9/Coat_of_arms_of_Dutch_colony_of_Surinam.svg/330px-Coat_of_arms_of_Dutch_colony_of_Surinam.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Dutch_colony_of_Surinam.svg","author":"Samhanin","license":"CC BY-SA 3.0"},"Coat of arms of Suriname (1959-1975).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Coat_of_arms_of_Suriname_%281959-1975%29.svg/330px-Coat_of_arms_of_Suriname_%281959-1975%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikim