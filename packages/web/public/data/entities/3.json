{"entity":{"id":"cs:115","name":"Surinam","dataset":"cshapes","kind":"polity"},"territories":[{"id":10134,"name":"Surinam","set_id":"cs","class":"dependency","valid_from":1886,"valid_to":1954.9534246575342,"snapshot_held":0,"area_km2":144985,"border_precision":3,"capital_name":"Paramaribo","sovereign":null,"sovereign_note":null,"modern_name":"Surinam","min_lon":-58.0714,"min_lat":1.836245,"max_lon":-53.986118,"max_lat":6.001809,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=115;start=1886-1-1"},{"id":10135,"name":"Surinam","set_id":"cs","class":"polity","valid_from":1954.9534246575342,"valid_to":1975.8986301369864,"snapshot_held":0,"area_km2":144985,"border_precision":3,"capital_name":"Paramaribo","sovereign":null,"sovereign_note":null,"modern_name":"Surinam","min_lon":-58.0714,"min_lat":1.836245,"max_lon":-53.986118,"max_lat":6.001809,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=115;start=1954-12-15"},{"id":10136,"name":"Surinam","set_id":"cs","class":"republic","valid_from":1975.8986301369864,"valid_to":2020,"snapshot_held":0,"area_km2":144985,"border_precision":3,"capital_name":"Paramaribo","sovereign":null,"sovereign_note":null,"modern_name":"Surinam","min_lon":-58.0714,"min_lat":1.836245,"max_lon":-53.986118,"max_lat":6.001809,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=115;start=1975-11-25"}],"identities":[{"qid":"Q7646305","from_t":1886,"to_t":1954.9506849315069,"method":"name-label+date","confidence":0.95,"label":"Surinam","description":"Dutch plantation colony in the Guianas","inception":1667,"dissolved":1954.9506849315069,"enwiki":"Surinam (Dutch colony)","summary":"Surinam (Dutch: Suriname), also unofficially known as Dutch Guiana, was a Dutch plantation colony in the Guianas and the predecessor polity of the modern country of Suriname. It was bordered by the fellow Dutch colony of Berbice to the west, and the French colony of Cayenne to the east. It later bordered British Guiana (modern-day Guyana) from 1831 to 1966."},{"qid":"Q730","from_t":1975.8986301369864,"to_t":2020,"method":"name-template+date","confidence":0.9066697934571712,"label":"Suriname","description":"country in South America","inception":1975.8986301369864,"dissolved":null,"enwiki":"Suriname","summary":"Suriname,  officially the Republic of Suriname, is a country on the northern coast of South America, also considered part of the Caribbean region. Situated slightly north of the equator, over 90% of its territory is covered by rainforest, the second-highest proportion of forest cover in the world. Suriname is bordered by the Atlantic Ocean to the north, French Guiana to the east, Brazil to the south, and Guyana to the west. It is the smallest sovereign country in South America by both population and territory, with around 612,985 inhabitants in 2021 in an area of approximately 165,940 square kilometres (64,070 square miles)."}],"facts":[{"qid":"Q7646305","kind":"capital","value_qid":"Q656587","value_label":"Fort Zeelandia","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Fort Zeelandia"},{"qid":"Q7646305","kind":"official_language","value_qid":"Q7411","value_label":"Dutch","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Dutch"},{"qid":"Q7646305","kind":"language","value_qid":"Q7411","value_label":"Dutch","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Dutch"},{"qid":"Q7646305","kind":"successor","value_qid":"Q19901436","value_label":"Suriname","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Suriname"},{"qid":"Q7646305","kind":"flag","value_qid":null,"value_label":"Flag of Suriname (1959–1975).svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q7646305","kind":"coat","value_qid":null,"value_label":"Coat of arms of Dutch colony of Surinam.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved