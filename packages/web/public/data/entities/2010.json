nd":"successor","value_qid":"Q811","value_label":"Nicaragua","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Nicaragua"},{"qid":"Q6037274","kind":"successor","value_qid":"Q800","value_label":"Costa Rica","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Costa Rica"},{"qid":"Q6037274","kind":"successor","value_qid":"Q804","value_label":"Panama","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Panama"},{"qid":"Q6037274","kind":"successor","value_qid":"Q739","value_label":"Colombia","from_t":null,"to_t":null,"title":null,"property":"P1366","retrieved":"2026-10-30","vl":"Colombia"},{"qid":"Q6037274","kind":"flag","value_qid":null,"value_label":"Flag of Mosquitia.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null}],"people":{"Q7085689":{"label":"Oldman of Mosquito","description":"3rd King of the Mosquito Nation","enwiki":"Oldman (king)","summary":"Oldman (died 1687), King of the Mosquito Nation from c. 1650 until his death in 1687, was the son of a Miskito leader. This earlier king went to England, according to a memorial left in Jamaica by one of his descendants, during the reign of Charles I (1625–1649) but during the time when the Providence Island Company was operating in the region (c. 1631–1641).","image":null,"birth":null,"death":1687},"Q6181516":{"label":"Jeremy I of Mosquito","description":"4th King of the Mosquito Nation","enwiki":"Jeremy I","summary":"Jeremy I was king of the Mosquito Nation, who came to power following the death of his father, Oldman, in 1686 or 1687.  According to an English visitor, W. M., in 1699, he was about 60 years old at that time, making his birth year about 1639.","image":null,"birth":1639,"death":1718},"Q6181518":{"label":"Jeremy II of Mosquito","description":"5th King of the Mosquito Nation","enwiki":"Jeremy II","summary":"Jeremy II (c. 1639–1729) was King of the Miskitu Kingdom. Little is known about his reign, though he engaged in formal diplomatic agreements with the British colony of Jamaica.","image":null,"birth":1639,"death":1729},"Q5343588":{"label":"Edward of Mosquitia","description":"7th king of the Mosquito Nation","enwiki":"Edward of Mosquitia","summary":"Edward was king of Mosquitia from 1729 until 1755. He was the eldest son of Jeremy II, and was young when he took office.\nIn 1740 the Anglo-Spanish \"War of Jenkins' Ear\" broke out, and Great Britain was anxious to enlist the Miskitu on their side. To that end, Governor Edward Trelawny of Jamaica created an office of \"Superintendent of the Mosquito Shore\" and entrusted it to Robert Hodgson.","image":null,"birth":1721,"death":1755},"Q5540929":{"label":"George I of Mosquito","description":"8th King of the Mosquito Nation","enwiki":"George I (Miskito)","summary":"George I was king of Mosquitia from 1755 to 1776. He was brother of King Edward and son of Jeremy II and was chosen king because Edward's eldest son was still too young to rule.","image":null,"birth":null,"death":1777},"Q5540925":{"label":"George II of Mosquito","description":"9th King of the Mosquito Nation","enwiki":"George II Frederic","summary":"George II, also referred to as Young George, was a king of Mosquitia from 1776–1800.","image":null,"birth":1757,"death":1800},"Q113257860":{"label":"George Frederic of Mosquito","description":"10th King of the Mosquito Nation","enwiki":"George Frederic Augustus II","summary":"George Frederic Augustus II (1798 – 1824) was the King of Mosquitia from 1800 to 1824.","image":null,"birth":1798,"death":1824},"Q17145470":{"label":"Robert Charles Frederic","description":"11th King of the Mosquito Nation","enwiki":"Robert Charles Frederic","summary":"Robert Charles Frederic was king of Mosquitia from 1824 to 1842.","image":null,"birth":1778,"death":1841.7671232876712},"Q5536498":{"label":"George Augustus Frederic","description":"9th King of the Mosquito Nation","enwiki":"George Augustus Frederic","summary":"George Augustus Frederic was king of Mosquitia from 1845 to 1864. He ruled at a time when the kingdom was subject to international rivalry.","image":"George Augustus Frederic oval portrait.png","birth":1833,"death":1865}},"media":{"Flag of Mosquitia.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Flag_of_Mosquitia.svg/330px-Flag_of_Mosquitia.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Mosquitia.svg","author":"Original: Unknown Vector:  Meandmybrix","license":"CC BY-SA 4.0"},"George Augustus Frederic oval portrait.png":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d7/George_Augustus_Frederic_oval_portrait.png/330px-George_Augustus_Frederic_oval_portrait.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:George_Augustus_Frederic_oval_portrait.png","author":"AnonymousUnknown author","license":"Public domain"}},"names":["Costa de Mosquito","Kingdom of Mosquitia","Królestwo Mosquitii","Königreich Mosquitia","Königreich der Moskitos","Mosquitia","Mosquito Coast","Mosquito Kingdom","Mosquito Shore","Mosquito Territory","Nación Misquita","Nação Misquita","Regno di Mosquizia","Reino da Mosquita","Reino de Mosquitia","Royaume de Mosquitia","Королевство Москития","مملكة موسكيتيا","ミスキート王国"]}