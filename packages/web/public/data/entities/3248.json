ax_lat":-31.672083,"source_file":"world_1783.geojson","source_row":null},{"id":7507,"name":"Wiradjuri","set_id":"hb_1800","class":"culture","valid_from":1800,"valid_to":1815,"snapshot_held":1,"area_km2":182039.59486119912,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Australia","min_lon":144.228515,"min_lat":-36.120127,"max_lon":150.117187,"max_lat":-31.672083,"source_file":"world_1800.geojson","source_row":null}],"identities":[{"qid":"Q957298","from_t":1600,"to_t":1815,"method":"name-label, undated","confidence":0.5,"label":"Wiradjuri","description":"Indigenous Australian people including family groups and clans throughout central New South Wales.","inception":null,"dissolved":null,"enwiki":"Wiradjuri","summary":"The Wiradjuri people (Wiradjuri northern dialect pronunciation [wiraːjd̪uːraj]; Wiradjuri southern dialect pronunciation [wiraːjɟuːraj]) are a group of Aboriginal Australian people from central New South Wales, united by common descent through kinship and shared traditions. They survived as skilled hunter-fisher-gatherers, in family groups or clans, and many still use knowledge of hunting and gathering techniques as part of their customary life.\nIn the 21st century, major Wiradjuri groups live in Condobolin, Peak Hill, Narrandera and Griffith. There are significant populations at Wagga Wagga and Leeton and smaller groups at West Wyalong, Parkes, Dubbo, Forbes, Cootamundra, Darlington Point, Cowra and Young."}],"facts":[],"people":{},"media":{},"names":["Waradajhi","Waradgeri","Warandgeri","Werogery","Wiiratheri","Wira-Athoree","Wiradhuri","Wiradjuri","Wirraayjuurray","Вираджури","ウィラジュリ人"]}