min_lon":77.07118945935211,"min_lat":16.465319160725013,"max_lon":78.32174567760443,"max_lat":19.01271017525656,"source_file":"world_1650.geojson","source_row":null}],"identities":[{"qid":"Q669317","from_t":1527,"to_t":1619,"method":"name-template+date","confidence":0.871653971714902,"label":"Bidar Sultanate","description":"former country","inception":1527,"dissolved":1619,"enwiki":"Bidar Sultanate","summary":"The Bidar Sultanate was an early modern sultanate located in the central Deccan, ruled by the Barid Shahi dynasty. One of the five Deccan sultanates, its initial territory corresponded to that of one of the five provinces of the Bahmani Sultanate, and under the rule of Qasim Barid I in 1492 assumed de facto control of state affairs of the Bahmani Sultanate. \nLeadership passed to his sons; Amir Barid I in 1504 and Ali Barid Shah I in 1542. Starting from the 1580s as a result of Ali's death, a wave of successions occurred in the rulership of the dynasty which ended in 1609 under the last sultan, Amir Barid III. He was eventually defeated in 1619 by Ibrahim Adil Shah II of the Bijapur Sultanate, who annexed the territory of the Bidar Sultanate into his realm."}],"facts":[{"qid":"Q669317","kind":"capital","value_qid":"Q461922","value_label":"Bidar","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Bidar"},{"qid":"Q669317","kind":"official_religion","value_qid":"Q9585","value_label":"Shia Islam","from_t":null,"to_t":null,"title":null,"property":"P3075","retrieved":"2026-10-30","vl":"Shia Islam"},{"qid":"Q669317","kind":"government","value_qid":"Q184558","value_label":"absolute monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"absolute monarchy"}],"people":{},"media":{},"names":["Beridşahlar Sultanlığı","Bidar","Bidar Sultanate","Sultanat de Bidar","Sultanato de Bidar","Sultanato di Bidar","Бидарский султанат","بریدشاهیان","سلطنة بيدر","बिदार सल्तनत","ビーダル王国","比德爾蘇丹國"]}