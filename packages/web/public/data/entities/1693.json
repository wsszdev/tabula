lue_label":"Bounnhang Vorachit","from_t":2016.3005464480875,"to_t":2021.2191780821918,"title":"President of Laos","property":"P39","retrieved":"2026-10-30","vl":"Bounnhang Vorachit"},{"qid":"Q819","kind":"ruler","value_qid":"Q57444","value_label":"Choummaly Sayasone","from_t":2006.4328767123288,"to_t":2016.3005464480875,"title":"President of Laos","property":"P39","retrieved":"2026-10-30","vl":"Choummaly Sayasone"},{"qid":"Q819","kind":"ruler","value_qid":"Q58323","value_label":"Thongloun Sisoulith","from_t":2021.2191780821918,"to_t":null,"title":"President of Laos","property":"P39","retrieved":"2026-10-30","vl":"Thongloun Sisoulith"},{"qid":"Q819","kind":"ruler","value_qid":"Q878933","value_label":"Phoumi Vongvichit","from_t":1986.8301369863013,"to_t":1991.6191780821919,"title":"President of Laos","property":"P39","retrieved":"2026-10-30","vl":"Phoumi Vongvichit"},{"qid":"Q819","kind":"flag","value_qid":"Q46008","value_label":"Flag of Laos.svg","from_t":1945.7780821917809,"to_t":null,"title":"flag of Laos","property":"P163","retrieved":"2026-10-30","vl":"flag of Laos"}],"people":{"Q58323":{"label":"Thongloun Sisoulith","description":"General Secretary of the Lao People's Revolutionary Party","enwiki":"Thongloun Sisoulith","summary":"Thongloun Sisoulith (Lao: ທອງລຸນ ສີສຸລິດ; born 10 November 1945) is a Laotian politician and historian who serves as the general secretary of the Lao People's Revolutionary Party and the seventh president of Laos since 2021.\nThongloun was born and educated in Houaphanh province, before receiving education in Leningrad and Moscow in the Soviet Union. During the Laotian Civil War, he supported the Pathet Lao as a teacher. He then became the Deputy Minister of Foreign Affairs in 1987 which lasted to 1992, where he then served in other posts in government.","image":"Thongloun Sisoulith in Kazan - 2024 (cropped 2).jpg","birth":1945.8575342465754,"death":null},"Q104914585":{"label":"Sonexay Siphandone","description":"Laotian politician","enwiki":"Sonexay Siphandone","summary":"Sonexay Siphandone (born 26 January 1966) is a Laotian politician who has served as the president of the National Assembly of Laos since 5 October 2026. A member of the Lao People's Revolutionary Party (LPRP), he previously served as the prime minister of Laos from 30 December 2022 to 5 October 2026 and as the deputy prime minister from 2016 to 2022. He is the son of former LPRP Chairman and former president Khamtai Siphandone.","image":"Sonexay Siphandone 10 June 2026.jpg","birth":1966.0684931506848,"death":null},"Q320100":{"label":"Kaysone Phomvihane","description":"first General Secretary of the Lao People's Revolutionary Party (r. 1955-1992)","enwiki":"Kaysone Phomvihane","summary":"Kaysone Phomvihane (Lao: ໄກສອນ ພົມວິຫານ, pronounced [kàj.sɔ̌ːn pʰóm.wī(ʔ).hǎːn]; 13 December 1920 – 21 November 1992) was a Laotian politician and revolutionary who served as the first leader of the Communist Lao People's Revolutionary Party from 1955 until his death in 1992. After the Communists seized power in the wake of the Laotian Civil War, he was the de facto leader of Laos from 1975 until his death. He served as the first Prime Minister of the Lao People's Democratic Republic from 1975 to 1991 and then as the second President from 1991 to 1992. His theories and policies are officially known as Kaysone Phomvihane Thought.","image":"Kaysone Phomvihane 1978.jpg","birth":1920.948087431694,"death":1992.8879781420765},"Q320103":{"label":"Souphanouvong","description":"Laotian politician","enwiki":"Souphanouvong","summary":"Prince Souphanouvong (13 July 1909 – 9 January 1995; Lao: ສຸພານຸວົງ Lao pronunciation: [ˌsupʰaːˈnuʋoŋ]), nicknamed the Red Prince, was, alongside his half-brother Prince Souvanna Phouma and Prince Boun Oum of Champasak, one of the \"Three Princes\" who represented respectively the communist (pro-Vietnam), neutralist, and royalist political factions in Laos. He served as the President of Laos from December 1975 to October 1986.","image":"Souphanouvong1978.jpg","birth":1909.5287671232877,"death":1995.021917808219},"Q360138":{"label":"Khamtai Siphandone","description":"former Chairman of the Lao People's Revolutionary Party (1924–2025)","enwiki":"Khamtai Siphandone","summary":"General Khamtai Siphandone (Lao: ຄຳໄຕ ສີພັນດອນ; 8 February 1924 – 2 April 2025) was a Laotian politician who served as the chairman of the Lao People's Revolutionary Party from 1992 to 2006 and as the fourth president of Laos from 1998 to 2006, when he was replaced by Choummaly Sayasone. He joined the Indochinese Communist Party in 1954 and became a member of the Central Committee of the Lao People's Revolutionary Party in 1956.","image":"The Prime Minister, Dr. Manmohan Singh meeting with the President of Laos, Mr. Khamtay Siphandone at Vientiane in Laos on November 29, 2004 (cropped).jpg","birth":1924.103825136612,"death":2025.2493150684932},"Q380421":{"label":"Nouhak Phoumsavanh","description":"Lao politician (1910-2008)","enwiki":"Nouhak Phoumsavanh","summary":"Nouhak Phoumsavanh or Phoumsavan (Lao: ໜູຮັກ ພູມສະຫວັນ; Thai: หนูฮัก พูมสะหวัน; 9 April 1914– 9 September 2008) was a long time Pathet Lao revolutionary and communist party official who was the 3rd President of Laos, serving from 1992 to 1998.","image":"Nouhak Phoumsavanh 1950.jpg","birth":1914.268493150685,"death":2008.688524590164},"Q470024":{"label":"Bounnhang Vorachit","description":"General Secretary of the Lao People's Revolutionary Party (2016-2021)","enwiki":"Bounnhang Vorachit","summary":"Bounnhang Vorachit (Lao: ບຸນຍັງ ວໍລະຈິດ; born 15 August 1937) is a Laotian politician. He was previously General Secretary of the Lao People's Revolutionary Party and President of Laos from 2016 to 2021.","image":"Bounnhang Vorachit.JPG","birth":1937.6191780821919,"death":null},"Q57444":{"label":"Choummaly Sayasone","description":"former General Secretary of the Lao People's Revolutionary Party","enwiki":"Choummaly Sayasone","summary":"Lieutenant General Choummaly Sayasone (Lao: ຈູມມະລີ ໄຊຍະສອນ; born 6 March 1936) is a Laotian politician who was General Secretary (supreme leader) of the Lao People's Revolutionary Party (LPRP) and President of Laos (head of state) from 2006 to 2016.","image":"Choummaly Sayasone in Russia (cropped).jpg","birth":1936.1775956284152,"death":null},"Q878933":{"label":"Phoumi Vongvichit","description":"President of Laos (1909–1994)","enwiki":"Phoumi Vongvichit","summary":"Phoumi Vongvichit (Phumi Wongwichit; Lao: ພູມີ ວົງວິຈິດ; 6 April 1909 – 7 January 1994) was a leading figure of the Pathet Lao and an elder statesman of the Lao People's Democratic Republic.","image":"Phoumi Vongvichit of Laos.jpg","birth":1909.2602739726028,"death":1994.0164383561644}},"media":{"Flag of Laos.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/56/Flag_of_Laos.svg/330px-Flag_of_Laos.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Laos.svg","author":"SKopp","license":"Public domain"},"Emblem of Laos (1991-2025).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Emblem_of_Laos_%281991-2025%29.svg/330px-Emblem_of_Laos_%281991-2025%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Laos_(1991-2025).svg","author":"DTR","license":"Public domain"},"Thongloun Sisoulith in Kazan - 2024 (cropped 2).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Thongloun_Sisoulith_in_Kazan_-_2024_%28cropped_2%29.jpg/330px-Thongloun_Sisoulith_in_Kazan_-_2024_%28cropped_2%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Thongloun_Sisoulith_in_Kazan_-_2024_(cropped_2).jpg","author":"Press Service of the President of the Republic of Azerbaijan","license":"CC BY 4.0"},"Sonexay Siphandone 10 June 2026.jpg":{"url":"https:/