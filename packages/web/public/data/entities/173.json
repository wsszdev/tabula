{"entity":{"id":"cs:681","name":"Aden","dataset":"cshapes","kind":"polity"},"territories":[{"id":10613,"name":"Aden","set_id":"cs","class":"dependency","valid_from":1937.2465753424658,"valid_to":1962.2547945205479,"snapshot_held":0,"area_km2":46416.1,"border_precision":3,"capital_name":"Aden","sovereign":null,"sovereign_note":null,"modern_name":"Yemen (Arab Republic of Yemen)","min_lon":43.461939,"min_lat":12.594654,"max_lon":47.394437,"max_lat":16.030035,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=681;start=1937-4-1"}],"identities":[{"qid":"Q49910","from_t":1937.2465753424658,"to_t":1962.2547945205479,"method":"name-alias+date","confidence":0.8205319312575572,"label":"Colony of Aden","description":"1937-1967 UK possession on the Arab Peninsula","inception":1937,"dissolved":1963.0465753424658,"enwiki":"Aden Colony","summary":"Aden Colony (Arabic: مُسْتْعَمَرَةْ عَدَنْ, romanised: Musta'marat 'Adan) was a crown colony of the United Kingdom from 1937 to 1963 located in the southern part of modern-day Yemen. It consisted of the port city of Aden and also included the outlying islands of Kamaran, Perim and the Khuria Muria archipelago with a total area of 192 km2 (74 sq mi). Initially a key port for the British East India Company, it was annexed by the British in 1839 to secure maritime routes and prevent piracy in the Arabian Sea. Its strategic position at the entrance to the Red Sea made it a vital stopover for ships traveling between Europe, India, and the Far East, especially after the opening of the Suez Canal in 1869."}],"facts":[{"qid":"Q49910","kind":"capital","value_qid":"Q131694","value_label":"Aden","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Aden"},{"qid":"Q49910","kind":"official_language","value_qid":"Q13955","value_label":"Arabic","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Arabic"},{"qid":"Q49910","kind":"official_language","value_qid":"Q1860","value_label"