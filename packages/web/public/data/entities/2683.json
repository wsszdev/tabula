d":"predecessor","value_qid":"Q1120363","value_label":"French Community","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"French Community"},{"qid":"Q1041","kind":"flag","value_qid":null,"value_label":"Flag of Senegal.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q1041","kind":"coat","value_qid":null,"value_label":"Coat of arms of Senegal (official version).svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q1041","kind":"ruler","value_qid":"Q106963","value_label":"Abdoulaye Wade","from_t":2000.2486338797814,"to_t":2012.2513661202186,"title":"President of Senegal","property":"P39","retrieved":"2026-10-30","vl":"Abdoulaye Wade"},{"qid":"Q1041","kind":"ruler","value_qid":"Q154545","value_label":"Léopold Sédar Senghor","from_t":1960.6803278688524,"to_t":1980.9972677595629,"title":"President of Senegal","property":"P39","retrieved":"2026-10-30","vl":"Léopold Sédar Senghor"},{"qid":"Q1041","kind":"ruler","value_qid":"Q219728","value_label":"Abdou Diouf","from_t":1981,"to_t":2000.2486338797814,"title":"President of Senegal","property":"P39","retrieved":"2026-10-30","vl":"Abdou Diouf"},{"qid":"Q1041","kind":"ruler","value_qid":"Q57438","value_label":"Macky Sall","from_t":2012.2513661202186,"to_t":2024.2513661202186,"title":"President of Senegal","property":"P39","retrieved":"2026-10-30","vl":"Macky Sall"},{"qid":"Q1041","kind":"flag","value_qid":"Q134933","value_label":"Flag of Senegal.svg","from_t":1960.6338797814208,"to_t":null,"title":"flag of Senegal","property":"P163","retrieved":"2026-10-30","vl":"flag of Senegal"}],"people":{"Q124382437":{"label":"Bassirou Diomaye Faye","description":"President of Senegal since 2024","enwiki":"Bassirou Diomaye Faye","summary":"Bassirou Diomaye Diakhar Faye (born 25 March 1980), also known mononymously as Diomaye, is a Senegalese politician and former tax official who is serving as the fifth and current president of Senegal since 2024. He was previously the general secretary of PASTEF, and won the 2024 Senegalese presidential election in place of disqualified candidate Ousmane Sonko, whom he later appointed as prime minister.","image":"Bassirou Diomaye Faye 9 juillet 2025 Washington DC (cropped).jpg","birth":1980.2295081967213,"death":null},"Q106963":{"label":"Abdoulaye Wade","description":"3rd President of Senegal","enwiki":"Abdoulaye Wade","summary":"Abdoulaye Wade (French pronunciation: [abdulaj wad], Wolof: Abdulaay Wàdd; born 29 May 1926) is a Senegalese politician who served as the third president of Senegal from 2000 to 2012. He is also the Secretary-General of the Senegalese Democratic Party (PDS), having led the party since it was founded in 1974. Assuming office at 73, Wade was the oldest person to occupy the post. \nA long-time opposition leader, Wade ran for president four times, beginning in 1978, before he was finally elected in the year 2000.","image":"Abdoulaye Wade 2011.jpg","birth":1926.4054794520548,"death":null},"Q154545":{"label":"Léopold Sédar Senghor","description":"first president of Senegal, poet, and cultural theorist (1906–2001)","enwiki":"Léopold Sédar Senghor","summary":"Léopold Sédar Senghor ( song-GOR, French: [leɔpɔl sedaʁ sɑ̃ɡɔʁ], Wolof: Léwopóol Sedaar Seŋoor; 9 October 1906 – 20 December 2001) was a Senegalese politician, cultural theorist and poet who served as the first president of Senegal from 1960 to 1980.\nIdeologically an African socialist, Senghor was one of the major theoreticians of Négritude. He was a proponent of African culture, black identity, and African empowerment within the framework of French-African ties. He advocated for the extension of full civil and political rights for France's African territories while arguing that French Africans would be better off within a federal French structure than as independent nation-states.","image":"Léopold Sédar Senghor.jpg","birth":1906.7698630136986,"death":2001.9671232876713},"Q219728":{"label":"Abdou Diouf","description":"Senegalese President","enwiki":"Abdou Diouf","summary":"Abdou Diouf (US:   AHB-doo dee-OOF; Serer: Abdu Juuf; born 7 September 1935) is a Senegalese politician who was the second president of Senegal from 1981 to 2000.\nDiouf is notable both for coming to power by peaceful succession and leaving willingly after losing the 2000 presidential election to long-time opposition-leader Abdoulaye Wade. He was also the second Secretary-General of the Organisation internationale de la Francophonie from January 2003 to December 2014.","image":"Abdou Diouf.jpg","birth":1935.682191780822,"death":null},"Q57438":{"label":"Macky Sall","description":"4th President of Senegal, formerly Prime Minister","enwiki":"Macky Sall","summary":"Macky Sall (French pronunciation: [maki sal], Wolof: Maki Sàll, Pulaar: 𞤃𞤢𞤳𞤭 𞤅𞤢𞤤‎, romanized: Maki Sal; born 11 December 1961) is a Senegalese politician who served as the fourth president of Senegal from 2012 to 2024. He was the eighth prime minister from 2004 to 2007, under President Abdoulaye Wade and was president of the National Assembly from 2007 to 2008.\nSall served as the Mayor of Fatick from 2002 to 2008 and held that post again from 2009 to 2012. He was a long-time member of the Senegalese Democratic Party (PDS).","image":"Macky Sall with Obamas 2014 (cropped).jpg","birth":1961.9424657534246,"death":null}},"media":{"Flag of France.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Flag_of_France.svg/330px-Flag_of_France.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_France.svg","author":"Original: Unknown Vector:  SKopp","license":"Public domain"},"Flag of Senegal.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fd/Flag_of_Senegal.svg/330px-Flag_of_Senegal.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Senegal.svg","author":"Original upload by Nightstallion","license":"Public domain"},"Coat of arms of Senegal (official version).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Coat_of_arms_of_Senegal_%28official_version%29.svg/330px-Coat_of_arms_of_Senegal_%28official_version%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Senegal_(official_version).svg","author":"Government of Senegal","license":"Public domain"},"Bassirou Diomaye Faye 9 juillet 2025 Washington DC (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/2f/Bassirou_Diomaye_Faye_9_juillet_2025_Washington_DC_%28cropped%29.jpg/330px-Bassirou_Diomaye_Faye_9_juillet_2025_Washington_DC_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Bassirou_Diomaye_Faye_9_juillet_2025_Washington_DC_(cropped).jpg","author":"The White House (Official White House Photo by Molly Riley); cropped by Brühl","license":"Public domain"},"Abdoulaye Wade 2011.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d2/Abdoulaye_Wade_2011.jpg/330px-Abdoulaye_Wade_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Abdoulaye_Wade_2011.jpg","author":"Prime Minister's Office","license":"GODL-India"},"Léopold Sédar Senghor.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/a/a8/L%C3%A9opold_S%C3%A9dar_Senghor.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:L%C3%A9opold_S%C3%A9dar_Senghor.jpg","author":"Bundesarchiv_B_145_Bild-F011981-0003,_Frankfurt-Main,_Staatspräsident_von_Senegal.jpg: Steiner, Egon\nderivative work: RoyFocker 12 (talk)","license":