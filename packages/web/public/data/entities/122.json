at","value_qid":null,"value_label":"Emblem of Eritrea (or argent azur).svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q986","kind":"ruler","value_qid":"Q57348","value_label":"Isaias Afwerki","from_t":1993.3780821917808,"to_t":null,"title":"President of Eritrea","property":"P39","retrieved":"2026-10-30","vl":"Isaias Afwerki"},{"qid":"Q986","kind":"flag","value_qid":"Q170555","value_label":"Flag of Eritrea.svg","from_t":1995.9260273972602,"to_t":null,"title":"flag of Eritrea","property":"P163","retrieved":"2026-10-30","vl":"flag of Eritrea"}],"people":{"Q57348":{"label":"Isaias Afwerki","description":"president of Eritrea since 1993","enwiki":"Isaias Afwerki","summary":"Isaias Afwerki (Tigrinya: ኢሳይያስ ኣፍወርቂ, pronounced [isajas afwɐrkʼi],  ; born 2 February 1946) is an Eritrean politician who has served as the president of Eritrea since its independence in 1993 and the chairman of the People's Front for Democracy and Justice (PFDJ) since 1994.\nIsaias joined the pro-independence Eritrean Liberation Front in 1967 and quickly rose through the ranks to become its leader in 1970, before defecting to form the Eritrean People's Liberation Front (EPLF). Having consolidated power within this group, he led pro-independence forces to victory on 24 May 1991, ending the 30-year-old war for independence from Ethiopia, before being elected president of the newly founded country of Eritrea two years later.\nWestern scholars and historians have long considered Isaias to be a totalitarian leader, with Eritrea's constitution remaining unenforced, electoral institutions effectively being nonexistent, and a policy of mass conscription.","image":"Ambassador Nura Abba Rimi & President Isaias Afwerki of Eritrea (cropped).jpg","birth":1946.0876712328768,"death":null}},"media":{"Flag of Eritrea.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/29/Flag_of_Eritrea.svg/330px-Flag_of_Eritrea.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Eritrea.svg","author":"Unknown authorUnknown author","license":"Public domain"},"Emblem of Eritrea (or argent azur).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Emblem_of_Eritrea_%28or_argent_azur%29.svg/330px-Emblem_of_Eritrea_%28or_argent_azur%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Eritrea_(or_argent_azur).svg","author":"SanchoPanzaXXI","license":"Public domain"},"Ambassador Nura Abba Rimi & President Isaias Afwerki of Eritrea (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Ambassador_Nura_Abba_Rimi_%26_President_Isaias_Afwerki_of_Eritrea_%28cropped%29.jpg/330px-Ambassador_Nura_Abba_Rimi_%26_President_Isaias_Afwerki_of_Eritrea_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Ambassador_Nura_Abba_Rimi_%26_President_Isaias_Afwerki_of_Eritrea_(cropped).jpg","author":"Foreign Affairsng","license":"CC BY-SA 2.0"}},"names":["Eritre","Eritrea","Eritreia","Ertrā","Erythraea","Erythrée","Erytrea","Estado da Eritreia","Estado de Eritrea","Iritriyyā","Iritriyā","Staat Eritrea","State of Eritrea","er","Érythrée","État d'Érythrée","Ερυθραία","Κράτος της Ερυθραίας","Государство Эритрея","Эритрея","إرتريا","إريتريا","ارتريا","اریتره","دولة إرتريا","دولة إريتريا","इरित्रिया","エリトリア","エリトリア国","エリトレア","厄利垂亞","厄立特里亚","厄立特里亞"]}