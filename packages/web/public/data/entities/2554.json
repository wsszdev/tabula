der_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Rumania","min_lon":20.31473449191211,"min_lat":43.74307592959766,"max_lon":29.7107649179375,"max_lat":48.275531373933596,"source_file":"world_1994.geojson","source_row":null},{"id":9770,"name":"Romania","set_id":"hb_2000","class":"republic","valid_from":2000,"valid_to":2010,"snapshot_held":1,"area_km2":231732.13548016787,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Rumania","min_lon":20.31473449191211,"min_lat":43.74307592959766,"max_lon":29.7107649179375,"max_lat":48.275531373933596,"source_file":"world_2000.geojson","source_row":null},{"id":9963,"name":"Romania","set_id":"hb_2010","class":"republic","valid_from":2010,"valid_to":2020,"snapshot_held":1,"area_km2":231732.13548016787,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Rumania","min_lon":20.31473449191211,"min_lat":43.74307592959766,"max_lon":29.7107649179375,"max_lat":48.275531373933596,"source_file":"world_2010.geojson","source_row":null}],"identities":[{"qid":"Q958291","from_t":1878,"to_t":1881.1972602739727,"method":"name-alias+date","confidence":0.8275358459280276,"label":"United Principalities of Moldavia and Wallachia","description":"1859–1881 personal union and early form of the modern Romanian state","inception":1859.0630136986301,"dissolved":1881.1972602739727,"enwiki":"United Principalities of Moldavia and Wallachia","summary":"The United Principalities of Moldavia and Wallachia (Romanian: Principatele Unite ale Moldovei și Țării Românești), commonly called United Principalities or Wallachia and Moldavia, was the personal union of the Principality of Moldavia and the Principality of Wallachia. The union was formed on 5 February [O.S. 24 January] 1859 when Alexandru Ioan Cuza was elected as the Domnitor (Ruling Prince) of both principalities. Their separate autonomous vassalage in the Ottoman Empire continued with the unification of both principalities. On 3 February [O.S. 22 January] 1862, Moldavia and Wallachia formally united to create the Romanian United Principalities or Romania the core of the Romanian nation state."},{"qid":"Q203493","from_t":1881.1972602739727,"to_t":1947,"method":"name-template+date","confidence":0.8951895684313359,"label":"Kingdom of Romania","description":"kingdom in Southeastern Europe between 1881 and 1947","inception":1881.1972602739727,"dissolved":1947,"enwiki":"Kingdom of Romania","summary":"The Kingdom of Romania (Romanian: Regatul României) was a constitutional monarchy that existed from 25 March [O.S. 13 March] 1881 with the crowning of prince Karl of Hohenzollern-Sigmaringen as King Carol I (thus beginning the Romanian royal family), until 30 December 1947 with the abdication of King Michael I and the Romanian Parliament proclamation of the Romanian People's Republic.\nFrom 1859 to 1877, Romania evolved from a personal union of two principalities: (Moldavia and Wallachia) called the Unification of Moldavia and Wallachia also known as \"The Little Union\" under a single prince to an autonomous principality with a Hohenzollern monarchy. The country gained its independence from the Ottoman Empire during the 1877–1878 Russo-Turkish War (known locally as the Romanian War of Independence), after which it was forced to cede the southern part of Bessarabia in exchange for Northern Dobruja. The kingdom's territory during the reign of King Carol I, between 13 (O.S.) / 25 March 1881 and 27 September (O.S.) / 10 October 1914 is sometimes referred to as the Romanian Old Kingdom, to distinguish it from \"Greater Romania\", which included the provinces that became part of the state after World War I (Bessarabia, Banat, Bukovina, and Transylvania)."},{"qid":"Q218","from_t":1947,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Romania","description":"country in Southeast Europe","inception":1330,"dissolved":null,"enwiki":"Romania","summary":"Romania is a country in Central and Southeastern Europe. It lies on the lower course of the Danube, north of the Balkan Peninsula, and on the northwestern shore of the Black Sea. It borders Ukraine to the north and east, Hungary to the west, Serbia to the southwest, Bulgaria to the south, Moldova to the east, and the Black Sea to the southeast. It is the twelfth-largest country in Europe by area, covering 238,397 km2 (92,046 mi2), and the sixth-most populous member state of the European Union, with 19 million inhabitants."}],"facts":[{"qid":"Q958291","kind":"capital","value_qid":"Q19660","value_label":"Bucharest","from_t":1859,"to_t":1881,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Bucharest"},{"qid":"Q958291","kind":"capital","value_qid":"Q46852","value_label":"Iași","from_t":1859,"to_t":1862,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Iași"},{"qid":"Q958291","kind":"official_language","value_qid":"Q7913","value_label":"Romanian","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Romanian"},{"qid":"Q958291","kind":"language","value_qid":"Q7918","value_label":"Bulgarian","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Bulgarian"},{"qid":"Q958291","kind":"language","value_qid":"Q188","value_label":"German","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"German"},{"qid":"Q958291","kind":"language","value_qid":"Q8798","value_label":"Ukrainian","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Ukrainian"},{"qid":"Q958291","kind":"language","value_qid":"Q7737","value_label":"Russian","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Russian"},{"qid":"Q958291","kind":"language","value_qid":"Q13201","value_label":"Romani","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Romani"},{"qid":"Q958291","kind"