,"source_row":null}],"identities":[{"qid":"Q1013","from_t":1966,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Lesotho","description":"sovereign state in southern Africa","inception":1966,"dissolved":null,"enwiki":"Lesotho","summary":"Lesotho (  lih-SOO-too; Sotho pronunciation: [lɪˈsʊːtʰʊ]), officially the Kingdom of Lesotho, is a landlocked country in Southern Africa. Surrounded by South Africa, it is the largest of the three sovereign, non-exclave enclaves in the world. Lesotho is located in the Maloti Mountains, with the highest peak in southern Africa. It has an area of over 30,000 km2 (11,600 mi2), with a population of about  2.3 million."}],"facts":[{"qid":"Q1013","kind":"ruler","value_qid":"Q57537","value_label":"Letsie III of Lesotho","from_t":1996.1010928961748,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Letsie III of Lesotho"},{"qid":"Q1013","kind":"ruler","value_qid":"Q114588964","value_label":"Sam Matekane","from_t":2022.8219178082193,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Sam Matekane"},{"qid":"Q1013","kind":"capital","value_qid":"Q3909","value_label":"Maseru","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Maseru"},{"qid":"Q1013","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"English"},{"qid":"Q1013","kind":"official_language","value_qid":"Q34340","value_label":"Sesotho","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Sesotho"},{"qid":"Q1013","kind":"language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"English"},{"qid":"Q1013","kind":"language","value_qid":"Q34340","value_label":"Sesotho","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","