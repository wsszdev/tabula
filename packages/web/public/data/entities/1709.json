m_t":1941.0739726027398,"to_t":1960.1939890710382,"title":"King of Lesotho","property":"P39","retrieved":"2026-10-30","vl":"Mantsebo Amelia 'Matsaba"},{"qid":"Q1013","kind":"ruler","value_qid":"Q459286","value_label":"Mamohato of Lesotho","from_t":1996,"to_t":1996.0846994535518,"title":"King of Lesotho","property":"P39","retrieved":"2026-10-30","vl":"Mamohato of Lesotho"},{"qid":"Q1013","kind":"ruler","value_qid":"Q459286","value_label":"Mamohato of Lesotho","from_t":1990.1616438356164,"to_t":1990.8328767123287,"title":"King of Lesotho","property":"P39","retrieved":"2026-10-30","vl":"Mamohato of Lesotho"},{"qid":"Q1013","kind":"ruler","value_qid":"Q459286","value_label":"Mamohato of Lesotho","from_t":1970.4136986301369,"to_t":1970.9150684931508,"title":"King of Lesotho","property":"P39","retrieved":"2026-10-30","vl":"Mamohato of Lesotho"},{"qid":"Q1013","kind":"flag","value_qid":"Q104969","value_label":"Flag of Lesotho.svg","from_t":2006.7561643835616,"to_t":null,"title":"flag of Lesotho","property":"P163","retrieved":"2026-10-30","vl":"flag of Lesotho"}],"people":{"Q57537":{"label":"Letsie III of Lesotho","description":"King of Lesotho since 1996","enwiki":"Letsie III","summary":"Letsie III (born Mohato Bereng Seeiso; 17 July 1963) is King of Lesotho. He succeeded his father, Bereng Seeiso Moshoeshoe II, who was forced into exile in 1990. His father was briefly restored in 1995 but died in a car crash in early 1996, so Letsie succeeded him again for a second reign. As a constitutional monarch, most of King Letsie's duties as monarch of Lesotho are ceremonial.","image":"Letsie III.jpg","birth":1963.5397260273974,"death":null},"Q114588964":{"label":"Sam Matekane","description":"Lesotho businessman and politician","enwiki":"Sam Matekane","summary":"Ntsokoane Samuel Matekane (born 15 March 1958) is a Mosotho businessman and politician who is the current Prime Minister of Lesotho since 2022. Prior to running, he was considered to be the richest person in the country. Matekane made his fortune in diamond mining, as well as through government issued construction contracts. He founded his company, Matekane Group of Companies (MGC) in 1986.","image":"Sam Matekane candidate (cropped).jpg","birth":1958.2,"death":null},"Q544951":{"label":"Moshoeshoe II of Lesotho","description":"King of Lesotho (1938-1996)","enwiki":"Moshoeshoe II of Lesotho","summary":"Moshoeshoe II (2 May 1938 – 15 January 1996), previously known as Constantine Bereng Seeiso, was Paramount Chief of Basutoland, succeeding Paramount Chief Seeiso from 1960 until the country gained full independence from Britain in 1966. He was King of Lesotho from 1966 until his exile in 1990, and from 1995 until his death in 1996.","image":"Moshoeshoe II van Lesotho.jpg","birth":1938.331506849315,"death":1996.0382513661202},"Q469775":{"label":"Moshoeshoe I","description":"King of Lesotho from 1822 to 1870","enwiki":"Moshoeshoe I","summary":"Moshoeshoe I () (c. 1786 – 11 March 1870) was the first king of Lesotho. He was the first son of Mokhachane, a minor chief of the Bamokoteli lineage, a branch of the Bakoena (crocodile) clan. In his youth, he helped his father gain power over some other smaller clans. In 1820, at the age of 34, Moshoeshoe succeeded his father as the Bamokoteli chief and formed his own clan.","image":"Moshoeshoe.jpg","birth":1786,"death":1870.1890410958904},"Q3236931":{"label":"Letsie I Moshoeshoe of Lesotho","description":"King of Lesotho","enwiki":"Letsie I Moshoeshoe of Lesotho","summary":"Letsie I (born Mohato; c. 1811 – 20 November 1891) was the paramount chief (morena e moholo) of the Basotho (modern Lesotho) from 11 March 1870 until his death. His reign bridged the late protectorate period, annexation to the Cape Colony (1871), the Basuto Gun War (1880–1881), and the restoration of direct British rule as the Crown colony of Basutoland in 1884.","image":null,"birth":1811,"death":1891.8849315068494},"Q3230251":{"label":"Lerotholi","description":"Lesotho chief","enwiki":"Lerotholi","summary":"Lerotholi Letsie (c. 1836–1905) was the paramount chief of Basotho (modern Lesotho) from November 20, 1891 to August 19, 1905. Letsie is one of the chiefs whom led the 1880 Basotho gun war which ended in basotho victory and independence for Lesotho.","image":null,"birth":1836,"death":1905.6301369863013},"Q3236929":{"label":"Letsie II Lerotholi","description":"Lesotho chief","enwiki":"Letsie II Lerotholi","summary":"Letsie II Lerotholi (Letsienyane) (1867–1913), paramount chief of Basotho (later Lesotho) from 1905 to 1913. Letsienyane was the son of Lerotholi. He became the ruler upon the death  of Lerotholi in 1905, but took little interest in government. He was succeeded by his brother, Nathaniel Griffith Lerotholi.","image":null,"birth":1867,"death":1913},"Q3336780":{"label":"Nathaniel Griffith Lerotholi","description":"Lesotho chief","enwiki":"Nathaniel Griffith Lerotholi","summary":"Nathaniel Griffith Lerotholi  (1870 – 23 June 1939) was the paramount chief of Basutoland from 11 April 1913 when he succeeded his brother Letsie II until his death in 1939. He was succeeded by his son Simon Seeiso Griffith.","image":null,"birth":1873,"death":1939},"Q3484447":{"label":"Seeiso of Basutoland","description":"King of Lesotho","enwiki":"Seeiso of Basutoland","summary":"Seeiso, full name Simon Seeiso Griffith (1905 – 26 December 1940) was the paramount chief of Basutoland from 23 June 1939 until his death. He was the father of King Moshoeshoe II of Lesotho and the paternal grandfather of king Letsie III of Lesotho.","image":null,"birth":1905,"death":1940.983606557377},"Q3093493":{"label":"Gabasheane Masupha","description":"King of Lesotho (1903-1941)","enwiki":"Gabasheane Masupha","summary":"Gabasheane Masupha (26 December 1903 - August 1949) was the Regent paramount chief of Lesotho (modern Basotho) from 1940 to 1941. Principal Chief of Ha-'Mamathe, Teya-teyaneng, Thupa-kubu and Jorotane. Died 1949; spouse  'Mamathe Masupha (nee. Nthati Justina Lebona).","image":null,"birth":1903.9835616438356,"death":1949.5808219178082},"Q2729899":{"label":"Mantsebo Amelia 'Matsaba","description":"Queen of Basutoland (1902–1964)","enwiki":"'Mantšebo","summary":"'Mantšebo (in full: 'Mantšebo Amelia 'Matšaba; 1902–1964) was the ruler of Basutoland (present-day Lesotho) from 1941 to 1960, as the regent for her stepson, the future Moshoeshoe II.\n'Mantšebo was the first of the three wives of Seeiso, who was paramount chief from 1939 to 1940. She was elected regent a month after his death, becoming the only female ruler during Lesotho's colonial period. Her early years in power were marked by disputes over both the legitimacy of her rule and her guardianship of her stepson (Seeiso's heir). However, 'Mantšebo retained the regency for over 19 years, and laid the foundations for Lesotho's current constitutional monarchy.","image":null,"birth":1902,"death":1964},"Q459286":{"label":"Mamohato of Lesotho","description":"Queen regnant of Lesotho (1941–2003)","enwiki":"'Mamohato Bereng Seeiso","summary":"'Mamohato Bereng Seeiso (née Princess Tabitha 'Masentle Lerotholi Mojela) (28 April 1941 – 6 September 2003) served as the Regent Head of State of Lesotho on three occasions: 5 June to 5 December 1970, 10 March to 12 November 1990 and 15 January to 7 February 1996.","image":null,"birth":1941.3205479452056,"death":2003.6794520547944}},"media":{"Flag of Lesotho.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Flag_of_Lesotho.svg/330px-Flag_of_Lesotho.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Lesotho.svg","author":"See File history below for details.","license":"Public domain"},"Coat of arms of Lesotho.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Coat_of_arms_of_Lesotho.svg/330px-Coat_of_arms_of_Lesotho.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Lesotho.svg","author":"Vectorised by user:Fenn-O-maniC","license":"Public domain"},"Letsie III.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Letsie_III.jpg/330px-Letsie_III.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Letsie_III.jpg","author":"IAEA Imagebank","license":"CC BY-SA 2.0"},"Sam Matekane candidate (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Sam_Matekane_candidate_%28cropped%29.jpg/330px-Sam_Matekane_candidate_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Sam_Matekane_candidate_(cropped).jpg","author":"European Union Election Observation Mission Lesotho 2022","license":"Attribution"},"Moshoeshoe II van Lesotho.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/14/Moshoeshoe_II_van_Lesotho.jpg/330px-Moshoeshoe_II_van_Lesotho.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Moshoeshoe_II_van_Lesotho.jpg","author":"Joost Evers / Anefo","license":"CC BY-SA 3.0 nl"},"Moshoeshoe.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/0/08/Moshoeshoe.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Moshoeshoe.jpg","author":null,"license":"Public domain"}},"names":["Basotholand","Kingdom of Lesotho","Koninkrijk Lesotho","LES","LS","LSO","Lesotho","Lesotho Krallığı","Lesothum","Lesoto","Regno del Lesotho","Reino de Lesotho","Reino de Lesoto","The Mountain Kingdom","le Royaume du Lesotho","ls","Βασίλειο του Λεσότο","Λεσότο","Королевство Лесото","Лесото","لسوتو","ليسوتو","مملكة ليسوتو","लेसोथो","レソト","レソト王国","莱索托","莱索托王国","萊索托","賴索托"]}