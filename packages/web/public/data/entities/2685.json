{"entity":{"id":"hb:serbia@1878","name":"Serbia","dataset":"basemaps","kind":"polity"},"territories":[{"id":8133,"name":"Serbia","set_id":"hb_1878","class":"kingdom","valid_from":1878,"valid_to":1880,"snapshot_held":1,"area_km2":51997.58638888781,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Serbia","min_lon":19.10715392550586,"min_lat":42.47009871676765,"max_lon":22.74236587008594,"max_lat":44.92278075417975,"source_file":"world_1878.geojson","source_row":null},{"id":8309,"name":"Serbia","set_id":"hb_1880","class":"kingdom","valid_from":1880,"valid_to":1900,"snapshot_held":1,"area_km2":51997.58638888757,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Serbia","min_lon":19.10715392550586,"min_lat":42.470098716767644,"max_lon":22.742365870085937,"max_lat":44.92278075417975,"source_file":"world_1880.geojson","source_row":null},{"id":8480,"name":"Serbia","set_id":"hb_1900","class":"kingdom","valid_from":1900,"valid_to":1914,"snapshot_held":1,"area_km2":51997.58638888743,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Serbia","min_lon":19.10715392550586,"min_lat":42.470098716767644,"max_lon":22.742365870085937,"max_lat":44.92278075417975,"source_file":"world_1900.geojson","source_row":null},{"id":8609,"name":"Serbia","set_id":"hb_1914","class":"kingdom","valid_from":1914,"valid_to":1918.9150684931508,"snapshot_held":1,"area_km2":95796.80986932585,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Serbia","min_lon":19.016753229705078,"min_lat":40.726790986970705,"max_lon":22.948493036833984,"max_lat":45.2643405,"source_file":"world_1914.geojson","source_row":null}],"identities":[{"qid":"Q684030","from_t":1878,"to_t":1882,"method":"name-template+date","confidence":0.8865207637567887,"label":"Principality of Serbia","description":"1815-1882 principality in Southeastern Europe","inception":1815,"dissolved":1882,"enwiki":"Principality of Serbia","summary":"The Principality of Serbia (Serbian: Књажество Србија, romanized: Knjažestvo Srbija) was an autonomous, later sovereign state in the Balkans that came into existence as a result of the Serbian Revolution. Its creation was negotiated first through an unwritten agreement between Miloš Obrenović, leader of the Second Serbian Uprising, and Ottoman official Marashli Pasha, followed by a series of decrees of the Sublime Porte in 1828–1833. Its de facto independence ensued in 1867, following the evacuation of the remaining Ottoman troops from the Belgrade Fortress and the country; its independence was recognized internationally in 1878 by the Treaty of Berlin. In 1882 the country was elevated to the status of kingdom."},{"qid":"Q241748","from_t":1882,"to_t":1920,"method":"name-template+date","confidence":0.9011289067351897,"label":"Kingdom of Serbia","description":"1882–1918 kingdom in Southeastern Europe","inception":1882,"dissolved":1918.9150684931508,"enwiki":"Kingdom of Serbia","summary":"The Kingdom of Serbia was a monarchy located in Southeastern Europe which was created when the ruler of the Principality of Serbia, Milan I, was proclaimed king in 1882.\nSince 1817, the Principality was ruled by the Obrenović dynasty (replaced by the Karađorđević dynasty for a short time). The Principality of Serbia, under the suzerainty of the Ottoman Empire, de facto achieved full independence when the very last Ottoman troops left Belgrade in 1867. The Congress of Berlin in 1878 recognized the formal independence of the Principality of Serbia, and in its composition Nišava, Pirot, Toplica and Vranje districts entered the South part of Serbia."}],"facts":[{"qid":"Q684030","kind":"capital","value_qid":"Q167394","value_label":"Kragujevac","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Kragujevac"},{"qid":"Q684030","kind":"official_language","value_qid":"Q9299","value_label":"Serb