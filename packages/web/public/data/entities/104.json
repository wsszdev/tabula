null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q657","kind":"coat","value_qid":null,"value_label":"Coat of arms of Chad.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q657","kind":"ruler","value_qid":"Q16206405","value_label":"Mahamat Déby","from_t":2021.2986301369863,"to_t":null,"title":"President of Chad","property":"P39","retrieved":"2026-10-30","vl":"Mahamat Déby"},{"qid":"Q657","kind":"ruler","value_qid":"Q297812","value_label":"François Tombalbaye","from_t":1960.6092896174864,"to_t":1975.2794520547945,"title":"President of Chad","property":"P39","retrieved":"2026-10-30","vl":"François Tombalbaye"},{"qid":"Q657","kind":"ruler","value_qid":"Q310886","value_label":"Hissène Habré","from_t":1982.4301369863015,"to_t":1990.9150684931508,"title":"President of Chad","property":"P39","retrieved":"2026-10-30","vl":"Hissène Habré"},{"qid":"Q657","kind":"ruler","value_qid":"Q500374","value_label":"Lol Mahamat Choua","from_t":1979.323287671233,"to_t":1979.6712328767123,"title":"President of Chad","property":"P39","retrieved":"2026-10-30","vl":"Lol Mahamat Choua"},{"qid":"Q657","kind":"ruler","value_qid":"Q548636","value_label":"Goukouni Oueddei","from_t":1979.6712328767123,"to_t":1982.4301369863015,"title":"President of Chad","property":"P39","retrieved":"2026-10-30","vl":"Goukouni Oueddei"},{"qid":"Q657","kind":"ruler","value_qid":"Q57350","value_label":"Idriss Déby","from_t":1990.9178082191781,"to_t":2021.2986301369863,"title":"President of Chad","property":"P39","retrieved":"2026-10-30","vl":"Idriss Déby"},{"qid":"Q657","kind":"flag","value_qid":"Q165811","value_label":"Flag of Chad.svg","from_t":1959.8465753424657,"to_t":null,"title":"flag of Chad","property":"P163","retrieved":"2026-10-30","vl":"flag of Chad"}],"people":{"Q16206405":{"label":"Mahamat Déby","description":"military leader of Chad since 2021","enwiki":"Mahamat Déby","summary":"Mahamat Idriss Déby Itno (born 4 April 1984), also known by the nickname Kaka, is a Chadian politician and military officer who has led Chad under various titles since 2021. Since 2024, he has served as the president of Chad. He is the son of Idriss Déby, who served as the sixth president of Chad from 1990 to 2021.\nBorn in N'Djamena, Déby was sent to military training in France.","image":"Mahamat Déby.jpg","birth":1984.2568306010928,"death":null},"Q4710950":{"label":"Albert Pahimi Padacké","description":"Chadian politician, former and final Prime Minister of Chad","enwiki":"Albert Pahimi Padacké","summary":"Albert Pahimi Padacké (Arabic: ألبر بهيمي بدكي, born 15 November 1966) is a Chadian politician who was Prime Minister of Chad from 26 April 2021 to 12 October 2022. He was also Prime Minister from 2016 to 2018, when he resigned and was not replaced.","image":"Альбер Пахими Падаке (16-11-2021).jpg","birth":1966.8712328767124,"death":null},"Q57350":{"label":"Idriss Déby","description":"Chadian former president (1952–2021)","enwiki":"Idriss Déby","summary":"Idriss Déby Itno (Arabic: إدريس ديبي إتنو Idrīs Daybī Itnū; 18 June 1952 – 20 April 2021) was a Chadian politician and military officer who was the president of Chad from 1991 until his death in 2021 during the Northern Chad offensive. His term of 30 years makes him Chad's longest-serving president.\nDéby was a member of the Bidayat clan of the Zaghawa ethnic group. A high-ranking commander of President Hissène Habré's military during the 1980s, Déby played important roles in the Toyota War which led to Chad's victory during the Chadian-Libyan War.","image":"Idriss Déby at the White House in 2014.jpg","birth":1952.4617486338798,"death":2021.2986301369863},"Q297812":{"label":"François Tombalbaye","description":"President of Chad (1918–1975)","enwiki":"François Tombalbaye","summary":"François Tombalbaye (Arabic: فرنسوا تومبالباي Franswā Tūmbālbāy; 15 June 1918 – 13 April 1975), also known as N'Garta Tombalbaye, was a Chadian politician who served as the first President of Chad from the country's independence in 1960 until his overthrow in 1975. A dictatorial leader, his divisive policies as president led to factional conflict and a pattern of authoritarian leadership and political instability that is still relevant in Chad today.\nA native of the south of the country and a member of the Sara ethnic group, Tombalbaye began his career as a teacher during French colonial rule and joined the Chadian Progressive Party (PPT) in 1946. After serving in the colonial legislature in the 1950s, he succeeded Gabriel Lisette as the PPT's leader in 1959 and was appointed the country's first president upon gaining independence in 1960.","image":"François Tombalbaye p1959.jpg","birth":1918.4520547945206,"death":1975.2794520547945},"Q310886":{"label":"Hissène Habré","description":"5th president of Chad","enwiki":"Hissène Habré","summary":"Hissène Habré (Arabic: حسين حبري Ḥusaīn Ḥabrī, Chadian Arabic: pronounced [hiˈsɛn ˈhabre]; French pronunciation: [isɛn abʁe]; 13 August 1942 – 24 August 2021), also spelled Hissen Habré, was a Chadian politician and convicted war criminal who served as the fifth president of Chad from 1982 until he was deposed in 1990.\nA member of the Toubou ethnic group from northern Chad, Habré joined FROLINAT rebels in the first Chadian Civil War against the southern-dominated Chadian government. Due to a rift with fellow rebel commander Goukouni Oueddei, Habré and his Armed Forces of the North rebel army briefly defected to Felix Malloum's government against Oueddei before turning against Malloum, who resigned in 1979. Habré was then given the position of Minister of Defense under Chad's new transitional coalition government, with Oueddei as President.","image":"President Hissène Habré of Chad.jpg","birth":1942.613698630137,"death":2021.6438356164383},"Q500374":{"label":"Lol Mahamat Choua","description":"Chadian politician (1939-2019)","enwiki":"Lol Mahamat Choua","summary":"Lol Mahamat Choua (Arabic: لول محمد شوا; 15 June 1939 – 15 September 2019) was a Chadian politician who served as his country's head of state for four months in 1979. He was the President of the Rally for Democracy and Progress (RDP) political party.\nAn adherent of Islam and a member of the Kanembu ethnic group, Choua came into power during the First Chadian Civil War. The Popular Movement for the Liberation of Chad (MPLT), a Kanembu rebel group backed by Nigeria, along with the central government, the Armed Forces of the North (FAN) and the People's Armed Forces (FAP) were the main combatants.","image":null,"birth":1939.4520547945206,"death":2019.704109589041},"Q548636":{"label":"Goukouni Oueddei","description":"Chadian politician","enwiki":"Goukouni Oueddei","summary":"Goukouni Oueddei (Arabic: كوكوني عويدي Kūkūnī ʿWaīday; born 1944) is a Chadian politician who served as the fourth president of Chad from 1979 until he was deposed in a coup in 1982. He previously served in this role as acting president from March to April 1979.\nA northerner, Goukouni commanded FROLINAT rebels with Libyan support during the first Chadian Civil War against Chad's southern-dominated government. Upon the rebel victory and the resignation of President Felix Malloum in 1979, he became the new president of Chad's new transitional coalition government by the terms of the Lagos Accord, with rival fellow rebel commander Hissène Habré as defense minister.","image":null,"birth":1942,"death":null}},"media":{"Flag of Chad.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/4b/Flag_of_Chad.svg/330px-Flag_of_Chad.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Chad.svg","author":"SKopp &amp; others (see upload log)","license":"Public domain"},"Coat of arms of Chad.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/c1/Coat_of_arms_of_Chad.svg/330px-Coat_of_arms_of_Chad.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Chad.svg","author":"Milenioscuro","license":"CC BY 3.0"},"Mahamat Déby.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/9/94/Mahamat_D%C3%A9by.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Mahamat_D%C3%A9by.jpg","author":"United States Department of State Africa U.S.-Africa Leaders Summit: Photos and Videos","license":"Public domain"},"Альбер Пахими Падаке (16-11-2021).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/30/%D0%90%D0%BB%D1%8C%D0%B1%D0%B5%D1%80_%D0%9F%D0%B0%D1%85%D0%B8%D0%BC%D0%B8_%D0%9F%D0%B0%D0%B4%D0%B0%D0%BA%D0%B5_%2816-11-2021%29.jpg/330px-%D0%90%D0%BB%D1%8C%D0%B1%D0%B5%D1%80_%D0%9F%D0%B0%D1%85%D0%B8%D0%BC%D0%B8_%D0%9F%D0%B0%D0%B4%D0%B0%D0%BA%D0%B5_%2816-11-2021%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:%D0%90%D0%BB%D1%8C%D0%B1%D0%B5%D1%80_%D0%9F%D0%B0%D1%85%D0%B8%D0%BC%D0%B8_%D0%9F%D0%B0%D0%B4%D0%B0%D0%BA%D0%B5_(16-11-2021).jpg","author":"Jennifer Jacquemart / European Commission","license":"CC BY 4.0"},"Idriss Déby at the White House in 2014.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/c/cf/Idriss_D%C3%A9by_at_the_White_House_in_2014.jpg/330px-Idriss_D%C3%A9by_at_the_White_House_in_2014.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Idriss_D%C3%A9by_at_the_White_House_in_2014.jpg","author":"Office of the White House (Amanda Lucidon)","license":"Public domain"},"François Tombalbaye p1959.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/Fran%C3%A7ois_Tombalbaye_p1959.jpg/330px-Fran%C3%A7ois_Tombalbaye_p1959.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikim