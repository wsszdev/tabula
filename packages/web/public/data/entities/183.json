ler","value_qid":"Q1188596","value_label":"Qahhor Mahkamov","from_t":1990.9123287671232,"to_t":1991.66301369863,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Qahhor Mahkamov"},{"qid":"Q863","kind":"ruler","value_qid":"Q2828958","value_label":"Akbarsho Iskandrov","from_t":1991.7616438356165,"to_t":1991.9178082191781,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Akbarsho Iskandrov"},{"qid":"Q863","kind":"ruler","value_qid":"Q2828958","value_label":"Akbarsho Iskandrov","from_t":1992.6830601092897,"to_t":1992.8852459016393,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Akbarsho Iskandrov"},{"qid":"Q863","kind":"ruler","value_qid":"Q4071361","value_label":"Qadriddin Aslonov","from_t":1991.66301369863,"to_t":1991.7260273972602,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Qadriddin Aslonov"},{"qid":"Q863","kind":"ruler","value_qid":"Q57366","value_label":"Emomali Rahmon","from_t":1994.8821917808218,"to_t":null,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Emomali Rahmon"},{"qid":"Q863","kind":"ruler","value_qid":"Q558515","value_label":"Rahmon Nabiyev","from_t":1991.9178082191781,"to_t":1992.6830601092897,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Rahmon Nabiyev"},{"qid":"Q863","kind":"ruler","value_qid":"Q558515","value_label":"Rahmon Nabiyev","from_t":1991.7260273972602,"to_t":1991.7616438356165,"title":"president of Tajikistan","property":"P39","retrieved":"2026-10-30","vl":"Rahmon Nabiyev"},{"qid":"Q863","kind":"flag","value_qid":"Q160124","value_label":"Flag of Tajikistan.svg","from_t":1992.896174863388,"to_t":null,"title":"flag of Tajikistan","property":"P163","retrieved":"2026-10-30","vl":"flag of Tajikistan"}],"people":{"Q57366":{"label":"Emomali Rahmon","description":"President of Tajikistan (1992-present)","enwiki":"Emomali Rahmon","summary":"Emomali Rahmon (born Emomali Sharipovich Rahmonov; 5 October 1952) is a Tajikistani politician who has served as the third president of Tajikistan since 1994, having previously led the country as Chairman of the Supreme Assembly from 1992 to 1994. Since 1998, he has also served as the leader of the People's Democratic Party of Tajikistan, which dominates the Parliament of Tajikistan. On 30 September 1999, he was elected vice-president of the United Nations General Assembly for a one-year term.\nBorn in Danghara to a peasant family, he became a rising apparatchik in Tajikistan as he became the chairman of the collective state farm of his native Danghara.","image":"Emomali Rahmon in 2026.jpg","birth":1952.75956284153,"death":null},"Q15222839":{"label":"Kokhir Rasulzoda","description":"Tajikistani politician","enwiki":"Qohir Rasulzoda","summary":"Qohir Rasulzoda (born Abduqohir Abdurasulovich Nazirov, 8 March 1961) is a Tajikistani politician who is serving as the Prime Minister of Tajikistan since 23 November 2013. He is a member of the People's Democratic Party of Tajikistan.","image":"Kokhir Rasulzoda.jpg","birth":1961.1808219178083,"death":null},"Q1188596":{"label":"Qahhor Mahkamov","description":"Soviet politician, then president of Tajikistan (1990–1991)","enwiki":"Qahhor Mahkamov","summary":"Qahhor Mahkamov (Russian: Кахар Махкамович Махкамов, romanized: Kakhar Makhkamovich Makhkamov, Tajik: Қаҳҳор Маҳкамов; alternative spelling Kahar Mahkamov; 16 April 1932 – 8 June 2016) was a Tajik politician who served as First Secretary of the Communist Party of Tajikistan from 1985 to 1991 and was the first President of Tajikistan from November 1990 until his fall in the August 1991 coup.","image":null,"birth":1932.2896174863388,"death":2016.4344262295083},"Q2828958":{"label":"Akbarsho Iskandrov","description":"1st President of Tajikistan","enwiki":"Akbarsho Iskandarov","summary":"Akbarsho Iskandarov (born 1 August 1951) is a Tajikistani politician who was twice acting president of Tajikistan. He first served as acting president from October 6, 1991, to December 2, 1991, when Rahmon Nabiyev stepped down to fight Tajikistan's first presidential election. Nabiyev won the election and took over as the first popularly elected president in the country's history, but resigned in September 1992, following a coup d'état. Iskandrov again took the interim presidency and later resigned on 20 November 1992, after which the office of president was abolished and Emomali Rahmon was installed as head of state.","image":null,"birth":1951.5808219178082,"death":null},"Q4071361":{"label":"Qadriddin Aslonov","description":"Tajik politician (1947–1992)","enwiki":"Qadriddin Aslonov","summary":"Qadriddin Aslonov (Tajik: Қадриддин Аслонов, also spelled Kadriddin Aslonov; 29 May 1947 – November 1992) was acting President of Tajikistan from 31 August to 23 September 1991.\nAslonov was born on 29 May 1947 in Rasht District, Tajik SSR.  \nWhen his predecessor Qahhor Mahkamov resigned as the President of Tajikistan, Aslonov was elected his temporary successor in the capacity as Chairman of the Supreme Soviet. One of Aslonov's first actions as leader was to sign an edict calling for the cessation of all activities of the Communist Party on the territory of Tajikistan and the nationalization of the party's property. The Congress of the Communist Party of Tajikistan subsequently convened in the second half of September 1991 to announce the dissolution of the Communist Party of the Soviet Union.","image":null,"birth":1947.4054794520548,"death":1992},"Q558515":{"label":"Rahmon Nabiyev","description":"Tajikistani politician (1930-1993)","enwiki":"Rahmon Nabiyev","summary":"Rahmon Nabiyevich Nabiyev (5 October 1930 – 11 April 1993) was a Tajik politician and engineer who served as the second president of Tajikistan from 1991 until his resignation in 1992. Having previously served in this role briefly for 13 days from September to October 1991, Nabiyev was the shortest-serving president in Tajikistan's history and was also the first directly elected Tajik president.\nBorn into a family of farmers in Khujand, Nabiyev started working as an accountant on a collective farm at the age of 16 in 1946. In the same year he entered the Leninabad Agricultural College (now Agricultural University of Tajikistan) and graduated in 1949.","image":"Rahmon Nabiyev 1991-1992 (cropped).jpg","birth":1930.7589041095891,"death":1993.2739726027398}},"media":{"Flag of Tajikistan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d0/Flag_of_Tajikistan.svg/330px-Flag_of_Tajikistan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Tajikistan.svg","author":"Unknown authorUnknown author","license":"Public domain"},"Emblem of Tajikistan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Emblem_of_Tajikistan.svg/330px-Emblem_of_Tajikistan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emblem_of_Tajikistan.svg","author":null,"license":"Public domain"},"Emomali Rahmon in 2026.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/44/Emomali_Rahmon_in_2026.jpg/330px-Emomali_Rahmon_in_2026.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Emomali_Rahmon_in_2026.jpg","author":"Masato Kanda","license":"CC BY 4.0"},"Kokhir Rasulzoda.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/88/Kokhir_Rasulzoda.jpg/330px-Kokhir_Rasulzoda.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Kokhir_Rasulzoda.jpg","author":"Russian Government, Press Service","license":"CC BY 4.0"},"Rahmon Nabiyev 1991-1992 (cropped).jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Rahmon_Nabiyev_1991-1992_%28cropped%29.jpg/330px-Rahmon_Nabiyev_1991-1992_%28cropped%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Rahmon_Nabiyev_1991-1992_(cropped).jpg","author":"EgemenMedia","license":"CC BY-SA 4.0"}},"names":["Repubblica del Tagikistan","Republic of Tajikistan","Republiek Tadzjikistan","República de Tayikistán","Tacikistan","Tadicistania","Tadjikistan","Tadschikistan","Tadzjikistan","Tadżykistan","Tagikistan","Tajikistan","Tajikistán","Tajiquistão","Tayikistán","la République du Tadjikistan","tj","Τατζικιστάν","РТ","Республика Таджикистан","Таджикистан","تاجیکستان","طاجيكستان","तजिकिस्तान","ताजिकिस्तान","ताजीकिस्तान","タジキスタン","タジキスタン共和国","タジク","塔吉克斯坦"]}