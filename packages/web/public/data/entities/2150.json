8.22568161660107,"min_lat":-37.081475,"max_lon":140.734863,"max_lat":-35.070469,"source_file":"world_1783.geojson","source_row":null},{"id":7547,"name":"Ngarrindjeri","set_id":"hb_1800","class":"culture","valid_from":1800,"valid_to":1815,"snapshot_held":1,"area_km2":12666.200653075963,"border_precision":3,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Australia","min_lon":138.22568161660107,"min_lat":-37.081475,"max_lon":140.734863,"max_lat":-35.070469,"source_file":"world_1800.geojson","source_row":null}],"identities":[{"qid":"Q370543","from_t":1600,"to_t":1815,"method":"name-label, undated","confidence":0.5,"label":"Ngarrindjeri","description":"Aboriginal Australian people of southern South Australia","inception":null,"dissolved":null,"enwiki":"Ngarrindjeri","summary":"The Ngarrindjeri people are the traditional Aboriginal Australian people of the lower Murray River, eastern Fleurieu Peninsula, and the Coorong of the southern-central area of the state of South Australia. The term Ngarrindjeri means \"belonging to men\", and refers to a \"tribal constellation\". The Ngarrindjeri actually comprised several distinct if closely related tribal groups, including the Jarildekald, Tanganekald, Meintangk and Ramindjeri, who began to form a unified cultural bloc after remnants of each separate community congregated at Raukkan, South Australia (formerly Point McLeay Mission).\nA descendant of these peoples, Irene Watson, has argued that the notion of Ngarrindjeri identity is a cultural construct imposed by settler colonialists, who bundled together and conflated a variety of distinct Aboriginal cultural and kinship groups into one homogenised pattern, now known as Ngarrindjeri."}],"facts":[],"people":{},"media":{},"names":["Ngarrindjeri","ナリンジェリ族","ンガリンジェリ族","噶林杰里人"]}