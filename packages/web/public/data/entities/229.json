essor","value_qid":"Q142965","value_label":"Portuguese Timor","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Portuguese Timor"},{"qid":"Q574","kind":"flag","value_qid":null,"value_label":"Flag of East Timor.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q574","kind":"coat","value_qid":null,"value_label":"Coat of arms of East Timor.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q574","kind":"ruler","value_qid":"Q11509","value_label":"Xanana Gusmão","from_t":2002.3808219178081,"to_t":2007.3808219178081,"title":"President of East Timor","property":"P39","retrieved":"2026-10-30","vl":"Xanana Gusmão"},{"qid":"Q574","kind":"ruler","value_qid":"Q11665","value_label":"José Ramos-Horta","from_t":2007.3808219178081,"to_t":2012.3825136612022,"title":"President of East Timor","property":"P39","retrieved":"2026-10-30","vl":"José Ramos-Horta"},{"qid":"Q574","kind":"ruler","value_qid":"Q57519","value_label":"Taur Matan Ruak","from_t":2012.3825136612022,"to_t":2017.3808219178081,"title":"President of East Timor","property":"P39","retrieved":"2026-10-30","vl":"Taur Matan Ruak"},{"qid":"Q574","kind":"ruler","value_qid":"Q731840","value_label":"Francisco Xavier do Amaral","from_t":1975.9068493150685,"to_t":1975.9315068493152,"title":"President of East Timor","property":"P39","retrieved":"2026-10-30","vl":"Francisco Xavier do Amaral"},{"qid":"Q574","kind":"ruler","value_qid":"Q897790","value_label":"فرنسيسكو غوتيريس","from_t":2017.3808219178081,"to_t":2022.3808219178081,"title":"President of East Timor","property":"P39","retrieved":"2026-10-30","vl":"فرنسيسكو غوتيريس"},{"qid":"Q574","kind":"flag","value_qid":"Q30768","value_label":"Flag of East Timor.svg","from_t":1975.9068493150685,"to_t":null,"title":"flag of East Timor","property":"P163","retrieved":"2026-10-30","vl":"flag of East Timor"}],"people":{"Q11665":{"label":"José Ramos-Horta","description":"2nd and 5th President of East Timor, Nobel Prize laureate","enwiki":"José Ramos-Horta","summary":"José Manuel Ramos-Horta (Portuguese pronunciation: [ʒuˈzɛ mɐˈnwɛɫ ˈʁɐ̃muz ˈɔɾtɐ]; born 26 December 1949) is an East Timorese politician who has been the seventh president of Timor-Leste since 2022, having previously been the fourth president from 2007 to 2012. He was a co-recipient of the 1996 Nobel Peace Prize, along with Carlos Filipe Ximenes Belo, for working \"towards a just and peaceful solution to the conflict in East Timor\".\nAs a founder and former member of Fretilin, Ramos-Horta served as the exiled spokesman for the East Timorese resistance during the Indonesian occupation of East Timor (1975–1999). While he continued to work with Fretilin, he resigned from the party in 1988, becoming an independent politician.","image":"2022-05-20 José Ramos-Horta.jpg","birth":1949.9835616438356,"death":null},"Q11509":{"label":"Xanana Gusmão","description":"Prime Minister and former President of East Timor","enwiki":"Xanana Gusmão","summary":"José Alexandre \"Xanana\" Gusmão (Portuguese pronunciation: [ʒuˈzɛ ɐlɨˈʃɐ̃dɾɨ ʃɐˈnanɐ ɣuʒˈmɐ̃w]; born 20 June 1946) is an East Timorese politician. He has served as the tenth prime minister of Timor-Leste since 2023, previously serving as the sixth prime minister from 2007 to 2015. A former rebel, he also served as East Timor's first president since its re-establishment of independence from 2002 to 2007.","image":"Xanana 2011.jpg","birth":1946.4657534246576,"death":null},"Q57519":{"label":"Taur Matan Ruak","description":"Prime Minister of East Timor","enwiki":"Taur Matan Ruak","summary":"José Maria de Vasconcelos (born 10 October 1956), popularly known as Taur Matan Ruak (lit. 'Two Sharp Eyes'), is an East Timorese politician who served as the fifth president of East Timor from 2012 to 2017 and as the 9th prime minister from 2018 to 2023.\nBefore entering politics, he was the commander of the FALINTIL-Forças de Defesa de Timor-Leste (F-FDTL), the military of East Timor, from 2002 until 6 October 2011. Prior to serving in the F-FDTL, he was the last commander of the Armed Forces of National Liberation of East Timor or FALINTIL (Forças Armadas para a Liberação Nacional de Timor Leste), the insurgent army that resisted the Indonesian occupation of the territory from 1975 to 1999. Leaving the military in 2011, he stood as an independent candidate in the 2012 presidential election and prevailed in the second round of the vote, held in April 2012.","image":"Prime Minister of Timor-Leste Taur Matan Ruak.jpg","birth":1956.7732240437158,"death":null},"Q731840":{"label":"Francisco Xavier do Amaral","description":"Timorese (1937-2012)","enwiki":"Francisco Xavier do Amaral","summary":"Francisco Xavier do Amaral (3 December 1937 – 6 March 2012) was an East Timorese politician. A founder of the Frente Revolucionária de Timor Leste Independente (Fretilin), Amaral was sworn in as the first President of East Timor when the country, then a Portuguese colony, made a unilateral declaration of independence on 28 November 1975. He was a member of the National Parliament for the Timorese Social Democratic Association from 2001 until his death in 2012. Amaral was also known as \"Abo (Grandfather) Xavier\", a term of endearment, by East Timorese.","image":"Francisco Xavier do Amaral.jpg","birth":1937.9205479452055,"death":2012.1775956284152},"Q897790":{"label":"فرنسيسكو غوتيريس","description":"East Timorese politician (1954-2026)","enwiki":"Francisco Guterres","summary":"Francisco Guterres (7 September 1954 – 21 June 2026), popularly known by his nom de guerre Lú-Olo, was an East Timorese revolutionary and politician who served as the 6th president of Timor-Leste from 2017 to 2022. A member of Fretilin, he also served as the first president of the National Parliament of Timor-Leste from 2002 to 2007. A member of Falintil, he was a leading figure in the armed resistance to the Indonesian occupation of East Timor.\nGuterres stood for Fretilin in the 2007 and 2012 presidential elections, but was defeated in the second round by independent candidates on both occasions.","image":"President of Timor Leste Francisco Guterres.jpg","birth":1954.682191780822,"death":2026.468493150685}},"media":{"Flag of East Timor.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/26/Flag_of_East_Timor.svg/330px-Flag_of_East_Timor.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_East_Timor.svg","author":"See File history, below, for details.","license":"Public domain"},"Coat of arms of East Timor.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Coat_of_arms_of_East_Timor.svg/330px-Coat_of_arms_of_East_Timor.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_East_Timor.svg","author":"en:User:Vino4u","license":"Public domain"},"2022-05-20 José Ramos-Horta.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/95/2022-05-20_Jos%C3%A9_Ramos-Horta.jpg/330px-2022-05-20_Jos%C3%A9_Ramos-Horta.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:2022-05-20_Jos%C3%A9_Ramos-Horta.jpg","author":"Ministro da Defesa Dr. Filomeno da Paixão de Jesus","license":"Public domain"},"Xanana 2011.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Xanana_2011.jpg/330px-Xanana_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Xanana_2011.jpg","author":"Antonio Cruz/ABr","license":"CC BY 3.0"},"Prime Minister of Timor-Leste Taur Matan Ruak.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f9/Prime_Minister_of_Timor-Leste_Taur_Matan_Ruak.jpg/330px-Prime_Minister_of_Timor-Leste_Taur_Matan_Ruak.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Prime_Minister_of_Timor-Leste_Taur_Matan_Ruak.jpg","author":"Government of Timor-Leste","license":"Public domain"},"Francisco Xavier do Amaral.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/64/Francisco_Xavier_do_Amaral.jpg/330px-Francisco_Xavier_do_Amaral.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Francisco_Xavier_do_Amaral.jpg","author":"Wahlkampf_JRH_mit_Francisco_do_Amaral_u._Mario_Carrascalao.JPG: Jörg Meier, Watch Indonesia!\nderivative work: Patrick (talk)","license":"CC BY-SA 3.0"},"President of Timor Leste Francisco Guterres.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8c/President_of_Timor_Leste_Francisco_Guterres.jpg/330px-President_of_Timor_Leste_Francisco_Guterres.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:President_of_Timor_Leste_Francisco_Guterres.jpg","author":"Presidência da República de Timor-Leste","license":"Public domain"}},"names":["Democratic Republic of Timor-Leste","Democratische Republiek Oost-Timor","Demokratyczna Republika Timoru Wschodniego","Doğu Timor","East Timor","Oost-Timor","Osttimor","República Democrática de Timor Oriental","República Democrática de Timor-Leste","République démocratique du Timor oriental","République démocratique du Timor-Leste","République démocratique du Timor-Oriental","TL","TLS","Timor Est","Timor Oriental","Timor Orientale","Timor Orientalis","Timor Wschodni","Timor oriental","Timor-Leste","Timor-Oriental","Timora Orientalis","Timór Loro Sa'e","la République démocratique du Timor oriental","Ανατολικό Τιμόρ","Восточный Тимор","Демократическая Республика Восточный Тимор","Демократическая Республика Тимор-Лешти","Тимор-Леште","Тимор-Лешти","تيمور الشرقي