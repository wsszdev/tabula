l,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q958","kind":"coat","value_qid":null,"value_label":"Coat of arms of South Sudan.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q958","kind":"ruler","value_qid":"Q6284330","value_label":"Joseph James Tombura","from_t":1982.4739726027397,"to_t":1983.4246575342465,"title":"President of South Sudan","property":"P39","retrieved":"2026-10-30","vl":"Joseph James Tombura"},{"qid":"Q958","kind":"ruler","value_qid":"Q7174190","value_label":"Peter Gatkuoth","from_t":1979.5260273972603,"to_t":1980.4098360655737,"title":"President of South Sudan","property":"P39","retrieved":"2026-10-30","vl":"Peter Gatkuoth"},{"qid":"Q958","kind":"flag","value_qid":"Q182782","value_label":"Flag of South Sudan.svg","from_t":2005.517808219178,"to_t":null,"title":"flag of South Sudan","property":"P163","retrieved":"2026-10-30","vl":"flag of South Sudan"}],"people":{"Q57315":{"label":"Salva Kiir Mayardit","description":"President of South Sudan since 2011","enwiki":"Salva Kiir","summary":"Salva Kiir Mayardit (born 13 September 1951) is a South Sudanese politician who has served as the President of South Sudan since its independence on 9 July 2011. Prior to independence, he was the President of the Government of Southern Sudan, as well as First Vice President of Sudan, from 2005 to 2011. He was named Commander-in-Chief of the Sudan People's Liberation Army (SPLA) in 2005, following the death of John Garang.\nKiir was born to the Dinka ethnic group and joined Anyanya rebels fighting for Southern independence during the First Sudanese Civil War in 1967.","image":"Salva Kiir Mayardit.jpg","birth":1951.6986301369864,"death":null},"Q6284330":{"label":"Joseph James Tombura","description":"former president of Southern Sudan (1929-1992)","enwiki":"Joseph James Tombura","summary":"Joseph James Tombura (12 September 1929 – 17 September 1992) was a South Sudanese politician and member of the Sudan African National Union. He was the president of the High Executive Council of the Southern Sudan Autonomous Region, serving from 23 June 1982 to 5 June 1983, until the Sudanese central government revoked the autonomy of that region. Autonomy was restored in 2005, and six years later, South Sudan became an independent nation.","image":null,"birth":1929.695890410959,"death":1992.7103825136612},"Q7174190":{"label":"Peter Gatkuoth","description":"former president of Southern Sudan (1938–2010)","enwiki":"Peter Gatkuoth","summary":"Peter Gatkuoth (1 January 1938 – 26 August 2010) was a South Sudanese politician. He was the third president of the High Executive Council of the Southern Sudan Autonomous Region, serving from 12 July 1979 to 30 May 1980. He was assassinated in 2010.","image":null,"birth":1938,"death":2010.6493150684933}},"media":{"Flag of South Sudan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7a/Flag_of_South_Sudan.svg/330px-Flag_of_South_Sudan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_South_Sudan.svg","author":"Achim1999","license":"Public domain"},"Coat of arms of South Sudan.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Coat_of_arms_of_South_Sudan.svg/330px-Coat_of_arms_of_South_Sudan.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_South_Sudan.svg","author":"Unknown authorUnknown author","license":"Public domain"},"Salva Kiir Mayardit.jpg":{"url":"https://upload.wikimedia.org/wikipedia/commons/2/27/Salva_Kiir_Mayardit.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","page":"https://commons.wikimedia.org/wiki/File:Salva_Kiir_Mayardit.jpg","author":"Photo Credit: Jenny Rockett","license":"CC BY-SA 3.0"}},"names":["Güney Sudan","Repubblica del Sud Sudan","Repubbli