{"entity":{"id":"cs:602","name":"Spanish Morocco","dataset":"cshapes","kind":"polity"},"territories":[{"id":10537,"name":"Spanish Morocco","set_id":"cs","class":"dependency","valid_from":1912.9043715846994,"valid_to":1956.2650273224044,"snapshot_held":0,"area_km2":52796.1,"border_precision":3,"capital_name":"Tetuan","sovereign":null,"sovereign_note":null,"modern_name":"Morocco","min_lon":-13.170879,"min_lat":27.664234,"max_lon":-2.310237,"max_lat":35.91775,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=602;start=1912-11-27"}],"identities":[{"qid":"Q457242","from_t":1912.9043715846994,"to_t":1956.2650273224044,"method":"name-alias+date","confidence":0.8215695903823534,"label":"Spanish protectorate in Morocco","description":"1912–1956 protectorate in northwest Africa","inception":1912.2431693989072,"dissolved":1956.2622950819673,"enwiki":"Spanish protectorate in Morocco","summary":"The Spanish Protectorate in Morocco was established on 27 November 1912 by a treaty between France and Spain that converted the Spanish sphere of influence in Morocco, then under French protection, into a formal Spanish protectorate.\nThe Spanish protectorate consisted of a northern strip on the Mediterranean and the Strait of Gibraltar, and a southern part of the protectorate around Cape Juby, bordering the Spanish Sahara. The northern zone became part of independent Morocco on 7 April 1956, shortly after France relinquished its protectorate. Spain finally ceded its southern zone through the Treaty of Angra de Cintra on 1 April 1958, after the short Ifni War."}],"facts":[{"qid":"Q457242","kind":"capital","value_qid":"Q185157","value_label":"Tétouan","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Tétouan"},{"qid":"Q457242","kind":"official_language","value_qid":"Q1321","value_label":"Spanish","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Spanish"},{"qid":"Q457242","kind":"language","value_qid":"Q34174