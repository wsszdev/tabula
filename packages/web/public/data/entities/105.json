ilt trade links leading into the Congo River basin. From the 13th century, the present-day territory was dominated by a confederation led by Vungu which included Kakongo and Ngoyo."}],"facts":[{"qid":"Q971","kind":"ruler","value_qid":"Q57418","value_label":"Denis Sassou-Nguesso","from_t":1997.813698630137,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Denis Sassou-Nguesso"},{"qid":"Q971","kind":"ruler","value_qid":"Q4752077","value_label":"Anatole Collinet Makosso","from_t":2021.358904109589,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Anatole Collinet Makosso"},{"qid":"Q971","kind":"capital","value_qid":"Q3844","value_label":"Brazzaville","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Brazzaville"},{"qid":"Q971","kind":"official_language","value_qid":"Q150","value_label":"French","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"French"},{"qid":"Q971","kind":"language","value_qid":"Q36473","value_label":"Central Teke","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Central Teke"},{"qid":"Q971","kind":"language","value_qid":"Q36087","value_label":"Ngom","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Ngom"},{"qid":"Q971","kind":"language","value_qid":"Q2802914","value_label":"East Teke","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"East Teke"},{"qid":"Q971","kind":"language","value_qid":"Q3558409","value_label":"Vili","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Vili"},{"qid":"Q971","kind":"language","value_qid":"Q11154772","value_label":"Monzombo","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Monzombo"},{"qid":"Q971","kind":"language","value_qid":"Q3915310","value_label":"Mbandja","from_t":null,"to_t":n