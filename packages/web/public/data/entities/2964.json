d":"Q541570","value_label":"Sālote Tupou III of Tonga","from_t":1918.2575342465752,"to_t":1965.9561643835616,"title":"Monarch of Tonga","property":"P39","retrieved":"2026-10-30","vl":"Sālote Tupou III of Tonga"},{"qid":"Q678","kind":"ruler","value_qid":"Q3473052","value_label":"Laufilitonga","from_t":1827,"to_t":1865.9369863013699,"title":"Monarch of Tonga","property":"P39","retrieved":"2026-10-30","vl":"Laufilitonga"},{"qid":"Q678","kind":"ruler","value_qid":"Q3067145","value_label":"Fatafehi Fununuiava","from_t":1793,"to_t":1810,"title":"Monarch of Tonga","property":"P39","retrieved":"2026-10-30","vl":"Fatafehi Fununuiava"},{"qid":"Q678","kind":"ruler","value_qid":"Q3067149","value_label":"Fatafehi Ma'ulupekotofa","from_t":1784,"to_t":1786,"title":"Monarch of Tonga","property":"P39","retrieved":"2026-10-30","vl":"Fatafehi Ma'ulupekotofa"},{"qid":"Q678","kind":"ruler","value_qid":"Q65450779","value_label":"Fatafehi Paulaho","from_t":1777,"to_t":1784,"title":"Monarch of Tonga","property":"P39","retrieved":"2026-10-30","vl":"Fatafehi Paulaho"},{"qid":"Q678","kind":"flag","value_qid":"Q188072","value_label":"Flag of Tonga.svg","from_t":1875.841095890411,"to_t":null,"title":"flag of Tonga","property":"P163","retrieved":"2026-10-30","vl":"flag of Tonga"}],"people":{"Q208497":{"label":"Tupou VI of Tonga","description":"King of Tonga","enwiki":"Tupou VI","summary":"Tupou VI (ʻAho‘eitu ʻUnuakiʻotonga Tukuʻaho; 12 July 1959) is King of Tonga. He acceded the throne in 2012 and was previously Prime Minister of Tonga from 2000 to 2006.\nThe youngest child of king Tāufaʻāhau Tupou IV, he served as a military officer, politician and diplomat. Shortly after resigning as prime minister, he became heir presumptive on the accession of his elder brother George Tupou V, who had no legitimate issue.","image":"Tupou VI 2025.jpg","birth":1959.5260273972603,"death":null},"Q5437258":{"label":"Fatafehi Fakafānua, 8th Lord Fakafānua","description":"Prime Minister of Tonga since 2025","enwiki":"Fatafehi Fakafānua","summary":"Fatafehi Kinikinilau Lolomana‘ia Fakafānua, 8th Lord Fakafānua (born 20 March 1985), is a Tongan politician and noble who has served as prime minister of Tonga since 18 December 2025. He is an extended member of the Tongan royal family.\nFakafānua was first elected to the Legislative Assembly as a member of the nobility in 2008. He served as Speaker of the Tongan Legislative Assembly from 2012 to 2014 and from 2017 to 2025.","image":"Fatafehi Fakafānua January 2026.jpg","birth":1985.213698630137,"death":null},"Q227716":{"label":"George Tupou V of Tonga","description":"King of Tonga","enwiki":"George Tupou V","summary":"George Tupou V (Siaosi Tāufaʻāhau Manumataongo Tukuʻaho Tupou; 4 May 1948 – 18 March 2012) was King of Tonga from 2006 until his death in 2012. He was the eldest son of King Tāufaʻāhau Tupou IV.\nAfter ascending the throne, George Tupou announced that he would relinquish most of the monarch's powers and be guided by the Prime Minister on most matters. A snap election in 2010 was the first to be called under the new system. Following his death, he was succeeded by his younger brother, Tupou VI. Having reigned for 5 years and 189 days, he was the shortest-reigning Tongan monarch since the declaration of the constitutional monarchy in 1875.","image":"George Tupou V of Tonga, 2011 (cropped).jpg","birth":1948.3387978142077,"death":2012.2103825136612},"Q273739":{"label":"Tāufaʻāhau Tupou IV of Tonga","description":"King of Tonga (1918–2006)","enwiki":"Tāufaʻāhau Tupou IV","summary":"Tāufaʻāhau Tupou IV (Siaosi Tāufaʻāhau Tupoulahi; 4 July 1918 – 10 September 2006) was King of Tonga from 1965 until his death in 2006. He was previously Prime Minister of Tonga from 1949 to 1965.\nTupou was the tallest and heaviest Tongan monarch, weighing 209.5 kg (462 lb) and measuring 196 cm (6 ft 5 in).","image":"Tāufaʻāhau Tupou IV - ETH-Bibliothek Com LC1500-0777-001.tif","birth":1918.504109589041,"death":2006.690410958904},"Q379840":{"label":"George Tupou I","description":"Monarch of Tonga (1797–1893)","enwiki":"George Tupou I","summary":"George Tupou I (4 December 1797 – 18 February 1893), originally known as Tāufaʻāhau I, was the first king of modern Tonga. Originally controlling a disputed piece of land in Haʻapai, he expanded to control Vavaʻu, Tongatapu, and other islands.","image":"George Tupou I, engraving by John Cochran (1904).jpg","birth":1797.9232876712329,"death":1893.131506849315},"Q379844":{"label":"George Tupou II","description":"King of Tonga (1874-1918)","enwiki":"George Tupou II","summary":"George Tupou II (Tongan: Siaosi Tupou II; 18 June 1874 – 5 April 1918) was the King of Tonga from 18 February 1893 until his death. He was officially crowned at Nukuʻalofa, on 17 March 1893. He was also the 20th Tuʻi Kanokupolu.","image":"George Tupou II, photograph by Herman John Schmidt (Flipped and Cropped).jpg","birth":1874.4602739726026,"death":1918.2575342465752},"Q541570":{"label":"Sālote Tupou III of Tonga","description":"Monarch of Tonga (1918-1965)","enwiki":"Sālote Tupou III","summary":"Sālote Tupou III (born Sālote Mafileʻo Pilolevu; 13 March 1900 – 16 December 1965) was Queen of Tonga from 1918 to her death in 1965. She reigned for nearly 48 years, the longest of any Tongan monarch. Her rule of Tonga has been characterized as a golden age for Tonga. She was well known for her height, being 6 ft 3 in (191 cm) tall in her prime.","image":"Salote Tupou III of Tonga in coronation robe-crop.jpg","birth":1900.194520547945,"death":1965.9561643835616},"Q3473052":{"label":"Laufilitonga","description":"Tongan king (1797-1865)","enwiki":"Laufilitonga","summary":"Fatafehi Laufilitonga (24 August 1797 – 9 December 1865) was the 39th and last Tuʻi Tonga, a dynasty of kings in Tonga during the Tuʻi Tonga Empire.","image":null,"birth":1797.6438356164383,"death":1865.9369863013699},"Q3067145":{"label":"Fatafehi Fununuiava","description":"Tongan politician","enwiki":null,"summary":null,"image":null,"birth":1765,"death":null},"Q3067149":{"label":"Fatafehi Ma'ulupekotofa","description":"Tongan politician","enwiki":null,"summary":null,"image":null,"birth":null,"death":null},"Q65450779":{"label":"Fatafehi Paulaho","description":"Tongan king","enwiki":null,"summary":null,"image":"Poulaho, koning der Vrienden Eilanden, objectnr A 58265.jpg","birth":null,"death":null}},"media":{"Flag of Tonga.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/Flag_of_Tonga.svg/330px-Flag_of_Tonga.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Tonga.svg","author":"Uelingatoni Ngu Tupoumalohi","license":"Public domain"},"Coat of arms of Tonga.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Coat_of_arms_of_Tonga.svg/330px-Coat_of_arms_of_Tonga.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Tonga.svg","author":"Original design attributed to Reverend Shirley Baker (1836 - 1903). SVG by Tauʻolunga","license":"Public domain"},"Tupou VI 2025.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/77/Tupou_VI_2025.jpg/330px-Tupou_VI_2025.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Tupou_VI_2025.jpg","author":"Government House, Department of the Prime Minister and Cabinet","license":"CC0"},"Fatafehi Fakafānua January 2026.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Fatafehi_Fakaf%C4%81nua_January_2026.jpg/330px-Fatafehi_Fakaf%C4%81nua_January_2026.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Fatafehi_Fakaf%C4%81nua_January_2026.jpg","author":"Daniel Walding /DFAT","license":"CC BY 4.0"},"George Tupou V of Tonga, 2011 (cropped).jpg":{"url":"https://thu