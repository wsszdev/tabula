cision":3,"capital_name":"Belgrade","sovereign":null,"sovereign_note":null,"modern_name":"Serbia","min_lon":18.453327,"min_lat":41.849,"max_lon":22.996536,"max_lat":46.181109,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=345;start=1992-4-27"}],"identities":[{"qid":"Q191077","from_t":1918.92,"to_t":1945.9,"method":"curated","confidence":0.98,"label":"Kingdom of Yugoslavia","description":"the official name of Yugoslavia during the period of 1929–1941 (de facto)/1945 (de jure)","inception":1929.7534246575342,"dissolved":1945.9095890410958,"enwiki":"Kingdom of Yugoslavia","summary":"The Kingdom of Yugoslavia was a country in Southeast and Central Europe that existed from 1918 until 1941. From 1918 to 1929, it was officially called the Kingdom of Serbs, Croats, and Slovenes and was colloquially known as Yugoslavia (lit. 'Land of the South Slavs') due to its origins.\nThe preliminary kingdom was formed in late 1918 by the unification of the Kingdom of Serbia, which was previously independent, with the Kingdom of Montenegro, and the territories of the former Austro-Hungarian Empire, mainly the provisional State of Slovenes, Croats and Serbs (encompassing what is now Bosnia and Herzegovina and most of what are now the states of Croatia and Slovenia) as well as Banat, Bačka and Baranja. The regions of Kosovo and what is today North Macedonia had become parts of Serbia prior to the unification."},{"qid":"Q83286","from_t":1945.9,"to_t":1992.3,"method":"curated","confidence":0.98,"label":"Socialist Federal Republic of Yugoslavia","description":"Central and Southeast European socialist state (1945–1992)","inception":null,"dissolved":1992.3169398907103,"enwiki":"Socialist Federal Republic of Yugoslavia","summary":"The Socialist Federal Republic of Yugoslavia, known from 1945 to 1963 as the Federal People's Republic of Yugoslavia, and commonly referred to as Yugoslavia, was a country in Central and Southeast Europe. It was established in 1945, following World War II, and lasted until 1992, dissolving amid the onset of the Yugoslav Wars. Spanning an area of 255,804 square kilometres (98,766 sq mi) in the Balkans, Yugoslavia was bordered by the Adriatic Sea and Italy to the west, Austria and Hungary to the north, Bulgaria and Romania to the east, and Albania and Greece to the south. It was a one-party socialist state and federation governed by the League of Communists of Yugoslavia, and had six constituent republics: Bosnia and Herzegovina, Croatia, Macedonia, Montenegro, Serbia, and Slovenia."},{"qid":"Q838261","from_t":1992.3,"to_t":2003.1,"method":"curated","confidence":0.98,"label":"Federal Republic of Yugoslavia","description":"former Balkan republic (1992–2003)","inception":1992.3196721311476,"dissolved":2003.0931506849315,"enwiki":"Federal Republic of Yugoslavia","summary":"The State Union of Serbia and Montenegro (often shortened to Serbia and Montenegro), known from 1992 to 2003 as the Federal Republic of Yugoslavia (FRY) and commonly referred to as Yugoslavia, was a country in Southeastern Europe. It was established on 27 April 1992 as a federation comprising the Republic of Serbia and the Republic of Montenegro, following the breakup of the Socialist Federal Republic of Yugoslavia (SFR Yugoslavia). In February 2003, the federation was reconstituted as a state union. Following the secession of Montenegro in June 2006, Serbia proclaimed independence."},{"qid":"Q37024","from_t":2003.1,"to_t":2006.4191780821918,"method":"curated","confidence":0.98,"label":"Serbia and Montenegro","description":"former political union in the Balkans (2003–2006)","inception":2003,"dissolved":2006.4219178082192,"enwiki":"Serbia and Montenegro","summary":"The State Union of Serbia and Montenegro (often shortened to Serbia and Montenegro), known from 1992 to 2003 as the Federal Republic of Yugoslavia (FRY) and commonly referred to as Yugoslavia, was a country in Southeastern Europe. It was established on 27 April 1992 as a federation comprising the Republic of Serbia and the Republic of Montenegro, following the breakup of the Socialist Federal Republic of Yugoslavia (SFR Yugoslavia). In February 2003, the federation was reconstituted as a state union. Following the secession of Montenegro in June 2006, Serbia proclaimed independence."}],"facts":[{"qid":"Q191077","kind":"capital","value_qid":"Q3711","value_label":"Belgrade","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Belgrade"},{"qid":"Q191077","kind":"official_language","value_qid":"Q9301","value_label":"Serbo-Croatian","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Serbo-Croatian"},{"qid":"Q191077","kind":"language","value_qid":"Q9301","value_label":"Serbo-Croatian","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Serbo-Croatian"},{"qid":"Q191077","kind":"official_religion","value_qid":"Q859563","value_label":"secular state","from_t":null,"to_t":null,"title":null,"property":"P3075","retrieved":"2026-10-30","vl":"secular state"},{"qid":"Q191077","kind":"government","value_qid":"Q41614","value_label":"constitutional monarchy","from_t":null,"to_t":null,"title":null,"property":"P122","retrieved":"2026-10-30","vl":"constitutional monarchy"},{"qid":"Q191077","kind":"predecessor","value_qid":"Q15102440","value_label":"Kingdom of Serbs, Croats and Slovenes","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Kingdom of Serbs, Croats and Slovenes"},{"qid":"Q191077","kind":"predecessor","value_qid":"Q153128","value_label":"Independent State of Croatia","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Independent State of Croatia"},{"qid":"Q191077","kind":"successor","value_qid":"Q1277557","value_label":"Democratic Federal Yugoslavia","from_t":null,"to_t":null,"title":null,"property":"P156","retrieved":"2026-10-30","vl":"Democratic Federal Yugoslavia"},{"qid":"Q191077","k