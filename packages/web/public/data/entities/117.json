èt, Danane and Balàd in 1907–1908, and the territories between the Shebelle and Jubba rivers in the following years."}],"facts":[{"qid":"Q319984","kind":"capital","value_qid":"Q2449","value_label":"Mogadishu","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Mogadishu"},{"qid":"Q319984","kind":"official_language","value_qid":"Q652","value_label":"Italian","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Italian"},{"qid":"Q319984","kind":"religion","value_qid":"Q432","value_label":"Islam","from_t":null,"to_t":null,"title":null,"property":"P140","retrieved":"2026-10-30","vl":"Islam"},{"qid":"Q319984","kind":"predecessor","value_qid":"Q11950515","value_label":"Hiraab Imamate","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"Hiraab Imamate"},{"qid":"Q319984","kind":"predecessor","value_qid":"Q17588379","value_label":"sultanat de Buur Heybe","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"sultanat de Buur Heybe"},{"qid":"Q319984","kind":"flag","value_qid":null,"value_label":"Flag of Italy (1861–1946).svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q319984","kind":"coat","value_qid":null,"value_label":"Italian Somaliland COA.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null}],"people":{},"media":{"Flag of Italy (1861–1946).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Flag_of_Italy_%281861%E2%80%931946%29.svg/330px-Flag_of_Italy_%281861%E2%80%931946%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Italy_(1861%E2%80%931946).svg","author":"F l a n k e r","license":"Public domain"},"Italian Somaliland COA.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Italian_Somaliland_COA.svg/3