{"entity":{"id":"hb:khwarazmian-dynasty@1200","name":"Khwarazmian dynasty","dataset":"basemaps","kind":"kingdom"},"territories":[{"id":2050,"name":"Khwarazmian dynasty","set_id":"hb_1200","class":"kingdom","valid_from":1200,"valid_to":1279,"snapshot_held":1,"area_km2":372143.1032684189,"border_precision":1,"capital_name":null,"sovereign":null,"sovereign_note":null,"modern_name":"Pakistan","min_lon":63.60018266969418,"min_lat":23.67518766995134,"max_lon":71.40380942369548,"max_lat":32.53223587391065,"source_file":"world_1200.geojson","source_row":null}],"identities":[{"qid":"Q486918","from_t":1200,"to_t":1279,"method":"name-alias+date","confidence":0.5366851420039369,"label":"Anushtegin dynasty","description":"dynasty","inception":1077,"dissolved":null,"enwiki":"Anushtegin dynasty","summary":"The Anushtegin dynasty or Anushteginids (English: , Persian: خاندان انوشتکین), also known as the Khwarazmian dynasty (Persian: خوارزمشاهیان) was a Sunni Muslim dynasty of Turkic mamluk origin from the Bekdili clan of the Oghuz Turks. The Anushteginid dynasty ruled the Khwarazmian Empire, consisting in large parts of present-day Central Asia, Afghanistan and Iran in the approximate period of 1077 to 1231, first as vassals of the Seljuks and the Qara Khitai (Western Liao), and later as independent rulers, up until the Mongol conquest of the Khwarazmian Empire in the 13th century.\nThe dynasty was founded by commander Anushtegin Gharchai, a former Turkic slave of the Seljuq sultans, who was appointed as governor of Khwarazm. His son, Qutb ad-Din Muhammad I, became the first hereditary Shah of Khwarazm."}],"facts":[{"qid":"Q486918","kind":"language","value_qid":"Q391015","value_label":"Eastern Iranian","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Eastern Iranian"},{"qid":"Q486918","kind":"religion","value_qid":"Q432","value_label":"Islam","from_t":null,"to_t":null,"title":null,"property":"P140","retrieved":"2026-10-30","vl":"Islam"},{"qid"