s":"republic","valid_from":1979.5917808219178,"valid_to":2020,"snapshot_held":0,"area_km2":1038490,"border_precision":3,"capital_name":"Nouakchott","sovereign":null,"sovereign_note":null,"modern_name":"Mauritania","min_lon":-17.075555,"min_lat":14.725636,"max_lon":-4.808939,"max_lat":27.290454,"source_file":"CShapes-2.0.geojson","source_row":"gwcode=435;start=1979-8-5"}],"identities":[{"qid":"Q1025","from_t":1960.9071038251366,"to_t":2020,"method":"name-label+date","confidence":0.95,"label":"Mauritania","description":"sovereign state in West Africa and North Africa","inception":1960.9071038251366,"dissolved":null,"enwiki":"Mauritania","summary":"Mauritania, officially the Islamic Republic of Mauritania, is a country in the Maghreb region of West Africa. It is bordered by the Atlantic Ocean to the west, Western Sahara to the north and northwest, Algeria to the northeast, Mali to the east and southeast, and Senegal to the southwest. By land area Mauritania is the 11th-largest country in Africa and the 28th-largest in the world; 90% of its territory is in the Sahara desert. Most of its population of 5.4 million live in the temperate south of the country; roughly a third of the population is concentrated in the capital and largest city, Nouakchott, on the Atlantic coast."}],"facts":[{"qid":"Q1025","kind":"ruler","value_qid":"Q12241106","value_label":"Mohamed Ould Ghazouani","from_t":2019.5808219178082,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Mohamed Ould Ghazouani"},{"qid":"Q1025","kind":"ruler","value_qid":"Q66793577","value_label":"Moctar Ould Djay","from_t":2024.5846994535518,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Moctar Ould Djay"},{"qid":"Q1025","kind":"capital","value_qid":"Q3688","value_label":"Nouakchott","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Nouakchott"},{"qid":"Q1025","kind":"official_language","value_qid":"Q13955","value