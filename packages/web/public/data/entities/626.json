ed":"2026-10-30","vl":"Víctor Suanzes Pardo"},{"qid":"Q965","kind":"ruler","value_qid":"Q56401571","value_label":"Víctor Suanzes Pardo","from_t":1991.3287671232877,"to_t":1992.1311475409836,"title":"military leader","property":"P39","retrieved":"2026-10-30","vl":"Víctor Suanzes Pardo"},{"qid":"Q965","kind":"ruler","value_qid":"Q56401842","value_label":"Agustín Quesada Gómez","from_t":1989.9150684931508,"to_t":1991.4136986301369,"title":"military leader","property":"P39","retrieved":"2026-10-30","vl":"Agustín Quesada Gómez"},{"qid":"Q965","kind":"flag","value_qid":"Q134252","value_label":"Flag of Burkina Faso.svg","from_t":1984.5901639344263,"to_t":null,"title":"flag of Burkina Faso","property":"P163","retrieved":"2026-10-30","vl":"flag of Burkina Faso"}],"people":{"Q114341246":{"label":"Ibrahim Traoré","description":"military leader of Burkina Faso since 2022","enwiki":"Ibrahim Traoré","summary":"Ibrahim Traoré (born 14 March 1988) is a Burkinabé military officer and politician who has held power as the interim president of Burkina Faso since the overthrow of his predecessor in a 2022 coup. Ideologically prominent for his nationalist, pan-Africanist, anti-imperialist, and anti-Western views, Traoré is the second leader of the Patriotic Movement for Safeguard and Restoration, the ruling military junta in Burkina Faso since September 2022 and the second president of the Alliance of Sahel States since 2025.\nBorn in Kéra, located in western Burkina Faso, Traoré graduated from the University of Ouagadougou in 2009 with a bachelor's degree in science and geology. Following his graduation from university, he joined the Burkina Faso Armed Forces and received military training abroad, reportedly in Morocco and France.","image":"Capitaine Ibrahim Traoré.jpg","birth":1988.1994535519125,"death":null},"Q114835874":{"label":"Apollinaire Joachim Kyélem de Tambèla","description":"Prime Minister of Burkina Faso","enwiki":"Apollinaire J. Kyélem de Tambèla","summary":"Apollinaire Joachim Kyélem de Tambèla (French: [apolinɛʁ ʒoakim kjelɛm də tɑ̃bɛla]; born 11 June 1955) is a Burkinabe lawyer, pan-Africanist, writer and statesman, who served as the Prime Minister of Burkina Faso from October 2022 until his firing by President Ibrahim Traoré in December 2024.","image":"Apollinaire Kyelem de Tambèla (cropped).png","birth":1958.441095890411,"death":null},"Q19628964":{"label":"Chérif Sy","description":"Burkinabé politician","enwiki":"Chérif Sy","summary":"Chérif Moumina Sy (born 17 May 1960) is a Mauritanian-born Burkinabé politician who served as the transitional Head of Parliament from 2014 to 2015.","image":"Chérif Sy 2019.jpg","birth":1960.3743169398906,"death":null},"Q202155":{"label":"Thomas Sankara","description":"President of Burkina Faso from 1983 to 1987","enwiki":"Thomas Sankara","summary":"Thomas Isidore Noël Sankara (21 December 1949 – 15 October 1987) was a Burkinabé military officer, politician, Marxist and pan-Africanist revolutionary who served as the first president of Burkina Faso from 1983 until his assassination in 1987. Sankara previously served as the fifth prime minister of Upper Volta from January to May 1983.\nAfter Sankara was appointed Prime Minister of the Republic of Upper Volta in 1983, he disputed with the sitting government and was placed under house arrest, during which a group of revolutionaries seized power on his behalf in a popular coup later that year.\nFollowing the coup, Sankara, then 33, became the President of the Republic of Upper Volta and launched an unprecedented series of social, ecological, and economic reforms that were part of what he referred to as the people's democratic revolution.","image":"Thomas Sankara in Harlem (1984).png","birth":1949.9698630136986,"death":1987.786301369863},"Q20978710":{"label":"Gilbert Diendéré","description":"Burkinabé military officer","enwiki":"Gilbert Diendéré","summary":"Gilbert Diendéré (French pronunciation: [ʒil.bɛʁ djɛn.de.ʁe]; born c. 1960) is a Burkinabé military officer and the Chairman of the National Council for Democracy, the military junta that briefly seized power in Burkina Faso in the September 2015 coup d'état. He was a long-time aide to President Blaise Compaoré, serving as commander of the Regiment of Presidential Security (RSP) during Compaoré's rule. He was appointed as chairman of the junta on 17 September 2015.","image":"Defense.gov photo essay 100501-F-3745E-012 cropped.jpg","birth":1960,"death":null},"Q529272":{"label":"Aboubacar Sangoulé Lamizana","description":"President of Upper Volta and Burkina Faso (1916-2005)","enwiki":"Sangoulé Lamizana","summary":"Aboubacar Sangoulé Lamizana (31 January 1916 – 26 May 2005) was an Upper Voltan military officer who served as the President of Upper Volta (since 1984 renamed Burkina Faso), in power from 3 January 1966, to 25 November 1980. He held the additional position of Prime Minister from 8 February 1974, to 7 July 1978.","image":"Sangoulé Lamizana 1971.png","birth":1916.0819672131147,"death":2005.3972602739725},"Q557941":{"label":"Saye Zerbo","description":"President of Burkina Faso (1932-2013)","enwiki":"Saye Zerbo","summary":"Saye Zerbo (27 August 1932 – 19 September 2013) was a Burkinabé military officer who was the third President of the Republic of Upper Volta (now Burkina Faso) from 25 November 1980 until 7 November 1982.\nHe led a coup in 1980, but was resisted by trade unions and was overthrown by Major Jean-Baptiste Ouédraogo and the Council of Popular Salvation (CSP).","image":"Saye Zerbo with U.S. ambassador (cropped).png","birth":1932.6530054644809,"death":2013.7150684931507},"Q558209":{"label":"Jean-Baptiste Ouédraogo","description":"Burkinabé politician","enwiki":"Jean-Baptiste Ouédraogo","summary":"Jean-Baptiste Philippe Ouédraogo (French pronunciation: [ʒɑ̃ batist filip wedʁaɔɡo]; born 30 June 1942), also referred to by his initials JBO, is a Burkinabé physician and retired military officer who served as President of Upper Volta (now Burkina Faso) from 8 November 1982 to 4 August 1983. He has since mediated a few national political disputes and operates a clinic in Somgandé.\nOuédraogo received his early education in Upper Volta before joining the Upper Voltan Army and studying medicine abroad. After working in healthcare, he was appointed chief medical officer of the Ouagadougou military camp.","image":"Jean-Baptiste Ouédraogo at book signing.jpg","birth":1942.4931506849316,"death":null},"Q57324":{"label":"Blaise Compaoré","description":"President of Burkina Faso from 1987 to 2014","enwiki":"Blaise Compaoré","summary":"Blaise Compaoré (French: [blɛz kɔ̃paɔʁe]; born 3 February 1951) is a Burkinabé politician and former military officer who served as the second president of Burkina Faso from 1987 until his government was overthrown in 2014. The longest-serving president in Burkinabé history, Compaoré previously served as the Minister of Justice from 1985 to 1987.\nBorn and raised in Ziniaré, Compaoré joined the Burkina Faso Armed Forces (then known as Upper Voltan Armed Forces) at the age of 20 in 1971 where he rose through the ranks. Compaoré was a close associate of his predecessor and the country's first President, Thomas Sankara, who appointed Compaoré as Minister of Justice in 1985.","image":"Blaise Compaoré.jpeg","birth":1951.0904109589042,"death":null},"Q599988":{"label":"Roch Marc Christian Kaboré","description":"former President of Burkina Faso ousted in a coup d'état on 23 Jan 2022","enwiki":"Roch Marc Christian Kaboré","summary":"Roch Marc Christian Kaboré (French pronunciation: [ʁɔk maʁk kʁistjɑ̃ kabɔʁe]; born 25 April 1957) is a Burkinabé banker and politician who served as the President of Burkina Faso from 2015 until he was deposed in 2022. He was the Prime Minister of Burkina Faso between 1994 and 1996 and President of the National Assembly of Burkina Faso from 2002 to 2012. Kaboré was also president of the Congress for Democracy and Progress (CDP) until his departure from the party in 2014. He founded the People's Movement for Progress party that same year.","image":"Roch Marc Christian Kaboré (04-06-2018).jpg","birth":1957.3123287671233,"death":null},"Q110666454":{"label":"Paul-Henri Sandaogo Damiba","description":"Burkinabé military officer and president (January–September 2022)","enwiki":"Paul-Henri Sandaogo Damiba","summary":"Paul-Henri Sandaogo Damiba (French: [pɔl ɑ̃ʁi sɑ̃daɔɡɔ damiba]; born January 1981) is a Burkinabé military officer who served as interim president of Burkina Faso from 31 January 2022 to 30 September 2022, when he was removed in a coup d'état by his own military colleague, Ibrahim Traoré. Damiba had come to power just eight months earlier, on 24 January 2022, when he removed president Roch Marc Christian Kaboré in a coup.","image":"Le lieutenant-colonel Paul Henri Sandaogo Damiba, Ouagadougou le 27 janvier 2022 (cropped).jpg","birth":1981.0027397260274,"death":null},"Q16105972":{"label":"Michel Kafando","description":"Burkinabé diplomat","enwiki":"Michel Kafando","summary":"Michel Kafando (born 18 August 1942) is a Burkinabé diplomat and politician, who served as Interim President of Burkina Faso from 2014 to 2015. He previously served as Minister of Foreign Affairs from 1982 to 1983 and as Permanent Representative of Burkina Faso to the United Nations from 1998 to 2011.\nFollowing the resignation of President Blaise Compaoré amidst the 2014 Burkinabé uprising, Kafando was chosen by the interim military administration until the next elections. Kafando was briefly ousted in the September 2015 coup attempt by the Regiment of Presidential Security, but he ultimately restored power within a week and disbanded the regiment.","image":"Michel Kafando - 2015 (cropped).jpg","birth":1942.627397260274,"death":null},"Q1627285":{"label":"Honoré Traoré","description":"Burkinabé soldier","enwiki":"Honoré Traoré","summary":"Honoré Nabéré Traoré (28 September 1957 – 25 May 2026) was a Burkinabé army general who served as the interim head of state of Burkina Faso for one day, from 31 October to 1 November 2014, following the overthrow of Blaise Compaoré's government in the 2014 Burkina Faso uprising.","image":"General Honore Traore (Burkina Faso).jpg","birth":1957.7397260273972,"death":2026.3945205479451},"Q18402168":{"label":"Yacouba Isaac Zida","description":"Burkinabé military officer and politician","enwiki":"Yacouba Isaac Zida","summary":"Yacouba Isaac Zida (born 16 November 1965) is a Burkinabé military officer and politician, who served as the Interim Head of State of Burkina Faso in November 2014.\nZida took power on an interim basis in the aftermath of the 2014 Burkinabé uprising, sidelining a more senior officer, Honoré Nabéré Traoré. A few weeks later, power was handed over to a civilian Head of State, Michel Kafando, with the intention of leading the country until the next election. Zida was subsequently appointed Interim Prime Minister by Kafando.","image":"Yacouba Isaac Zida 2015.jpg","birth":1965.8739726027397,"death":null},"Q27144139":{"label":"Abdul Rab al-Shadadi","description":"Yemeni general (1963–2016)","enwiki":"Abdul-Rab al-Shadadi","summary":"Abdul-Rab al-Shadadi (1963 - 7 October 2016) was a Yemeni Army major general who served President Abdrabbuh Mansur Hadi. He was the commander of the Third Military Region, which has its headquarters in the city of Marib. Al-Shadadi was killed in an artillery strike during an offensive east of the city of Sanaa by Houthi fighters. He is among the most senior members of the Hadi government's forces to have been killed in the Yemeni Civil War.","image":null,"birth":2000,"death":2016.7650273224044},"Q27146606":{"label":"عادل هاشم القميري","description":"Yemeni military officer","enwiki":null,"summary":null,"image":null,"birth":null,"death":null},"Q528529":{"label":"Jean Cavalier","description":"Camisard rebel leader, Governor of Jersey","enwiki":"Jean Cavalier","summary":"Jean Cavalier (28 November 1681 – 17 May 1740), was the Occitan Huguenot chief of the Camisards. He was born at Mas Roux, a small hamlet in the commune of Ribaute near Anduze in southern France.","image":"Jean-cavalier.jpg","birth":1681.9068493150685,"death":1740.3743169398906},"Q56401571":{"label":"Víctor Suanzes Pardo","description":"Spanish military personnel","enwiki":null,"summary":null,"image":null,"birth":1936,"death":null},"Q56401842":{"label":"Agustín Quesada Gómez","description":"Spanish military personnel","enwiki":null,"summary":null,"image":null,"birth":1931,"death":2020.1967213114754}},"media":{"Flag of Burkina Faso.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Flag_of_Burkina_Faso.svg/330px-Flag_of_Burkina_Faso.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Flag_of_Burkina_Faso.svg","author":"Drawn by SKopp, rewritten by Gabbe and Андрей Перцев","license":"Public domain"},"Coat of arms of Burkina Faso (1997–2025).svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/10/Coat_of_arms_of_Burkina_Faso_%281997%E2%80%932025%29.svg/330px-Coat_of_arms_of_Burkina_Faso_%281997%E2%80%932025%29.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Coat_of_arms_of_Burkina_Faso_(1997%E2%80%932025).svg","author":"F l a n k e r","license":"CC BY-SA 3.0"},"Capitaine Ibrahim Traoré.jpg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/7d/Capitaine_Ibrahim_Traor%C3%A9.jpg/330px-Capitaine_Ibrahim_Traor%C3%A9.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","page":"https://commons.wikimedia.org/wiki/File:Capitaine_Ibrahim_Traor%C3%A9.jpg","author":"Bamjo226","license":"CC0"},"Apollinaire Kyelem de Tambèla (cropped).png":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Apollinaire_Kyelem_de_Tamb%C3%A8la_%28cropped%29.png/330px-Apollinaire_Kyelem_de_Tamb%C3%A8la_%28cropped%29.png?utm_