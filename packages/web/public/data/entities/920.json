n Sea","inception":1978,"dissolved":null,"enwiki":"Dominica","summary":"Dominica officially the Commonwealth of Dominica, is an island country in the Caribbean. It is part of the Windward Islands chain in the Lesser Antilles archipelago in the Caribbean Sea. The capital, Roseau, is located on the western side of the island. Dominica's closest neighbours are two constituent territories of the European Union, both overseas departments of France: Guadeloupe to the northwest and Martinique to the south-southeast."}],"facts":[{"qid":"Q784","kind":"ruler","value_qid":"Q122208779","value_label":"Sylvanie Burton","from_t":2023.7506849315068,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Sylvanie Burton"},{"qid":"Q784","kind":"ruler","value_qid":"Q57823","value_label":"Roosevelt Skerrit","from_t":2004.01912568306,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Roosevelt Skerrit"},{"qid":"Q784","kind":"capital","value_qid":"Q36281","value_label":"Roseau","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Roseau"},{"qid":"Q784","kind":"official_language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"English"},{"qid":"Q784","kind":"language","value_qid":"Q1860","value_label":"English","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"English"},{"qid":"Q784","kind":"language","value_qid":"Q3006285","value_label":"Saint Lucian Creole","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Saint Lucian Creole"},{"qid":"Q784","kind":"predecessor","value_qid":"Q652560","value_label":"West Indies Federation","from_t":null,"to_t":null,"title":null,"property":"P155","retrieved":"2026-10-30","vl":"West Indies Federation"},{"qid":"Q784","kind":"flag","value_qid":null,"value_label":"Flag of Dominica.svg","from_t":1990,"to_