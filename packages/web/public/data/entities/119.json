a, now in Somaliland, was the seat of the medieval Adal and Ifat Sultanates."}],"facts":[{"qid":"Q977","kind":"ruler","value_qid":"Q57390","value_label":"Ismail Omar Guelleh","from_t":1999.3479452054794,"to_t":null,"title":"head of state","property":"P35","retrieved":"2026-10-30","vl":"Ismail Omar Guelleh"},{"qid":"Q977","kind":"ruler","value_qid":"Q57683","value_label":"Dileita Mohamed Dileita","from_t":2001.1780821917807,"to_t":2013.2465753424658,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Dileita Mohamed Dileita"},{"qid":"Q977","kind":"ruler","value_qid":"Q10522744","value_label":"Abdoulkader Kamil Mohamed","from_t":2013.2465753424658,"to_t":null,"title":"head of government","property":"P6","retrieved":"2026-10-30","vl":"Abdoulkader Kamil Mohamed"},{"qid":"Q977","kind":"capital","value_qid":"Q3604","value_label":"Djibouti","from_t":null,"to_t":null,"title":null,"property":"P36","retrieved":"2026-10-30","vl":"Djibouti"},{"qid":"Q977","kind":"official_language","value_qid":"Q150","value_label":"French","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"French"},{"qid":"Q977","kind":"official_language","value_qid":"Q13955","value_label":"Arabic","from_t":null,"to_t":null,"title":null,"property":"P37","retrieved":"2026-10-30","vl":"Arabic"},{"qid":"Q977","kind":"language","value_qid":"Q56467","value_label":"Modern Standard Arabic","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Modern Standard Arabic"},{"qid":"Q977","kind":"language","value_qid":"Q13275","value_label":"Somali","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Somali"},{"qid":"Q977","kind":"language","value_qid":"Q150","value_label":"French","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"French"},{"qid":"Q977","kind":"language","value_qid":"Q27811","value_label":"Afar","from_t":null,"to_t":null,"title":null,"property":"P2936","retrieved":"2026-10-30","vl":"Afar"},{"qid":"Q977","kind":"predecessor","value_qid":"Q1450765","value_label":"French Territory of the Afars and the Issas","from_t":null,"to_t":null,"title":null,"property":"P1365","retrieved":"2026-10-30","vl":"French Territory of the Afars and the Issas"},{"qid":"Q977","kind":"flag","value_qid":null,"value_label":"Flag of Djibouti.svg","from_t":null,"to_t":null,"title":null,"property":"P41","retrieved":"2026-10-30","vl":null},{"qid":"Q977","kind":"coat","value_qid":null,"value_label":"Emblem of Djibouti.svg","from_t":null,"to_t":null,"title":null,"property":"P94","retrieved":"2026-10-30","vl":null},{"qid":"Q977","kind":"ruler","value_qid":"Q297667","value_label":"Hassan Gouled Aptidon","from_t":1977.4849315068493,"to_t":1999.3479452054794,"title":"President of Djibouti","property":"P39","retrieved":"2026-10-30","vl":"Hassan Gouled Aptidon"},{"qid":"Q977","kind":"flag","value_qid":"Q102184","value_label":"Flag of Djibouti.svg","from_t":1977.4849315068493,"to_t":null,"title":"flag of Djibouti","property":"P163","retrieved":"2026-10-30","vl":"flag of Djibouti"}],"people":{"Q57390":{"label":"Ismail Omar Guelleh","description":"President of Djibouti since 1999","enwiki":"Ismaïl Omar Guelleh","summary":"Ismaïl Omar Guelleh (born 27 November 1947), often referred to by his initials IOG, is a Djiboutian politician who has served as the President of Djibouti since 1999.\nGuelleh was first elected as President in 1999 as the handpicked successor to his uncle, Hassan Gouled Aptidon, who had ruled Djibouti since independence in 1977. Guelleh was re-elected in 2005, 2011, 2016, 2021, and 2026. The elections were largely boycotted by the opposition amid complaints over widespread irregularities.","image":"Djiboutian President Ismail Omar Guelleh at the presidential palace in Djibouti, Republic of Djibouti, September 24, 2023 - (cropped).jpg","birth":1947.9041095890411,"death":null},"Q57683":{"label":"Dileita Mohamed Dileita","description":"Prime Minister of Djibouti","enwiki":"Dileita Mohamed Dileita","summary":"Dileita Mohamed Dileita (Afar: Dileita Macammad Dileita, Arabic: دليطة محمد دليطة; born 12 March 1959) is a Djiboutian politician who was the prime minister of Djibouti from 7 March 2001 to 1 April 2013. He was vice-president of the People's Rally for Progress (RPP), the governing political party, until 2012. He also served as president of the Union for the Presidential Majority (UMP), the governing coalition. He was elected President of the National Assembly on 5 March 2023.","image":"Dileita Mohamed Dileita detail 090114-F-3682S-269.jpg","birth":1958.1917808219177,"death":null},"Q10522744":{"label":"Abdoulkader Kamil Mohamed","description":"Prime Minister of Djibouti (2013-present)","enwiki":"Abdoulkader Kamil Mohamed","summary":"Abdoulkader Kamil Mohamed (Afar: Qabdulkadir Kamil Macammad, Arabic: عبد القادر كامل محمد; born 1 July 1952) is a Djiboutian politician who has been Prime Minister of Djibouti since 2013.  A longtime member of the ruling People's Rally for Progress, he previously served as Minister of Agriculture from 2005 to 2011 and as Minister of Defense from 2011 to 2013. He is Afar-Somali, hailing from the prominent Warsangeli clan.","image":"Djiboutian PM Mohamed at the MOD 2019 (1) (cropped).jpg","birth":1952.4972677595629,"death":null},"Q297667":{"label":"Hassan Gouled Aptidon","description":"President of Djibouti (1916-2006)","enwiki":"Hassan Gouled Aptidon","summary":"Hassan Gouled Aptidon (Somali: Xasan Guuleed Abtidoon; Arabic: حسن جوليد أبتيدون; October 15, 1916 – November 21, 2006) was a Djiboutian politician who served as the first President of Djibouti from 1977 to 1999.","image":"Hassan Gouled Aptidon.jpg","birth":1916.7868852459017,"death":2006.8876712328768}},"media":{"Flag of Djibouti.svg":{"url":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/34/Flag_of_Djibouti.svg/330px-Flag_of_Djibouti.svg.png?utm_source=commons.wikimedia.org&utm_campaign=imagei